#!/usr/bin/env bash
# Land one or more commits onto a repository's main only when every step
# below passes. Each step runs on its own, and only that step's own exit
# code decides whether the next one runs. Issue #318: a `tail -1` on a
# gate's output hid its real exit code, and `;` chaining ran the push
# regardless of what came before it, so a failing gate did not stop the
# push.
#
# Usage: land --repo <path> --gate '<command>' <commit>...
#
# Steps, in order, stopping at the first failure:
#   1. the checkout is on main, clean, and equal to origin/main after a fetch
#   2. git cherry-pick each commit; on conflict, abort and reset
#   3. run the gate in the repo root, full output to a log file, continue
#      only on exit 0 (never on a line of its output)
#   4. origin/main (pre-push) is an ancestor of HEAD
#   5. git push origin main (never --force)
#   6. fetch again and confirm origin/main now equals the local HEAD
#
# Exit codes:
#   0  landed and pushed; origin/main confirmed equal to the local HEAD.
#   1  a step above said no: the repository was not ready, the
#      cherry-pick conflicted, the gate exited nonzero, the ancestor
#      check failed, the push failed, or the post-push confirmation
#      failed. The checkout is reset to the sha it started from. A
#      failure in the post-push confirmation still resets the local
#      checkout, but the push already went out, and the message says so.
#   2  could not run the check at all: bad usage, the repo path is not a
#      git checkout, a commit argument does not resolve, git fetch
#      failed, or an internal step (mktemp, reading HEAD, resetting the
#      checkout) failed.
set -u

REMOTE="origin"
BRANCH="main"

usage() {
  echo "usage: land --repo <path> --gate '<command>' <commit>..." >&2
  exit 2
}

error() {
  echo "land: $*" >&2
  exit 2
}

fail() {
  echo "land: $*" >&2
  exit 1
}

repo=""
gate=""
commits=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      [ $# -ge 2 ] || usage
      repo="$2"
      shift 2
      ;;
    --gate)
      [ $# -ge 2 ] || usage
      gate="$2"
      shift 2
      ;;
    --)
      shift
      commits+=("$@")
      break
      ;;
    -*)
      usage
      ;;
    *)
      commits+=("$1")
      shift
      ;;
  esac
done

[ -n "${repo}" ] || usage
[ -n "${gate}" ] || usage
[ "${#commits[@]}" -ge 1 ] || usage

root="$(git -C "${repo}" rev-parse --show-toplevel 2>/dev/null)" || error "${repo} is not a git repository"

# Resolve every commit to a full sha before anything changes the checkout,
# so a bad argument is a could-not-run failure, not a half-done cherry-pick.
resolved=()
for c in "${commits[@]}"; do
  sha="$(git -C "${root}" rev-parse --verify --quiet "${c}^{commit}")" || error "commit not found: ${c}"
  resolved+=("${sha}")
done

# --- Step 1: checkout is on main, clean, and equal to origin/main ----------
current_branch="$(git -C "${root}" branch --show-current)"
[ "${current_branch}" = "${BRANCH}" ] || fail "checkout is on '${current_branch}', not '${BRANCH}'"

if [ -n "$(git -C "${root}" status --porcelain)" ]; then
  fail "checkout is dirty; refusing before any change"
fi

git -C "${root}" fetch --quiet "${REMOTE}" || error "git fetch ${REMOTE} failed"

start_sha="$(git -C "${root}" rev-parse HEAD)" || error "could not read HEAD"
remote_sha="$(git -C "${root}" rev-parse "${REMOTE}/${BRANCH}")" || error "could not read ${REMOTE}/${BRANCH}"
[ "${start_sha}" = "${remote_sha}" ] || fail "local ${BRANCH} (${start_sha}) is not ${REMOTE}/${BRANCH} (${remote_sha})"

# From here on, any failure resets the checkout back to where it started
# and verifies the reset actually landed there.
reset_to_start() {
  git -C "${root}" cherry-pick --abort >/dev/null 2>&1
  git -C "${root}" reset --hard "${start_sha}" >/dev/null 2>&1
  local after
  after="$(git -C "${root}" rev-parse HEAD 2>/dev/null)"
  [ "${after}" = "${start_sha}" ] || error "reset to ${start_sha} did not take; checkout is now at '${after}'"
}

reset_and_fail() {
  reset_to_start
  fail "$* (checkout reset to ${start_sha})"
}

# --- Step 2: cherry-pick ----------------------------------------------------
cherry_log="$(mktemp -t land-cherry-pick.XXXXXX)" || error "mktemp failed for the cherry-pick log"
if ! git -C "${root}" cherry-pick "${resolved[@]}" >"${cherry_log}" 2>&1; then
  reset_and_fail "cherry-pick conflict; see ${cherry_log}"
fi
rm -f "${cherry_log}"

# --- Step 3: gate, judged only by its exit code -----------------------------
gate_log="$(mktemp -t land-gate.XXXXXX)" || error "mktemp failed for the gate log"
( cd "${root}" && eval "${gate}" ) >"${gate_log}" 2>&1
gate_rc=$?
if [ "${gate_rc}" -ne 0 ]; then
  reset_and_fail "gate exited ${gate_rc}; full output in ${gate_log}"
fi
echo "land: gate passed; full output in ${gate_log}"

# --- Step 4: origin/main (pre-push) is an ancestor of HEAD ------------------
if ! git -C "${root}" merge-base --is-ancestor "${remote_sha}" HEAD; then
  reset_and_fail "${REMOTE}/${BRANCH} (${remote_sha}) is not an ancestor of HEAD"
fi

# --- Step 5: push (never --force) -------------------------------------------
if ! git -C "${root}" push "${REMOTE}" "HEAD:${BRANCH}"; then
  reset_and_fail "git push ${REMOTE} HEAD:${BRANCH} failed"
fi

# --- Step 6: confirm the remote now matches the pushed HEAD -----------------
pushed_sha="$(git -C "${root}" rev-parse HEAD)"
if ! git -C "${root}" fetch --quiet "${REMOTE}"; then
  reset_to_start
  fail "post-push git fetch ${REMOTE} failed; the push to ${pushed_sha} may already have landed (checkout reset to ${start_sha})"
fi
confirmed_sha="$(git -C "${root}" rev-parse "${REMOTE}/${BRANCH}")"
if [ "${confirmed_sha}" != "${pushed_sha}" ]; then
  reset_to_start
  fail "post-push confirmation failed: ${REMOTE}/${BRANCH} is ${confirmed_sha}, expected ${pushed_sha}; the push may already have landed (checkout reset to ${start_sha})"
fi

echo "land: pushed ${pushed_sha} to ${REMOTE}/${BRANCH}"
exit 0
