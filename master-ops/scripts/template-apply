#!/usr/bin/env python3
"""Apply template-layer files onto an ops install, gated by the template manifest.

Always dry-runs first: prints the exact file list and the reason for each entry.
A write pass requires an interactive confirmation phrase. There is no --yes.

Instance-owned paths are refused by name:
  docs/lineage/, docs/runbooks/role-state.md, .beads/, config/, contracts/,
  and anything the manifest does not claim.

Per-file outcomes:
  planned | written
  skipped-as-instance-owned
  refused-not-in-manifest
  error-invalid-path
  error-missing-template-file

Multi-file apply is preflighted then written file-by-file with per-file atomic
replace. A mid-batch OS error can leave earlier files written; re-run after fix.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
if str(_SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(_SCRIPT_DIR))
from template_common import (  # noqa: E402
    PLACEHOLDERS,
    is_instance_owned,
)

CONFIRM_PHRASE = "apply"


def normalize_rel(rel: str) -> str | None:
    """Return a normalized relative path, or None if it escapes the root."""
    if not isinstance(rel, str) or not rel or rel.startswith("/"):
        return None
    # Reject Windows drive / UNC forms and null bytes early.
    if "\x00" in rel or ":" in rel:
        return None
    parts: list[str] = []
    for part in rel.replace("\\", "/").split("/"):
        if part in ("", "."):
            continue
        if part == "..":
            return None
        parts.append(part)
    if not parts:
        return None
    return "/".join(parts)


def resolved_under(root: Path, rel: str) -> Path | None:
    """Resolve root/rel and require the result to stay under root."""
    try:
        root_res = root.resolve()
        candidate = (root_res / rel).resolve()
        candidate.relative_to(root_res)
    except (OSError, ValueError, RuntimeError):
        # Symlink loops and unreadable parents become invalid-path, not a crash.
        return None
    return candidate


def effective_rel_under(root: Path, path: Path) -> str | None:
    """Relative posix path of a resolved path under root, or None if outside."""
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except (OSError, ValueError, RuntimeError):
        return None


def roots_overlap(first: Path, second: Path) -> bool:
    first_resolved = first.resolve()
    second_resolved = second.resolve()
    try:
        first_resolved.relative_to(second_resolved)
        return True
    except ValueError:
        pass
    try:
        second_resolved.relative_to(first_resolved)
        return True
    except ValueError:
        return False


def load_manifest(path: Path) -> dict:
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict) or not isinstance(data.get("files"), list):
        raise ValueError("manifest missing files list")
    return data


def resolve_template_root(template: Path) -> Path:
    path = template.resolve()
    if (path / "MANIFEST.json").is_file():
        return path
    nested = path / "master-ops"
    if (nested / "MANIFEST.json").is_file():
        return nested
    raise FileNotFoundError(f"no MANIFEST.json under {template}")


def substitute(text: str, values: dict[str, str]) -> str:
    out = text
    for key in PLACEHOLDERS:
        name = key[2:-2]
        if key in out and name in values:
            out = out.replace(key, values[name])
    return out


def plan_actions(
    template_root: Path,
    ops_root: Path,
    manifest: dict,
    extra_targets: list[str] | None,
) -> list[dict]:
    """Build the per-path plan. extra_targets are attempted writes outside the
    manifest — used only to prove refusal in tests; normal runs pass None."""
    claimed_raw = list(manifest["files"])
    actions: list[dict] = []
    claimed: set[str] = set()

    # Sort only string entries so non-strings still appear as plan errors.
    sortable = [p for p in claimed_raw if isinstance(p, str)]
    non_strings = [p for p in claimed_raw if not isinstance(p, str)]
    for raw in non_strings:
        actions.append(
            {
                "path": repr(raw),
                "action": "error-invalid-path",
                "reason": "manifest entry is not a string path",
            }
        )

    for raw in sorted(sortable):
        rel = normalize_rel(raw)
        if rel is None:
            actions.append(
                {
                    "path": raw,
                    "action": "error-invalid-path",
                    "reason": "manifest entry is not a safe relative path",
                }
            )
            continue
        claimed.add(rel)
        if is_instance_owned(rel):
            actions.append(
                {
                    "path": rel,
                    "action": "skipped-as-instance-owned",
                    "reason": "instance-owned by name",
                }
            )
            continue
        src = resolved_under(template_root, rel)
        dest = resolved_under(ops_root, rel)
        if src is None or dest is None:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "resolved path escapes template or ops root",
                }
            )
            continue
        # Always evaluate the resolved destination (including dangling
        # in-root symlinks) for escape and instance-owned targets.
        effective = effective_rel_under(ops_root, dest)
        if effective is None:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "destination resolves outside ops root",
                }
            )
            continue
        lexical_dest = ops_root.resolve() / rel
        if lexical_dest.is_symlink() or lexical_dest != dest:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "destination path resolves through a symlink",
                }
            )
            continue
        if lexical_dest.exists() and not lexical_dest.is_file():
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "destination exists but is not a regular file",
                }
            )
            continue
        if is_instance_owned(effective):
            actions.append(
                {
                    "path": rel,
                    "action": "skipped-as-instance-owned",
                    "reason": f"destination resolves to instance-owned path {effective}",
                }
            )
            continue
        if not src.is_file():
            actions.append(
                {
                    "path": rel,
                    "action": "error-missing-template-file",
                    "reason": "listed in manifest but missing from template tree",
                }
            )
            continue
        if dest.is_file():
            reason = "template-layer path; would overwrite existing file"
        else:
            reason = "template-layer path; would create missing file"
        actions.append(
            {
                "path": rel,
                "action": "planned",
                "reason": reason,
            }
        )

    for raw in extra_targets or []:
        rel = normalize_rel(raw) or raw
        if is_instance_owned(rel if isinstance(rel, str) else raw):
            actions.append(
                {
                    "path": rel,
                    "action": "skipped-as-instance-owned",
                    "reason": "instance-owned by name",
                }
            )
        elif rel not in claimed:
            actions.append(
                {
                    "path": rel,
                    "action": "refused-not-in-manifest",
                    "reason": "manifest does not claim this path",
                }
            )
        # If it is claimed, it already appears above.
    return actions


def plan_has_errors(actions: list[dict]) -> bool:
    return any(a["action"].startswith("error-") for a in actions)


def apply_planned(
    template_root: Path,
    ops_root: Path,
    actions: list[dict],
    values: dict[str, str],
) -> list[dict]:
    # Preflight every planned source before the first write so a missing file
    # mid-pass does not leave a half-applied install.
    planned = [a for a in actions if a["action"] == "planned"]
    for item in planned:
        src = resolved_under(template_root, item["path"])
        dest = ops_root.resolve() / item["path"]
        if src is None or dest is None or not src.is_file():
            raise RuntimeError(f"preflight failed for {item['path']}")

    results: list[dict] = []
    for item in actions:
        rel = item["path"]
        if item["action"] != "planned":
            results.append(
                {
                    "path": rel,
                    "action": item["action"],
                    "reason": item["reason"],
                }
            )
            continue
        src = resolved_under(template_root, rel)
        dest = ops_root.resolve() / rel
        resolved_dest = resolved_under(ops_root, rel)
        if src is None or resolved_dest is None:
            raise RuntimeError(f"path escaped root during write: {rel}")
        if dest.is_symlink() or dest != resolved_dest or (dest.exists() and not dest.is_file()):
            raise RuntimeError(f"destination is not a regular file: {rel}")
        # Re-check resolved destination after confirmation (unconditional).
        effective = effective_rel_under(ops_root, resolved_dest)
        if effective is None or is_instance_owned(effective):
            raise RuntimeError(
                f"destination became instance-owned or escaped before write: {rel}"
            )
        text = src.read_text(encoding="utf-8")
        text = substitute(text, values)
        dest.parent.mkdir(parents=True, exist_ok=True)
        # Atomic replace within the destination directory so a crash mid-write
        # does not leave a truncated target. Preserve destination mode when the
        # target already exists; otherwise keep the source mode (not mkstemp 0600).
        if dest.exists() and not dest.is_symlink():
            mode = dest.stat().st_mode & 0o777
        else:
            mode = src.stat().st_mode & 0o777
        fd, tmp_name = tempfile.mkstemp(
            prefix=".template-apply-",
            dir=str(dest.parent),
        )
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as tmp:
                tmp.write(text)
            os.chmod(tmp_name, mode)
            os.replace(tmp_name, dest)
        except Exception:
            try:
                os.unlink(tmp_name)
            except OSError:
                pass
            raise
        results.append(
            {
                "path": rel,
                "action": "written",
                "reason": item["reason"],
            }
        )
    return results


def format_plan(actions: list[dict]) -> str:
    lines = ["dry-run plan (no writes):", f"entries: {len(actions)}"]
    for item in actions:
        lines.append(f"  {item['action']}: {item['path']} — {item['reason']}")
    return "\n".join(lines) + "\n"


def parse_placeholder_args(items: list[str] | None) -> dict[str, str]:
    values: dict[str, str] = {}
    for item in items or []:
        if "=" not in item:
            raise SystemExit(f"template-apply: expected KEY=VALUE, got {item!r}")
        key, value = item.split("=", 1)
        key = key.strip()
        if f"{{{{{key}}}}}" not in PLACEHOLDERS:
            raise SystemExit(
                f"template-apply: unknown placeholder {key!r}; "
                f"allowed: {', '.join(p[2:-2] for p in PLACEHOLDERS)}"
            )
        values[key] = value
    return values


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--ops",
        type=Path,
        required=True,
        help="Target ops repository root",
    )
    parser.add_argument(
        "--template",
        type=Path,
        required=True,
        help="Template master-ops path or ADE clone root",
    )
    parser.add_argument(
        "--placeholder",
        action="append",
        default=[],
        help="KEY=VALUE for documented placeholders (repeatable)",
    )
    parser.add_argument(
        "--write",
        action="store_true",
        help="After printing the plan, prompt for confirmation and write",
    )
    parser.add_argument(
        "--attempt",
        action="append",
        default=[],
        help=argparse.SUPPRESS,  # test-only: attempt a path to prove refusal
    )
    parser.add_argument(
        "--confirm-input",
        default=None,
        help=argparse.SUPPRESS,  # test-only: feed confirmation without a TTY
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    ops_root = args.ops.resolve()
    if not ops_root.is_dir():
        sys.stderr.write(f"template-apply: ops root not a directory: {ops_root}\n")
        return 2

    try:
        template_root = resolve_template_root(args.template)
    except FileNotFoundError as exc:
        sys.stderr.write(f"template-apply: {exc}\n")
        return 2

    if roots_overlap(template_root, ops_root):
        sys.stderr.write(
            "template-apply: template and ops roots must be distinct and non-overlapping\n"
        )
        return 2

    try:
        manifest = load_manifest(template_root / "MANIFEST.json")
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        sys.stderr.write(f"template-apply: cannot read template manifest: {exc}\n")
        return 2

    try:
        values = parse_placeholder_args(args.placeholder)
    except SystemExit as exc:
        return int(exc.code) if isinstance(exc.code, int) else 2

    # Default TEMPLATE_VERSION from the template when not supplied.
    if "TEMPLATE_VERSION" not in values:
        version_file = template_root / "TEMPLATE-VERSION"
        if version_file.is_file():
            try:
                values["TEMPLATE_VERSION"] = version_file.read_text(encoding="utf-8").strip()
            except (OSError, UnicodeDecodeError) as exc:
                sys.stderr.write(f"template-apply: cannot read template version: {exc}\n")
                return 2

    actions = plan_actions(template_root, ops_root, manifest, args.attempt)

    # Always surface the plan before any write. Human mode prints it on stdout;
    # JSON mode keeps stdout machine-readable and puts the plan on stderr when
    # a write pass will follow.
    plan_text = format_plan(actions)
    if args.json:
        if not args.write:
            json.dump({"phase": "dry-run", "actions": actions}, sys.stdout, indent=2)
            sys.stdout.write("\n")
        else:
            sys.stderr.write(plan_text)
    else:
        sys.stdout.write(plan_text)

    if plan_has_errors(actions):
        # Missing or invalid manifest entries are apply errors, not a clean plan.
        return 1

    refused = [
        a
        for a in actions
        if a["action"]
        in (
            "skipped-as-instance-owned",
            "refused-not-in-manifest",
        )
        and a["path"] in set(args.attempt)
    ]
    if args.attempt and refused and not args.write:
        # Attempt-only dry-run that includes a refused path: exit 1 so tests
        # can assert the refusal status as a number.
        return 1

    if not args.write:
        return 0

    # Interactive confirmation — no --yes. Prompt on stderr so --json stdout
    # stays machine-readable.
    prompt = (
        f"Type {CONFIRM_PHRASE!r} to write template-layer files "
        f"into {ops_root}: "
    )
    if args.confirm_input is not None:
        answer = args.confirm_input
    else:
        try:
            sys.stderr.write(prompt)
            sys.stderr.flush()
            answer = sys.stdin.readline()
            if answer == "":
                raise EOFError
        except EOFError:
            sys.stderr.write("template-apply: no confirmation (EOF); aborting\n")
            return 2
    if answer.strip() != CONFIRM_PHRASE:
        sys.stderr.write("template-apply: confirmation declined; no writes\n")
        return 2

    try:
        results = apply_planned(template_root, ops_root, actions, values)
    except (OSError, RuntimeError, UnicodeDecodeError) as exc:
        sys.stderr.write(f"template-apply: write aborted: {exc}\n")
        return 2
    if args.json:
        json.dump({"phase": "write", "actions": results}, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        sys.stdout.write("write results:\n")
        for item in results:
            sys.stdout.write(
                f"  {item['action']}: {item['path']} — {item['reason']}\n"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
