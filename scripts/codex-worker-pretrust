#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s <worktree-path> [--accounts-dir <dir>]\n' "${0##*/}" >&2
}

if [[ $# -ne 1 && $# -ne 3 ]]; then
  usage
  exit 2
fi

worktree_path=$1
if [[ "$worktree_path" != /* ]]; then
  printf 'ERROR worktree path must be absolute: %s\n' "$worktree_path" >&2
  usage
  exit 2
fi

if [[ $# -eq 3 ]]; then
  if [[ "$2" != "--accounts-dir" || -z "$3" ]]; then
    usage
    exit 2
  fi
  accounts_dir=$3
elif [[ -n "${CODEX_ACCOUNTS_DIR:-}" ]]; then
  accounts_dir=$CODEX_ACCOUNTS_DIR
else
  case "$(uname -s 2>/dev/null || printf unknown)" in
    Darwin)
      accounts_dir="$HOME/Library/Application Support/orca/codex-accounts"
      ;;
    *)
      accounts_dir="$HOME/.local/share/orca/codex-accounts"
      ;;
  esac
fi

if [[ ! -d "$accounts_dir" ]]; then
  printf 'INFO accounts directory not found: %s; nothing to pre-trust\n' "$accounts_dir"
  printf 'Summary: 0 added, 0 updated, 0 already trusted\n'
  exit 0
fi

# TOML basic strings escape backslashes and double quotes. Worktree paths with
# line breaks cannot be represented safely as a single-line table name.
if [[ "$worktree_path" == *$'\n'* || "$worktree_path" == *$'\r'* ]]; then
  printf 'ERROR worktree path must not contain a line break\n' >&2
  exit 2
fi
escaped_path=${worktree_path//\\/\\\\}
escaped_path=${escaped_path//\"/\\\"}
project_header="[projects.\"$escaped_path\"]"

shopt -s nullglob
config_files=("$accounts_dir"/*/home/config.toml)
added=0
updated=0
already_trusted=0

# Find an interpreter that can verify the edit, rather than demanding one by
# version. The probe is the capability itself (tomllib import), so an unsuitable
# candidate drops out harmlessly. `python` is last for the hosts that only name
# it that way (Windows Git Bash, some venvs).
python_bin=""
for python_candidate in python3 python3.14 python3.13 python3.12 python3.11 python; do
  if command -v "$python_candidate" >/dev/null 2>&1 \
    && "$python_candidate" -c 'import tomllib' >/dev/null 2>&1; then
    python_bin="$python_candidate"
    break
  fi
done
if [[ -z "$python_bin" ]]; then
  # Not an error: nothing was touched and dispatch can proceed. The consequence
  # is stated instead of enforced — workers will hit an interactive trust prompt
  # that this script exists to remove.
  printf 'SKIP no Python with tomllib found (tried python3, python3.14-3.11, python); config edits are verified by parsing TOML, so nothing was changed and dispatched Codex workers will see a trust prompt\n' >&2
  printf 'Summary: 0 added, 0 updated, 0 already trusted\n'
  exit 0
fi

for config_file in "${config_files[@]}"; do
  status=$(
    "$python_bin" - "$config_file" "$worktree_path" "$project_header" <<'PY'
import copy
import re
import sys
from pathlib import Path


config_path = Path(sys.argv[1])
worktree_path = sys.argv[2]
project_header = sys.argv[3].encode("utf-8")

try:
    import tomllib
except ImportError:
    print(
        f"ERROR {config_path}: Python 3.11+ is required for safe TOML editing "
        "because codex-worker-pretrust requires tomllib",
        file=sys.stderr,
    )
    raise SystemExit(2)

original_content = config_path.read_bytes()


def abort(message: str) -> None:
    print(f"ERROR {config_path}: {message}", file=sys.stderr)
    raise SystemExit(2)


def parse_content(content: bytes):
    return tomllib.loads(content.decode("utf-8"))


try:
    original_document = parse_content(original_content)
except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
    abort(f"cannot parse TOML before pre-trust edit: {error}")

projects = original_document.get("projects")
if projects is None:
    project_status = "missing"
elif not isinstance(projects, dict):
    abort("top-level projects value is not a table")
elif worktree_path not in projects:
    project_status = "missing"
else:
    project = projects[worktree_path]
    if not isinstance(project, dict):
        abort(f"projects[{worktree_path!r}] is not a table")
    if "trust_level" not in project:
        project_status = "trust_missing"
    elif project["trust_level"] == "trusted":
        print("already")
        raise SystemExit(0)
    else:
        project_status = "untrusted"

expected_document = copy.deepcopy(original_document)
expected_projects = expected_document.get("projects")
if expected_projects is None:
    expected_projects = {}
    expected_document["projects"] = expected_projects
if not isinstance(expected_projects, dict):
    abort("cannot construct the expected projects table")
expected_project = expected_projects.get(worktree_path)
if expected_project is None:
    expected_project = {}
    expected_projects[worktree_path] = expected_project
if not isinstance(expected_project, dict):
    abort(f"cannot update projects[{worktree_path!r}]")
expected_project["trust_level"] = "trusted"

lines = original_content.splitlines(keepends=True)


def split_ending(line: bytes) -> tuple[bytes, bytes]:
    if line.endswith(b"\r\n"):
        return line[:-2], b"\r\n"
    if line.endswith(b"\n"):
        return line[:-1], b"\n"
    return line, b""


assignment_pattern = re.compile(rb"^[ \t]*trust_level[ \t]*=")
candidates: list[bytes] = []

if project_status == "missing":
    candidates.append(
        original_content
        + b"\n"
        + project_header
        + b'\ntrust_level = "trusted"\n'
    )
elif project_status == "trust_missing":
    for header_index, line in enumerate(lines):
        header_content, header_ending = split_ending(line)
        if header_content != project_header:
            continue
        candidate_lines = lines.copy()
        newline = header_ending or next(
            (ending for item in lines if (ending := split_ending(item)[1])),
            b"\n",
        )
        if not header_ending:
            candidate_lines[header_index] = header_content + newline
        candidate_lines.insert(
            header_index + 1,
            b'trust_level = "trusted"' + newline,
        )
        candidates.append(b"".join(candidate_lines))
else:
    for assignment_index, line in enumerate(lines):
        content, ending = split_ending(line)
        if not assignment_pattern.match(content):
            continue
        candidate_lines = lines.copy()
        indentation = content[: len(content) - len(content.lstrip(b" \t"))]
        candidate_lines[assignment_index] = (
            indentation + b'trust_level = "trusted"' + ending
        )
        candidates.append(b"".join(candidate_lines))


def candidate_matches_expected(content: bytes) -> bool:
    try:
        return parse_content(content) == expected_document
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        return False


valid_candidates = [
    candidate for candidate in candidates if candidate_matches_expected(candidate)
]
if len(valid_candidates) != 1:
    abort(
        "could not produce exactly one verified pre-trust edit "
        f"(found {len(valid_candidates)})"
    )

proposed_content = valid_candidates[0]
try:
    proposed_document = parse_content(proposed_content)
except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
    abort(f"proposed pre-trust edit is not valid TOML: {error}")

proposed_projects = proposed_document.get("projects")
proposed_project = (
    proposed_projects.get(worktree_path)
    if isinstance(proposed_projects, dict)
    else None
)
if not isinstance(proposed_project, dict):
    abort("proposed pre-trust edit did not create the target project table")
if proposed_project.get("trust_level") != "trusted":
    abort("proposed pre-trust edit did not set trust_level to trusted")
if proposed_document != expected_document:
    abort("proposed pre-trust edit changed unrelated TOML data")

config_path.write_bytes(proposed_content)
print("added" if project_status == "missing" else "updated")
PY
  )

  case "$status" in
    already)
      printf '%s: already trusted\n' "$config_file"
      already_trusted=$((already_trusted + 1))
      ;;
    updated)
      printf '%s: trusted (updated)\n' "$config_file"
      updated=$((updated + 1))
      ;;
    added)
      printf '%s: trusted (added)\n' "$config_file"
      added=$((added + 1))
      ;;
    *)
      printf 'ERROR unexpected pre-trust status for %s: %s\n' "$config_file" "$status" >&2
      exit 2
      ;;
  esac
done

printf 'Summary: %d added, %d updated, %d already trusted\n' \
  "$added" "$updated" "$already_trusted"
