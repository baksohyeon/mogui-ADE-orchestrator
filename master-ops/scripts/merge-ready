#!/usr/bin/env bash
# One measurement for a pull request, run by the worker before `worker_done`
# and by the master before merge (#330). This command reads GitHub state and
# never runs code from the pull request.
#
# Usage: merge-ready --repo <owner/name> --pr <n> [--contract <file>]
#
# Exit codes:
#   0  merge: every measurement passed and no stop-list path was touched.
#   1  not ready: a measurement failed, a GitHub response could not be read
#      or parsed, or this invocation could not run.
#   2  ask the owner: a changed path matches the stop list, or a changed path
#      falls outside the contract's `writes` globs.
#
# One summary line on stdout names every failing or asking item.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
STOP_PATHS_FILE="${SCRIPT_DIR}/../config/merge-ready-stop-paths.txt"
BOTS_FILE="${SCRIPT_DIR}/../config/merge-ready-bots.txt"

usage() {
  echo "usage: merge-ready --repo <owner/name> --pr <n> [--contract <file>]" >&2
  exit 1
}

REPO=""
PR=""
CONTRACT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      [ $# -ge 2 ] || usage
      REPO="$2"
      shift 2
      ;;
    --pr)
      [ $# -ge 2 ] || usage
      PR="$2"
      shift 2
      ;;
    --contract)
      [ $# -ge 2 ] || usage
      CONTRACT="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done
[ -n "${REPO}" ] && [ -n "${PR}" ] || usage

command -v gh >/dev/null 2>&1 || { echo "merge-ready: not ready · gh is required"; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "merge-ready: not ready · python3 is required"; exit 1; }
if [ -n "${CONTRACT}" ] && [ ! -f "${CONTRACT}" ]; then
  echo "merge-ready: not ready · --contract file not found: ${CONTRACT}"
  exit 1
fi
if [ ! -f "${STOP_PATHS_FILE}" ]; then
  echo "merge-ready: not ready · stop-paths file not found: ${STOP_PATHS_FILE}"
  exit 1
fi
if [ ! -f "${BOTS_FILE}" ]; then
  echo "merge-ready: not ready · bots file not found: ${BOTS_FILE}"
  exit 1
fi
if [ -z "${CONTRACT}" ]; then
  echo "merge-ready: out-of-contract check skipped (no --contract)" >&2
fi

TMP_DIR="$(mktemp -d -t merge-ready.XXXXXX)" || {
  echo "merge-ready: not ready · mktemp failed"
  exit 1
}
trap 'rm -rf "${TMP_DIR}"' EXIT

PR_HEAD_FILE="${TMP_DIR}/pr-head.json"
PR_HEAD_ERR="${TMP_DIR}/pr-head.err"
CHECKS_FILE="${TMP_DIR}/checks.json"
CHECKS_ERR="${TMP_DIR}/checks.err"
GQL_FILE="${TMP_DIR}/graphql.json"
GQL_ERR="${TMP_DIR}/graphql.err"
FILES_RAW="${TMP_DIR}/files-raw.json"
FILES_FILE="${TMP_DIR}/files.json"
FILES_ERR="${TMP_DIR}/files.err"
COMMENTS_RAW="${TMP_DIR}/comments-raw.json"
COMMENTS_FILE="${TMP_DIR}/comments.json"
COMMENTS_ERR="${TMP_DIR}/comments.err"
CHECK_RUNS_RAW="${TMP_DIR}/check-runs-raw.json"
CHECK_RUNS_ERR="${TMP_DIR}/check-runs.err"
CHECK_SUITES_RAW="${TMP_DIR}/check-suites-raw.json"
CHECK_SUITES_ERR="${TMP_DIR}/check-suites.err"
TIMELINE_RAW="${TMP_DIR}/timeline-raw.json"
TIMELINE_FILE="${TMP_DIR}/timeline.json"
TIMELINE_ERR="${TMP_DIR}/timeline.err"
HEAD_TIME_FILE="${TMP_DIR}/head-time.txt"
HEAD_TIME_ERR="${TMP_DIR}/head-time.err"
PR_FILE="${TMP_DIR}/pr.json"
PR_ERR="${TMP_DIR}/pr.err"

not_ready() {
  echo "merge-ready: not ready · $1"
  exit 1
}

require_json() {
  local file="$1" kind="${2:-}" reason
  reason="$(python3 -c '
import json, sys
file_path, kind = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(file_path, encoding="utf-8"))
except Exception as exc:
    print("unparseable: " + str(exc)); sys.exit(1)
if kind == "nonempty-list" and not (isinstance(data, list) and len(data) > 0):
    print("expected a non-empty list, got " + type(data).__name__); sys.exit(1)
' "${file}" "${kind}" 2>&1)" && return 0
  not_ready "${file##*/}: ${reason}"
}

fetch_paginated_array() {
  local api_path="$1" raw="$2" flat="$3" err="$4" label="$5"
  if ! gh api "${api_path}" --paginate --slurp >"${raw}" 2>"${err}"; then
    not_ready "could not read ${label} ($(tr '\n' ' ' <"${err}"))"
  fi
  if ! python3 -c '
import json, sys
raw_path, flat_path = sys.argv[1], sys.argv[2]
pages = json.load(open(raw_path, encoding="utf-8"))
if not isinstance(pages, list) or not all(isinstance(page, list) for page in pages):
    raise ValueError("expected a list of array pages")
json.dump([item for page in pages for item in page], open(flat_path, "w", encoding="utf-8"))
' "${raw}" "${flat}" 2>"${err}"; then
    not_ready "${label}: could not flatten the response ($(tr '\n' ' ' <"${err}"))"
  fi
}

if ! gh pr view "${PR}" --repo "${REPO}" --json headRefOid \
    >"${PR_HEAD_FILE}" 2>"${PR_HEAD_ERR}"; then
  not_ready "could not read the PR (gh pr view: $(tr '\n' ' ' <"${PR_HEAD_ERR}"))"
fi
require_json "${PR_HEAD_FILE}"
HEAD_SHA="$(python3 -c '
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["headRefOid"])
' "${PR_HEAD_FILE}" 2>"${TMP_DIR}/head-parse.err")" || {
  not_ready "PR response missing headRefOid ($(tr '\n' ' ' <"${TMP_DIR}/head-parse.err"))"
}

fetch_paginated_array "repos/${REPO}/pulls/${PR}/files" "${FILES_RAW}" "${FILES_FILE}" "${FILES_ERR}" "changed files"
require_json "${FILES_FILE}" nonempty-list
FILE_COUNT="$(python3 -c 'import json, sys; print(len(json.load(open(sys.argv[1], encoding="utf-8"))))' "${FILES_FILE}" 2>"${TMP_DIR}/file-count.err")" || {
  not_ready "changed files: could not count the response ($(tr '\n' ' ' <"${TMP_DIR}/file-count.err"))"
}
if [ "${FILE_COUNT}" -ge 3000 ]; then
  not_ready "changed files response reached GitHub's 3000-file cap (${FILE_COUNT}); complete file set cannot be verified"
fi

if ! gh api "repos/${REPO}/commits/${HEAD_SHA}/check-runs" --paginate --slurp \
    >"${CHECK_RUNS_RAW}" 2>"${CHECK_RUNS_ERR}"; then
  not_ready "could not read the head check runs ($(tr '\n' ' ' <"${CHECK_RUNS_ERR}"))"
fi
CHECK_RUN_TIME_RC=0
python3 - "${CHECK_RUNS_RAW}" >"${HEAD_TIME_FILE}" 2>"${HEAD_TIME_ERR}" <<'PY' || CHECK_RUN_TIME_RC=$?
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

def parse_timestamp(value):
    if not isinstance(value, str) or not value:
        raise ValueError("missing or empty GitHub timestamp")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ValueError(f"invalid GitHub timestamp {value!r}") from exc
    if parsed.tzinfo is None:
        raise ValueError(f"GitHub timestamp has no timezone {value!r}")
    return parsed.astimezone(timezone.utc)

pages = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
if not isinstance(pages, list) or not all(isinstance(page, dict) for page in pages):
    raise ValueError("expected a list of check-run response objects")

timestamps = []
for page in pages:
    check_runs = page.get("check_runs")
    if not isinstance(check_runs, list):
        raise ValueError("check-run response is missing check_runs")
    for check_run in check_runs:
        if not isinstance(check_run, dict):
            raise ValueError("check-run response contains a malformed check run")
        created_at = check_run.get("created_at")
        if created_at is not None:
            timestamps.append(parse_timestamp(created_at))
        check_suite = check_run.get("check_suite")
        if isinstance(check_suite, dict):
            suite_created_at = check_suite.get("created_at")
            if suite_created_at is not None:
                timestamps.append(parse_timestamp(suite_created_at))

if not timestamps:
    raise ValueError("head check runs have no check-suite or check-run creation time")
print(min(timestamps).isoformat(timespec="seconds").replace("+00:00", "Z"))
PY
if [ "${CHECK_RUN_TIME_RC}" -ne 0 ]; then
  CHECK_SUITE_TIME_RC=0
  if ! gh api "repos/${REPO}/commits/${HEAD_SHA}/check-suites" --paginate --slurp \
      >"${CHECK_SUITES_RAW}" 2>"${CHECK_SUITES_ERR}"; then
    printf '%s' "could not read head check suites: $(tr '\n' ' ' <"${CHECK_SUITES_ERR}")" >"${HEAD_TIME_ERR}"
    CHECK_SUITE_TIME_RC=1
  else
    python3 - "${CHECK_SUITES_RAW}" >"${HEAD_TIME_FILE}" 2>"${HEAD_TIME_ERR}" <<'PY' || CHECK_SUITE_TIME_RC=$?
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

def parse_timestamp(value):
    if not isinstance(value, str) or not value:
        raise ValueError("missing or empty GitHub timestamp")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ValueError(f"invalid GitHub timestamp {value!r}") from exc
    if parsed.tzinfo is None:
        raise ValueError(f"GitHub timestamp has no timezone {value!r}")
    return parsed.astimezone(timezone.utc)

pages = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
if not isinstance(pages, list) or not all(isinstance(page, dict) for page in pages):
    raise ValueError("expected a list of check-suite response objects")

timestamps = []
for page in pages:
    check_suites = page.get("check_suites")
    if not isinstance(check_suites, list):
        raise ValueError("check-suite response is missing check_suites")
    for check_suite in check_suites:
        if not isinstance(check_suite, dict):
            raise ValueError("check-suite response contains a malformed check suite")
        created_at = check_suite.get("created_at")
        if created_at is not None:
            timestamps.append(parse_timestamp(created_at))

if not timestamps:
    raise ValueError("head check suites have no creation time")
print(min(timestamps).isoformat(timespec="seconds").replace("+00:00", "Z"))
PY
  fi
  if [ "${CHECK_SUITE_TIME_RC}" -ne 0 ]; then
    if ! fetch_paginated_array "repos/${REPO}/issues/${PR}/timeline" "${TIMELINE_RAW}" "${TIMELINE_FILE}" "${TIMELINE_ERR}" "PR timeline"; then
      not_ready "head check runs and suites: could not establish a trusted creation time ($(tr '\n' ' ' <"${HEAD_TIME_ERR}")); timeline fallback failed"
    fi
    if ! python3 - "${TIMELINE_FILE}" "${HEAD_SHA}" >"${HEAD_TIME_FILE}" 2>"${HEAD_TIME_ERR}" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

def parse_timestamp(value):
    if not isinstance(value, str) or not value:
        raise ValueError("missing or empty GitHub timestamp")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ValueError(f"invalid GitHub timestamp {value!r}") from exc
    if parsed.tzinfo is None:
        raise ValueError(f"GitHub timestamp has no timezone {value!r}")
    return parsed.astimezone(timezone.utc)

events = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
head_sha = sys.argv[2]
if not isinstance(events, list):
    raise ValueError("expected a list of timeline events")

timestamps = []
for event in events:
    if not isinstance(event, dict):
        raise ValueError("timeline response contains a malformed event")
    created_at = event.get("created_at")
    if not isinstance(created_at, str) or not created_at:
        continue
    timestamp = parse_timestamp(created_at)
    if (
        event.get("event") == "head_ref_force_pushed"
        and event.get("commit_id") == head_sha
    ) or (
        event.get("event") == "committed"
        and event.get("sha") == head_sha
    ):
        timestamps.append(timestamp)

if not timestamps:
    raise ValueError("PR timeline has no push event for the measured head")
print(min(timestamps).isoformat(timespec="seconds").replace("+00:00", "Z"))
PY
    then
      not_ready "head check runs and suites: could not establish a trusted creation time ($(tr '\n' ' ' <"${HEAD_TIME_ERR}"))"
    fi
  fi
fi
HEAD_TIME="$(cat "${HEAD_TIME_FILE}")"
[ -n "${HEAD_TIME}" ] || not_ready "head check runs creation time response was empty"

PATH_VERDICT="$(python3 - "${FILES_FILE}" "${STOP_PATHS_FILE}" "${CONTRACT}" <<'PY'
import fnmatch
import json
import re
import sys
from pathlib import Path

files_file, stop_paths_file, contract_path = sys.argv[1:4]
files = json.loads(Path(files_file).read_text(encoding="utf-8"))
changed_paths = sorted(
    {item["filename"] for item in files}
    | {item["previous_filename"] for item in files if item.get("previous_filename")}
)


def matches_stop(path, entry):
    if entry.endswith("/"):
        return path == entry.rstrip("/") or path.startswith(entry)
    if any(char in entry for char in "*?["):
        return fnmatch.fnmatch(path, entry)
    return path == entry


stop_entries = [
    line.strip() for line in Path(stop_paths_file).read_text(encoding="utf-8").splitlines()
    if line.strip() and not line.strip().startswith("#")
]
if not stop_entries:
    print(f"stop-paths file has no entries: {stop_paths_file}")
    sys.exit(1)

stop_hits = [path for path in changed_paths if any(matches_stop(path, entry) for entry in stop_entries)]
problems = []
if stop_hits:
    problems.append(
        f"{len(stop_hits)} stop-list path(s): " + ", ".join(f"{path} (stop-list)" for path in stop_hits)
    )

if contract_path:
    text = Path(contract_path).read_text(encoding="utf-8")
    front_matter_match = re.match(r"^---\n(.*?\n)---", text, re.DOTALL)
    front_matter = front_matter_match.group(1) if front_matter_match else ""
    globs = None
    for front_matter_line in front_matter.splitlines():
        key, separator, raw_value = front_matter_line.partition(":")
        if separator and key.strip() == "writes":
            raw_value = raw_value.strip()
            if raw_value.startswith("[") and raw_value.endswith("]"):
                inner = raw_value[1:-1].strip()
                globs = [glob.strip() for glob in inner.split(",") if glob.strip()] if inner else []
            break
    if globs is not None:
        outside = [path for path in changed_paths if not any(fnmatch.fnmatch(path, glob) for glob in globs)]
        if outside:
            problems.append("path(s) outside contract writes: " + ", ".join(outside))

if problems:
    print("merge-ready: ask · " + "; ".join(problems))
    sys.exit(2)
sys.exit(0)
PY
)"
PATH_RC=$?
if [ "${PATH_RC}" -eq 2 ]; then
  echo "${PATH_VERDICT} (head ${HEAD_SHA})"
  exit 2
fi
if [ "${PATH_RC}" -ne 0 ]; then
  if [ -n "${PATH_VERDICT}" ]; then
    not_ready "${PATH_VERDICT}"
  fi
  not_ready "changed paths: could not check the stop-list or contract scope"
fi

if ! gh pr checks "${PR}" --repo "${REPO}" --required --json name,bucket,state \
    >"${CHECKS_FILE}" 2>"${CHECKS_ERR}"; then
  if ! python3 -c 'import json, sys; json.load(open(sys.argv[1], encoding="utf-8"))' \
      "${CHECKS_FILE}" >/dev/null 2>&1; then
    not_ready "could not read required checks (gh pr checks: $(tr '\n' ' ' <"${CHECKS_ERR}"))"
  fi
fi
require_json "${CHECKS_FILE}" nonempty-list

OWNER="${REPO%%/*}"
NAME="${REPO#*/}"
if ! gh api graphql \
    -f owner="${OWNER}" -f name="${NAME}" -F number="${PR}" \
    -f query='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){reviewThreads(first:100){nodes{isResolved} pageInfo{hasNextPage}} reviews(first:100){nodes{state submittedAt commit{oid} author{login __typename}} pageInfo{hasNextPage}}}}}' \
    >"${GQL_FILE}" 2>"${GQL_ERR}"; then
  not_ready "could not read review threads/reviews ($(tr '\n' ' ' <"${GQL_ERR}"))"
fi
require_json "${GQL_FILE}"

fetch_paginated_array "repos/${REPO}/issues/${PR}/comments" "${COMMENTS_RAW}" "${COMMENTS_FILE}" "${COMMENTS_ERR}" "PR comments"
require_json "${COMMENTS_FILE}"

if ! gh pr view "${PR}" --repo "${REPO}" --json number,url,headRefOid,state,isDraft \
    >"${PR_FILE}" 2>"${PR_ERR}"; then
  not_ready "could not read the PR (gh pr view: $(tr '\n' ' ' <"${PR_ERR}"))"
fi
require_json "${PR_FILE}"

python3 - "${PR_FILE}" "${CHECKS_FILE}" "${GQL_FILE}" "${FILES_FILE}" "${COMMENTS_FILE}" \
         "${STOP_PATHS_FILE}" "${BOTS_FILE}" "${HEAD_SHA}" "${HEAD_TIME}" "${CONTRACT}" <<'PY'
import fnmatch
import json
import re
import sys
from pathlib import Path

(pr_file, checks_file, gql_file, files_file, comments_file, stop_paths_file,
 bots_file, head_sha, head_time, contract_path) = sys.argv[1:11]


def load(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def fail(reason):
    print(f"merge-ready: not ready · {reason}")
    sys.exit(1)


def require_connection(obj, name):
    if (
        not isinstance(obj, dict)
        or not isinstance(obj.get("nodes"), list)
        or not isinstance(obj.get("pageInfo"), dict)
        or not isinstance(obj["pageInfo"].get("hasNextPage"), bool)
    ):
        fail(f"graphql response missing or malformed {name} (nodes/pageInfo)")
    return obj


def strip_bot_suffix(login):
    return login[:-5] if login.lower().endswith("[bot]") else login


try:
    pr = load(pr_file)
    checks = load(checks_file)
    gql = load(gql_file)
    files = load(files_file)
    comments = load(comments_file)

    if not isinstance(pr, dict) or not isinstance(pr.get("headRefOid"), str):
        fail("PR response missing or malformed headRefOid")
    if not isinstance(pr.get("state"), str) or not isinstance(pr.get("isDraft"), bool):
        fail("PR response missing or malformed state/isDraft")

    if pr.get("headRefOid") != head_sha:
        fail(f"head changed during measurement (started {head_sha[:12]}, now {(pr.get('headRefOid') or '?')[:12]}); rerun")

    changed_paths = sorted(
        {f["filename"] for f in files}
        | {f["previous_filename"] for f in files if f.get("previous_filename")}
    )
    problems_ask = []
    problems_not_ready = []

    if pr.get("state") != "OPEN":
        problems_not_ready.append(f"PR state is {pr.get('state')}, not OPEN")
    if pr.get("isDraft"):
        problems_not_ready.append("PR is a draft")

    failing_checks = [
        f"{c.get('name', 'unknown')}={c.get('state', c.get('bucket', 'unknown'))}"
        for c in checks
        if c.get("bucket") != "pass"
    ]
    if failing_checks:
        problems_not_ready.append("checks: " + ", ".join(failing_checks))

    pull_request = (gql.get("data") or {}).get("repository", {}).get("pullRequest")
    if not isinstance(pull_request, dict):
        fail("graphql response missing data.repository.pullRequest")
    reviews = require_connection(pull_request.get("reviews"), "reviews")
    if reviews["pageInfo"]["hasNextPage"]:
        problems_not_ready.append("more than 100 reviews; rerun with pagination")

    decision_states = {"APPROVED", "CHANGES_REQUESTED", "DISMISSED", "PENDING"}
    decision_reviews = {}
    head_bot_reviewer_logins = set()
    for index, node in enumerate(reviews["nodes"]):
        if not isinstance(node, dict):
            fail("graphql response has a malformed review node")
        author = node.get("author") or {}
        if author.get("__typename") != "Bot":
            continue
        login = strip_bot_suffix(author.get("login", ""))
        if (node.get("commit") or {}).get("oid") != head_sha:
            continue
        if login:
            head_bot_reviewer_logins.add(login)
        state = (node.get("state") or "").upper()
        if state in decision_states:
            decision_reviews.setdefault(login or "unknown", []).append(
                (node.get("submittedAt") or "", index, state)
            )

    latest_bot_state = {
        login: max(reviews_for_bot, key=lambda item: (item[0], item[1]))[2]
        for login, reviews_for_bot in decision_reviews.items()
    }

    failing_bots = [
        f"{login}={state.lower()}"
        for login, state in latest_bot_state.items()
        if state in {"PENDING", "CHANGES_REQUESTED"}
    ]
    if failing_bots:
        problems_not_ready.append("review bots: " + ", ".join(failing_bots))

    bots = [
        line.strip() for line in Path(bots_file).read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    if not bots:
        fail(f"bots file has no entries: {bots_file}")

    def is_rate_limit_notice(login, body):
        if login not in bots:
            return False
        lines = set(body.splitlines())
        marker_lines = [
            line for line in lines
            if line.startswith("<!-- This is an auto-generated comment: rate limited by ")
            and line.endswith(" -->")
        ]
        return len(marker_lines) == 1 and "> ## Review limit reached" in lines

    recent_rate_limited_bots = set()
    for comment in comments:
        if not isinstance(comment, dict):
            fail("PR comments response has a malformed comment")
        user = comment.get("user") or {}
        login = strip_bot_suffix(user.get("login", ""))
        if user.get("type") != "Bot" or login not in bots:
            continue
        comment_time = max(comment.get("created_at") or "", comment.get("updated_at") or "")
        if comment_time >= head_time and is_rate_limit_notice(login, comment.get("body") or ""):
            recent_rate_limited_bots.add(login)

    missing_bots = [
        bot for bot in bots
        if bot not in head_bot_reviewer_logins and bot not in recent_rate_limited_bots
    ]
    if missing_bots:
        problems_not_ready.append(
            "bot(s) with no head review or measured rate-limit comment: " + ", ".join(missing_bots)
        )

    threads = require_connection(pull_request.get("reviewThreads"), "reviewThreads")
    if threads["pageInfo"]["hasNextPage"]:
        problems_not_ready.append("more than 100 review threads; rerun with pagination")
    open_threads = sum(
        1 for thread in threads["nodes"]
        if not isinstance(thread, dict) or not thread.get("isResolved", False)
    )
    if open_threads:
        problems_not_ready.append(f"{open_threads} open review thread(s)")

    def matches_stop(path, entry):
        if entry.endswith("/"):
            return path == entry.rstrip("/") or path.startswith(entry)
        if any(char in entry for char in "*?["):
            return fnmatch.fnmatch(path, entry)
        return path == entry

    stop_entries = [
        line.strip() for line in Path(stop_paths_file).read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    if not stop_entries:
        fail(f"stop-paths file has no entries: {stop_paths_file}")
    stop_hits = [path for path in changed_paths if any(matches_stop(path, entry) for entry in stop_entries)]
    if stop_hits:
        problems_ask.append(
            f"{len(stop_hits)} stop-list path(s): " + ", ".join(f"{path} (stop-list)" for path in stop_hits)
        )

    if contract_path:
        text = Path(contract_path).read_text(encoding="utf-8")
        front_matter_match = re.match(r"^---\n(.*?\n)---", text, re.DOTALL)
        front_matter = front_matter_match.group(1) if front_matter_match else ""
        globs = None
        for front_matter_line in front_matter.splitlines():
            key, separator, raw_value = front_matter_line.partition(":")
            if separator and key.strip() == "writes":
                raw_value = raw_value.strip()
                if raw_value.startswith("[") and raw_value.endswith("]"):
                    inner = raw_value[1:-1].strip()
                    globs = [glob.strip() for glob in inner.split(",") if glob.strip()] if inner else []
                break
        if globs is None:
            problems_not_ready.append("contract front matter has no writes: list; cannot verify scope")
        else:
            outside = [path for path in changed_paths if not any(fnmatch.fnmatch(path, glob) for glob in globs)]
            if outside:
                problems_ask.append("path(s) outside contract writes: " + ", ".join(outside))

    if problems_ask:
        print(f"merge-ready: ask · {'; '.join(problems_ask + problems_not_ready)} (head {head_sha})")
        sys.exit(2)
    if problems_not_ready:
        print("merge-ready: not ready · " + "; ".join(problems_not_ready))
        sys.exit(1)
    print(f"merge-ready: merge · every GitHub-state measurement passed (head {head_sha})")
    sys.exit(0)
except SystemExit:
    raise
except Exception as exc:
    fail(f"internal error: {exc}")
