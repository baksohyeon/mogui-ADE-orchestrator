#!/usr/bin/env python3
"""Command line entry point for master runtime bootstrap."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


SCRIPT_PATH = Path(__file__).resolve()
REPO_ROOT = SCRIPT_PATH.parent.parent
SRC_ROOT = REPO_ROOT / "src"
sys.path.insert(0, str(SRC_ROOT))

from master_runtime.core.bootstrap import (  # noqa: E402
    BootstrapConfig,
    BootstrapError,
    bootstrap,
)


def main(argv=None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)
    config = BootstrapConfig(
        charter_path=args.charter,
        handoff_path=args.handoff,
        budget_chars=args.budget,
        session_id=args.session_id,
        strict_lease=args.strict_lease,
    )

    try:
        result = bootstrap(config)
    except BootstrapError as exc:
        print(str(exc), file=sys.stderr)
        return 2

    payload = result.to_dict()
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
    else:
        role_state = payload["role_state"] or {}
        print("role=" + str(role_state.get("role", "")))
        print("budget_used=" + str(payload["budget_used"]))
        print("warnings=" + ",".join(payload["warnings"]))
    return 0


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="master-bootstrap")
    parser.add_argument("--charter", required=True)
    parser.add_argument("--handoff")
    parser.add_argument("--budget", type=int, default=24_000)
    parser.add_argument("--session-id")
    parser.add_argument("--strict-lease", action="store_true")
    parser.add_argument("--json", action="store_true")
    return parser


if __name__ == "__main__":
    raise SystemExit(main())
