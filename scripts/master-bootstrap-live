#!/usr/bin/env python3
"""master-bootstrap-live — SessionStart hook entry point.

Emits the dynamic master bootstrap block. Booting must never die: any
internal error is reduced to a ``[BOOTSTRAP-FALLBACK]`` line and the exit
code is always 0.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

SCRIPT_PATH = Path(__file__).resolve()
REPO_ROOT = SCRIPT_PATH.parent.parent
SRC_ROOT = REPO_ROOT / "src"
sys.path.insert(0, str(SRC_ROOT))


def _make_bd_runner(bd_exe):
    def runner(argv):
        cmd = [bd_exe] + list(argv)[1:]
        result = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
        )
        return result.stdout

    return runner


_COMPACT_SUPPRESSED_LINE = (
    "[E12] compact: tracks/role suppressed for recall probe "
    "(정본은 회상 기록 후 bd로 대조)"
)


def _session_source_from_stdin():
    raw = sys.stdin.read()
    if not raw.strip():
        return None
    try:
        payload = json.loads(raw)
    except Exception:
        return None
    if not isinstance(payload, dict):
        return None
    return payload.get("source")


def _suppress_compact_recall_leaks(block):
    lines = block.splitlines()
    output = []
    suppressed = False
    skip_section = False

    for line in lines:
        if line in {"## Role State", "## 활성 트랙"}:
            if not suppressed:
                output.append(_COMPACT_SUPPRESSED_LINE)
                suppressed = True
            skip_section = True
            continue
        if line.startswith("## "):
            skip_section = False
        if not skip_section:
            output.append(line)

    if suppressed:
        return "\n".join(output)
    if lines and lines[0].startswith("[MASTER-BOOTSTRAP"):
        return "\n".join([lines[0], _COMPACT_SUPPRESSED_LINE] + lines[1:])
    return _COMPACT_SUPPRESSED_LINE + "\n" + block


def main(argv=None) -> int:
    try:
        from master_runtime.core.bootstrap_live import (  # noqa: E402
            DEFAULT_BUDGET_CHARS,
            run_live,
        )

        parser = argparse.ArgumentParser(prog="master-bootstrap-live")
        parser.add_argument("--handoff-dir", required=True)
        parser.add_argument("--budget", type=int, default=DEFAULT_BUDGET_CHARS)
        parser.add_argument("--bd", default="bd")
        args = parser.parse_args(argv)
        source = _session_source_from_stdin()

        block = run_live(
            Path(args.handoff_dir),
            bd_runner=_make_bd_runner(args.bd),
            probe=None,
            session_id=os.environ.get("CLAUDE_SESSION_ID"),
            budget_chars=args.budget,
        )
        if source == "compact":
            block = _suppress_compact_recall_leaks(block)
        print(block)
        return 0
    except SystemExit:
        raise
    except BaseException as exc:  # noqa: BLE001 — 부팅 불사, 항상 exit 0
        print("[BOOTSTRAP-FALLBACK] CLI " + exc.__class__.__name__ + ": " + str(exc))
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
