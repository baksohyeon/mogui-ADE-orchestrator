#!/usr/bin/env bash
# One measurement for a pull request, run by the worker before `worker_done`
# and by the master before merge (#330). This command reads GitHub state and
# never runs code from the pull request.
#
# Usage: merge-ready --repo <owner/name> --pr <n> [--contract <file>]
#
# Exit codes:
#   0  merge: every measurement passed and no stop-list path was touched.
#   1  not ready: a measurement failed, a GitHub response could not be read
#      or parsed, or this invocation could not run.
#   2  ask the owner: a changed path matches the stop list, or a changed path
#      falls outside the contract's `writes` globs.
#
# One summary line on stdout names every failing or asking item.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
STOP_PATHS_FILE="${SCRIPT_DIR}/../config/merge-ready-stop-paths.txt"
BOTS_FILE="${SCRIPT_DIR}/../config/merge-ready-bots.txt"

usage() {
  echo "usage: merge-ready --repo <owner/name> --pr <n> [--contract <file>]" >&2
  exit 1
}

REPO=""
PR=""
CONTRACT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      [ $# -ge 2 ] || usage
      REPO="$2"
      shift 2
      ;;
    --pr)
      [ $# -ge 2 ] || usage
      PR="$2"
      shift 2
      ;;
    --contract)
      [ $# -ge 2 ] || usage
      CONTRACT="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done
[ -n "${REPO}" ] && [ -n "${PR}" ] || usage

command -v gh >/dev/null 2>&1 || { echo "merge-ready: not ready · gh is required"; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "merge-ready: not ready · python3 is required"; exit 1; }
if [ -n "${CONTRACT}" ] && [ ! -f "${CONTRACT}" ]; then
  echo "merge-ready: not ready · --contract file not found: ${CONTRACT}"
  exit 1
fi
if [ ! -f "${STOP_PATHS_FILE}" ]; then
  echo "merge-ready: not ready · stop-paths file not found: ${STOP_PATHS_FILE}"
  exit 1
fi
if [ ! -f "${BOTS_FILE}" ]; then
  echo "merge-ready: not ready · bots file not found: ${BOTS_FILE}"
  exit 1
fi
if [ -z "${CONTRACT}" ]; then
  echo "merge-ready: out-of-contract check skipped (no --contract)" >&2
fi

TMP_DIR="$(mktemp -d -t merge-ready.XXXXXX)" || {
  echo "merge-ready: not ready · mktemp failed"
  exit 1
}
trap 'rm -rf "${TMP_DIR}"' EXIT

PR_HEAD_FILE="${TMP_DIR}/pr-head.json"
PR_HEAD_ERR="${TMP_DIR}/pr-head.err"
CHECKS_FILE="${TMP_DIR}/checks.json"
CHECKS_ERR="${TMP_DIR}/checks.err"
GQL_FILE="${TMP_DIR}/graphql.json"
GQL_ERR="${TMP_DIR}/graphql.err"
FILES_RAW="${TMP_DIR}/files-raw.json"
FILES_FILE="${TMP_DIR}/files.json"
FILES_ERR="${TMP_DIR}/files.err"
FILES_HEAD_FILE="${TMP_DIR}/files-head.json"
FILES_HEAD_ERR="${TMP_DIR}/files-head.err"
COMMENTS_RAW="${TMP_DIR}/comments-raw.json"
COMMENTS_FILE="${TMP_DIR}/comments.json"
COMMENTS_ERR="${TMP_DIR}/comments.err"
CHECK_RUNS_RAW="${TMP_DIR}/check-runs-raw.json"
CHECK_RUNS_ERR="${TMP_DIR}/check-runs.err"
TIMELINE_RAW="${TMP_DIR}/timeline-raw.json"
TIMELINE_FILE="${TMP_DIR}/timeline.json"
TIMELINE_ERR="${TMP_DIR}/timeline.err"
HEAD_TIME_FILE="${TMP_DIR}/head-time.txt"
HEAD_TIME_ERR="${TMP_DIR}/head-time.err"
PR_FILE="${TMP_DIR}/pr.json"
PR_ERR="${TMP_DIR}/pr.err"
RULES_FILE="${TMP_DIR}/rules.json"
RULES_ERR="${TMP_DIR}/rules.err"
RULES_RAW="${TMP_DIR}/rules-raw.json"
LEGACY_FILE="${TMP_DIR}/legacy-required-status-checks.json"
LEGACY_ERR="${TMP_DIR}/legacy-required-status-checks.err"
REQUIRED_CONTEXTS_FILE="${TMP_DIR}/required-contexts.json"

not_ready() {
  echo "merge-ready: not ready · $1"
  exit 1
}

require_json() {
  local file="$1" kind="${2:-}" reason
  reason="$(python3 -I -c '
import json, sys
file_path, kind = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(file_path, encoding="utf-8"))
except Exception as exc:
    print("unparseable: " + str(exc)); sys.exit(1)
if kind == "nonempty-list" and not (isinstance(data, list) and len(data) > 0):
    print("expected a non-empty list, got " + type(data).__name__); sys.exit(1)
' "${file}" "${kind}" 2>&1)" && return 0
  not_ready "${file##*/}: ${reason}"
}

fetch_paginated_array() {
  local api_path="$1" raw="$2" flat="$3" err="$4" label="$5"
  if ! gh api "${api_path}" --paginate --slurp >"${raw}" 2>"${err}"; then
    not_ready "could not read ${label} ($(tr '\n' ' ' <"${err}"))"
  fi
  if ! python3 -I -c '
import json, sys
raw_path, flat_path = sys.argv[1], sys.argv[2]
pages = json.load(open(raw_path, encoding="utf-8"))
if not isinstance(pages, list) or not all(isinstance(page, list) for page in pages):
    raise ValueError("expected a list of array pages")
json.dump([item for page in pages for item in page], open(flat_path, "w", encoding="utf-8"))
' "${raw}" "${flat}" 2>"${err}"; then
    not_ready "${label}: could not flatten the response ($(tr '\n' ' ' <"${err}"))"
  fi
}

if ! gh pr view "${PR}" --repo "${REPO}" --json headRefOid,baseRefName \
    >"${PR_HEAD_FILE}" 2>"${PR_HEAD_ERR}"; then
  not_ready "could not read the PR (gh pr view: $(tr '\n' ' ' <"${PR_HEAD_ERR}"))"
fi
require_json "${PR_HEAD_FILE}"
HEAD_SHA="$(python3 -I -c '
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["headRefOid"])
' "${PR_HEAD_FILE}" 2>"${TMP_DIR}/head-parse.err")" || {
  not_ready "PR response missing headRefOid ($(tr '\n' ' ' <"${TMP_DIR}/head-parse.err"))"
}
BASE_BRANCH="$(python3 -I -c '
import json, sys
base = json.load(open(sys.argv[1], encoding="utf-8")).get("baseRefName")
if not isinstance(base, str) or not base:
    raise ValueError("PR response missing baseRefName")
print(base)
' "${PR_HEAD_FILE}" 2>"${TMP_DIR}/base-parse.err")" || {
  not_ready "PR response missing baseRefName ($(tr '\n' ' ' <"${TMP_DIR}/base-parse.err"))"
}

fetch_paginated_array "repos/${REPO}/pulls/${PR}/files" "${FILES_RAW}" "${FILES_FILE}" "${FILES_ERR}" "changed files"
require_json "${FILES_FILE}" nonempty-list
FILE_COUNT="$(python3 -I -c 'import json, sys; print(len(json.load(open(sys.argv[1], encoding="utf-8"))))' "${FILES_FILE}" 2>"${TMP_DIR}/file-count.err")" || {
  not_ready "changed files: could not count the response ($(tr '\n' ' ' <"${TMP_DIR}/file-count.err"))"
}
if [ "${FILE_COUNT}" -ge 3000 ]; then
  not_ready "pull request files response reached GitHub's 3000-file cap (${FILE_COUNT}); complete file set cannot be verified"
fi
if ! gh pr view "${PR}" --repo "${REPO}" --json headRefOid \
    >"${FILES_HEAD_FILE}" 2>"${FILES_HEAD_ERR}"; then
  not_ready "could not re-read the PR head after changed files ($(tr '\n' ' ' <"${FILES_HEAD_ERR}"))"
fi
FILES_HEAD_SHA="$(python3 -I -c '
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["headRefOid"])
' "${FILES_HEAD_FILE}" 2>"${TMP_DIR}/files-head-parse.err")" || {
  not_ready "changed files response missing headRefOid ($(tr '\n' ' ' <"${TMP_DIR}/files-head-parse.err"))"
}
if [ "${FILES_HEAD_SHA}" != "${HEAD_SHA}" ]; then
  not_ready "head changed during changed-file measurement (started ${HEAD_SHA:0:12}, now ${FILES_HEAD_SHA:0:12}); rerun"
fi

PATH_VERDICT="$(python3 -I - "${FILES_FILE}" "${STOP_PATHS_FILE}" "${CONTRACT}" <<'PY'
import fnmatch
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

files_file, stop_paths_file, contract_path = sys.argv[1:4]
files = json.loads(Path(files_file).read_text(encoding="utf-8"))
changed_paths = sorted(
    {item["filename"] for item in files}
    | {item["previous_filename"] for item in files if item.get("previous_filename")}
)


def matches_stop(path, entry):
    if entry.endswith("/"):
        return path == entry.rstrip("/") or path.startswith(entry)
    if any(char in entry for char in "*?["):
        return fnmatch.fnmatch(path, entry)
    return path == entry


stop_entries = [
    line.strip() for line in Path(stop_paths_file).read_text(encoding="utf-8").splitlines()
    if line.strip() and not line.strip().startswith("#")
]
if not stop_entries:
    print(f"stop-paths file has no entries: {stop_paths_file}")
    sys.exit(1)

stop_hits = [path for path in changed_paths if any(matches_stop(path, entry) for entry in stop_entries)]
problems = []
if stop_hits:
    problems.append(
        f"{len(stop_hits)} stop-list path(s): " + ", ".join(f"{path} (stop-list)" for path in stop_hits)
    )

if contract_path:
    text = Path(contract_path).read_text(encoding="utf-8")
    front_matter_match = re.match(r"^---\n(.*?\n)---", text, re.DOTALL)
    front_matter = front_matter_match.group(1) if front_matter_match else ""
    globs = None
    for front_matter_line in front_matter.splitlines():
        key, separator, raw_value = front_matter_line.partition(":")
        if separator and key.strip() == "writes":
            raw_value = raw_value.strip()
            if raw_value.startswith("[") and raw_value.endswith("]"):
                inner = raw_value[1:-1].strip()
                globs = [glob.strip() for glob in inner.split(",") if glob.strip()] if inner else []
            break
    if globs is not None:
        outside = [path for path in changed_paths if not any(fnmatch.fnmatch(path, glob) for glob in globs)]
        if outside:
            problems.append("path(s) outside contract writes: " + ", ".join(outside))

if problems:
    print("merge-ready: ask · " + "; ".join(problems))
    sys.exit(2)
sys.exit(0)
PY
)"
PATH_RC=$?
OWNER="${REPO%%/*}"
NAME="${REPO#*/}"
fetch_paginated_array "repos/${REPO}/rules/branches/${BASE_BRANCH}" "${RULES_RAW}" "${RULES_FILE}" "${RULES_ERR}" "required-check rules"
require_json "${RULES_FILE}"

if ! gh api "repos/${REPO}/branches/${BASE_BRANCH}/protection/required_status_checks" \
    >"${LEGACY_FILE}" 2>"${LEGACY_ERR}"; then
  if grep -Fq "Branch not protected" "${LEGACY_ERR}" && grep -Eq "404|HTTP 404" "${LEGACY_ERR}"; then
    printf '%s' '{"contexts":[],"checks":[]}' >"${LEGACY_FILE}"
  else
    not_ready "could not read legacy required checks for base branch ${BASE_BRANCH} ($(tr '\n' ' ' <"${LEGACY_ERR}"))"
  fi
fi
require_json "${LEGACY_FILE}"

REQUIRED_SUMMARY="$(python3 -I - "${RULES_FILE}" "${LEGACY_FILE}" "${REQUIRED_CONTEXTS_FILE}" "${BASE_BRANCH}" <<'PY'
import json
import sys
from pathlib import Path

rules = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
legacy = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
contexts_file = Path(sys.argv[3])
base_branch = sys.argv[4]
required_contexts = set()
if not isinstance(rules, list):
    raise ValueError("required-check rules response is not a list")
for rule in rules:
    if not isinstance(rule, dict):
        raise ValueError("required-check rules response contains a malformed rule")
    if rule.get("type") != "required_status_checks":
        continue
    parameters = rule.get("parameters")
    if not isinstance(parameters, dict) or not isinstance(parameters.get("required_status_checks"), list):
        raise ValueError("required-check rules response has a malformed required_status_checks rule")
    for required in parameters["required_status_checks"]:
        if not isinstance(required, dict) or not isinstance(required.get("context"), str) or not required["context"]:
            raise ValueError("required-check rules response has a malformed required context")
        required_contexts.add(required["context"])
if not isinstance(legacy, dict):
    raise ValueError("legacy required-check response is not an object")
legacy_contexts = legacy.get("contexts")
legacy_checks = legacy.get("checks")
if legacy_contexts is None and legacy_checks is None:
    raise ValueError("legacy required-check response has no contexts or checks")
if legacy_contexts is not None:
    if not isinstance(legacy_contexts, list) or not all(isinstance(context, str) and context for context in legacy_contexts):
        raise ValueError("legacy required-check response has malformed contexts")
    required_contexts.update(legacy_contexts)
if legacy_checks is not None:
    if not isinstance(legacy_checks, list):
        raise ValueError("legacy required-check response has malformed checks")
    for required in legacy_checks:
        if not isinstance(required, dict) or not isinstance(required.get("context"), str) or not required["context"]:
            raise ValueError("legacy required-check response has a malformed check")
        required_contexts.add(required["context"])
contexts_file.write_text(json.dumps(sorted(required_contexts)), encoding="utf-8")
print(
    f"required checks from base branch {base_branch}: "
    + (", ".join(sorted(required_contexts)) if required_contexts else "none")
)
PY
)" || not_ready "could not parse required-check sources"

if [ "${PATH_RC}" -eq 2 ]; then
  echo "${PATH_VERDICT}; ${REQUIRED_SUMMARY} (head ${HEAD_SHA})"
  exit 2
fi
if [ "${PATH_RC}" -ne 0 ]; then
  if [ -n "${PATH_VERDICT}" ]; then
    not_ready "${PATH_VERDICT}"
  fi
  not_ready "changed paths: could not check the stop-list or contract scope"
fi

if ! gh api graphql \
    -f owner="${OWNER}" -f name="${NAME}" -F number="${PR}" \
    -f query='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){reviewThreads(first:100){nodes{isResolved} pageInfo{hasNextPage}} reviews(first:100){nodes{state submittedAt body commit{oid} author{login __typename} comments(first:100){nodes{databaseId replyTo{databaseId}} pageInfo{hasNextPage}}} pageInfo{hasNextPage}}}}}' \
    >"${GQL_FILE}" 2>"${GQL_ERR}"; then
  not_ready "could not read review threads/reviews ($(tr '\n' ' ' <"${GQL_ERR}"))"
fi
require_json "${GQL_FILE}"

fetch_paginated_array "repos/${REPO}/issues/${PR}/comments" "${COMMENTS_RAW}" "${COMMENTS_FILE}" "${COMMENTS_ERR}" "PR comments"
require_json "${COMMENTS_FILE}"

EXEMPTION_NEEDED="$(python3 -I - "${GQL_FILE}" "${COMMENTS_FILE}" "${BOTS_FILE}" "${HEAD_SHA}" <<'PY'
import json
import sys
from pathlib import Path

gql_file, comments_file, bots_file, head_sha = sys.argv[1:5]
pull_request = (json.loads(Path(gql_file).read_text(encoding="utf-8")).get("data") or {}).get("repository", {}).get("pullRequest")
if not isinstance(pull_request, dict):
    raise ValueError("graphql response missing data.repository.pullRequest")
reviews = pull_request.get("reviews")
if not isinstance(reviews, dict) or not isinstance(reviews.get("nodes"), list):
    raise ValueError("graphql response missing reviews")


def strip_bot_suffix(login):
    return login[:-5] if login.lower().endswith("[bot]") else login


def review_is_standalone(review):
    body = review.get("body")
    if isinstance(body, str) and body.strip():
        return True
    comments = review.get("comments")
    if not isinstance(comments, dict) or not isinstance(comments.get("nodes"), list):
        return False
    page_info = comments.get("pageInfo")
    if not isinstance(page_info, dict) or not isinstance(page_info.get("hasNextPage"), bool):
        raise ValueError("graphql response has malformed review comments pageInfo")
    if page_info["hasNextPage"]:
        return False
    return any(
        isinstance(comment, dict) and comment.get("replyTo") is None
        for comment in comments["nodes"]
    )


head_reviewers = set()
for review in reviews["nodes"]:
    if not isinstance(review, dict):
        raise ValueError("graphql response has a malformed review node")
    author = review.get("author") or {}
    if (
        author.get("__typename") == "Bot"
        and (review.get("commit") or {}).get("oid") == head_sha
        and (review.get("state") or "").upper() != "DISMISSED"
        and review_is_standalone(review)
    ):
        login = strip_bot_suffix(author.get("login", ""))
        if login:
            head_reviewers.add(login)

bot_forms = {}
for raw_line in Path(bots_file).read_text(encoding="utf-8").splitlines():
    line = raw_line.strip()
    if not line or line.startswith("#"):
        continue
    fields = [field.strip() for field in line.split("|")]
    if len(fields) != 3 or not all(fields):
        raise ValueError("bots file has malformed line")
    login, marker, required_line = fields
    if login in bot_forms:
        raise ValueError("bots file has duplicate login")
    bot_forms[login] = None if marker == "none" else (marker, required_line)

comments = json.loads(Path(comments_file).read_text(encoding="utf-8"))
candidate_bots = set()
for comment in comments:
    if not isinstance(comment, dict):
        raise ValueError("PR comments response has a malformed comment")
    user = comment.get("user") or {}
    login = strip_bot_suffix(user.get("login", ""))
    form = bot_forms.get(login)
    if user.get("type") != "Bot" or form is None:
        continue
    marker, required_line = form
    lines = (comment.get("body") or "").splitlines()
    if lines.count(marker) == 1 and required_line in lines and login not in head_reviewers:
        candidate_bots.add(login)

print("yes" if candidate_bots else "no")
PY
)" || not_ready "could not determine whether a rate-limit exemption needs a timestamp"

HEAD_TIME=""
if [ "${EXEMPTION_NEEDED}" = "yes" ]; then
  fetch_paginated_array "repos/${REPO}/issues/${PR}/timeline" "${TIMELINE_RAW}" "${TIMELINE_FILE}" "${TIMELINE_ERR}" "PR timeline"
  python3 -I - "${TIMELINE_FILE}" "${HEAD_SHA}" >"${HEAD_TIME_FILE}" 2>"${HEAD_TIME_ERR}" <<'PY' || not_ready "could not establish a trusted head push time ($(tr '\n' ' ' <"${HEAD_TIME_ERR}"))"
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

events = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
head_sha = sys.argv[2]
if not isinstance(events, list):
    raise ValueError("expected a list of timeline events")
timestamps = []
for event in events:
    if not isinstance(event, dict):
        raise ValueError("timeline response contains a malformed event")
    created_at = event.get("created_at")
    if not isinstance(created_at, str) or not created_at:
        continue
    if (
        event.get("event") == "head_ref_force_pushed"
        and event.get("commit_id") == head_sha
    ) or (
        event.get("event") == "committed"
        and event.get("sha") == head_sha
    ):
        parsed = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            raise ValueError("head push event timestamp has no timezone")
        timestamps.append(parsed.astimezone(timezone.utc))
if not timestamps:
    raise ValueError("PR timeline has no push event for the measured head")
print(min(timestamps).isoformat(timespec="seconds").replace("+00:00", "Z"))
PY
  HEAD_TIME="$(cat "${HEAD_TIME_FILE}")"
  [ -n "${HEAD_TIME}" ] || not_ready "head push time response was empty"
fi

gh api "repos/${REPO}/commits/${HEAD_SHA}/check-runs" --paginate --slurp \
    >"${CHECK_RUNS_RAW}" 2>"${CHECK_RUNS_ERR}" || \
  not_ready "could not read check runs for measured head ${HEAD_SHA} ($(tr '\n' ' ' <"${CHECK_RUNS_ERR}"))"
python3 -I - "${CHECK_RUNS_RAW}" <<'PY' 2>"${CHECK_RUNS_ERR}" || \
  not_ready "check runs for measured head: could not parse response ($(tr '\n' ' ' <"${CHECK_RUNS_ERR}"))"
import json,sys
from pathlib import Path
pages=json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
if not isinstance(pages,list) or not all(isinstance(page,dict) for page in pages):
    raise ValueError("expected a list of check-run response objects")
for page in pages:
    runs=page.get("check_runs")
    if not isinstance(runs,list) or not all(isinstance(run,dict) for run in runs):
        raise ValueError("check-run response is missing a valid check_runs list")
PY

if ! gh pr checks "${PR}" --repo "${REPO}" --required --json name,bucket,state \
    >"${CHECKS_FILE}" 2>"${CHECKS_ERR}"; then
  if ! python3 -I -c 'import json, sys; json.load(open(sys.argv[1], encoding="utf-8"))' \
      "${CHECKS_FILE}" >/dev/null 2>&1; then
    not_ready "could not read required checks (gh pr checks: $(tr '\n' ' ' <"${CHECKS_ERR}"))"
  fi
fi
require_json "${CHECKS_FILE}" nonempty-list

if ! gh pr view "${PR}" --repo "${REPO}" --json number,url,headRefOid,state,isDraft \
    >"${PR_FILE}" 2>"${PR_ERR}"; then
  not_ready "could not read the PR (gh pr view: $(tr '\n' ' ' <"${PR_ERR}"))"
fi
require_json "${PR_FILE}"

python3 -I - "${PR_FILE}" "${CHECKS_FILE}" "${GQL_FILE}" "${FILES_FILE}" "${COMMENTS_FILE}" \
         "${STOP_PATHS_FILE}" "${BOTS_FILE}" "${REQUIRED_CONTEXTS_FILE}" \
         "${BASE_BRANCH}" "${HEAD_SHA}" "${HEAD_TIME}" "${CONTRACT}" <<'PY'
import fnmatch
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

(pr_file, checks_file, gql_file, files_file, comments_file, stop_paths_file,
 bots_file, contexts_file, base_branch, head_sha, head_time, contract_path) = sys.argv[1:13]


def load(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def fail(reason):
    print(f"merge-ready: not ready · {reason}")
    sys.exit(1)


def require_connection(obj, name):
    if (
        not isinstance(obj, dict)
        or not isinstance(obj.get("nodes"), list)
        or not isinstance(obj.get("pageInfo"), dict)
        or not isinstance(obj["pageInfo"].get("hasNextPage"), bool)
    ):
        fail(f"graphql response missing or malformed {name} (nodes/pageInfo)")
    return obj


def strip_bot_suffix(login):
    return login[:-5] if login.lower().endswith("[bot]") else login


def parse_github_timestamp(value):
    if not isinstance(value, str) or not value:
        raise ValueError("missing or empty timestamp")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ValueError(f"invalid timestamp {value!r}") from exc
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise ValueError(f"timestamp has no timezone {value!r}")
    return parsed.astimezone(timezone.utc)


try:
    pr = load(pr_file)
    checks = load(checks_file)
    gql = load(gql_file)
    files = load(files_file)
    comments = load(comments_file)

    if not isinstance(pr, dict) or not isinstance(pr.get("headRefOid"), str):
        fail("PR response missing or malformed headRefOid")
    if not isinstance(pr.get("state"), str) or not isinstance(pr.get("isDraft"), bool):
        fail("PR response missing or malformed state/isDraft")

    if pr.get("headRefOid") != head_sha:
        fail(f"head changed during measurement (started {head_sha[:12]}, now {(pr.get('headRefOid') or '?')[:12]}); rerun")

    changed_paths = sorted(
        {f["filename"] for f in files}
        | {f["previous_filename"] for f in files if f.get("previous_filename")}
    )
    problems_ask = []
    problems_not_ready = []

    required_contexts = set(load(contexts_file))
    try:
        head_time_value = parse_github_timestamp(head_time) if head_time else None
    except ValueError as exc:
        fail(f"head push time is malformed: {exc}")

    if not isinstance(checks, list):
        fail("required checks response is not a list")
    reported_contexts = set()
    for check in checks:
        if not isinstance(check, dict) or not isinstance(check.get("name"), str) or not check["name"]:
            fail("required checks response has a malformed check")
        reported_contexts.add(check["name"])
    missing_required = sorted(required_contexts - reported_contexts)
    if missing_required:
        problems_not_ready.append("missing required checks: " + ", ".join(missing_required))
    required_summary = (
        f"required checks from base branch {base_branch}: "
        + (", ".join(sorted(required_contexts)) if required_contexts else "none")
    )

    if pr.get("state") != "OPEN":
        problems_not_ready.append(f"PR state is {pr.get('state')}, not OPEN")
    if pr.get("isDraft"):
        problems_not_ready.append("PR is a draft")

    failing_checks = [
        f"{c.get('name', 'unknown')}={c.get('state', c.get('bucket', 'unknown'))}"
        for c in checks
        if c.get("bucket") != "pass"
    ]
    if failing_checks:
        problems_not_ready.append("checks: " + ", ".join(failing_checks))

    pull_request = (gql.get("data") or {}).get("repository", {}).get("pullRequest")
    if not isinstance(pull_request, dict):
        fail("graphql response missing data.repository.pullRequest")
    reviews = require_connection(pull_request.get("reviews"), "reviews")
    if reviews["pageInfo"]["hasNextPage"]:
        problems_not_ready.append("more than 100 reviews; rerun with pagination")


    def review_is_standalone(review):
        body = review.get("body")
        if isinstance(body, str) and body.strip():
            return True
        comments = review.get("comments")
        if not isinstance(comments, dict) or not isinstance(comments.get("nodes"), list):
            return False
        page_info = comments.get("pageInfo")
        if not isinstance(page_info, dict) or not isinstance(page_info.get("hasNextPage"), bool):
            fail("graphql response has malformed review comments pageInfo")
        if page_info["hasNextPage"]:
            return False
        return any(
            isinstance(comment, dict) and comment.get("replyTo") is None
            for comment in comments["nodes"]
        )

    decision_states = {"APPROVED", "CHANGES_REQUESTED", "DISMISSED", "PENDING"}
    decision_reviews = {}
    head_bot_reviewer_logins = set()
    for index, node in enumerate(reviews["nodes"]):
        if not isinstance(node, dict):
            fail("graphql response has a malformed review node")
        author = node.get("author") or {}
        if author.get("__typename") != "Bot":
            continue
        login = strip_bot_suffix(author.get("login", ""))
        if (node.get("commit") or {}).get("oid") != head_sha:
            continue
        if not review_is_standalone(node):
            continue
        state = (node.get("state") or "").upper()
        if login and state != "DISMISSED":
            head_bot_reviewer_logins.add(login)
        state = (node.get("state") or "").upper()
        if state in decision_states:
            decision_reviews.setdefault(login or "unknown", []).append(
                (node.get("submittedAt") or "", index, state)
            )

    latest_bot_state = {
        login: max(reviews_for_bot, key=lambda item: (item[0], item[1]))[2]
        for login, reviews_for_bot in decision_reviews.items()
    }

    failing_bots = [
        f"{login}={state.lower()}"
        for login, state in latest_bot_state.items()
        if state in {"PENDING", "CHANGES_REQUESTED"}
    ]
    if failing_bots:
        problems_not_ready.append("review bots: " + ", ".join(failing_bots))

    bot_forms = {}
    for line_number, raw_line in enumerate(
        Path(bots_file).read_text(encoding="utf-8").splitlines(), start=1
    ):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        fields = [field.strip() for field in line.split("|")]
        if len(fields) != 3 or not all(fields):
            fail(
                f"bots file has malformed line {line_number}; expected "
                "login | rate-limit marker | required line"
            )
        login, marker, required_line = fields
        if login in bot_forms:
            fail(f"bots file has duplicate login: {login}")
        if (marker == "none") != (required_line == "none"):
            fail(f"bots file has incomplete rate-limit form for {login}")
        bot_forms[login] = None if marker == "none" else (marker, required_line)

    if not bot_forms:
        fail(f"bots file has no entries: {bots_file}")

    def is_rate_limit_notice(login, body):
        form = bot_forms.get(login)
        if form is None:
            return False
        marker, required_line = form
        lines = body.splitlines()
        return lines.count(marker) == 1 and required_line in lines

    recent_rate_limited_bots = set()
    for comment in comments:
        if not isinstance(comment, dict):
            fail("PR comments response has a malformed comment")
        user = comment.get("user") or {}
        login = strip_bot_suffix(user.get("login", ""))
        if user.get("type") != "Bot" or login not in bot_forms:
            continue
        try:
            comment_time = parse_github_timestamp(comment.get("created_at")) if head_time_value else None
        except ValueError as exc:
            fail(f"PR comment created_at is malformed: {exc}")
        if head_time_value and comment_time >= head_time_value and is_rate_limit_notice(login, comment.get("body") or ""):
            recent_rate_limited_bots.add(login)

    missing_bots = [
        bot for bot in bot_forms
        if bot not in head_bot_reviewer_logins and bot not in recent_rate_limited_bots
    ]
    if missing_bots:
        problems_not_ready.append(
            "bot(s) with no head review or measured rate-limit comment: " + ", ".join(missing_bots)
        )

    threads = require_connection(pull_request.get("reviewThreads"), "reviewThreads")
    if threads["pageInfo"]["hasNextPage"]:
        problems_not_ready.append("more than 100 review threads; rerun with pagination")
    open_threads = sum(
        1 for thread in threads["nodes"]
        if not isinstance(thread, dict) or not thread.get("isResolved", False)
    )
    if open_threads:
        problems_not_ready.append(f"{open_threads} open review thread(s)")

    def matches_stop(path, entry):
        if entry.endswith("/"):
            return path == entry.rstrip("/") or path.startswith(entry)
        if any(char in entry for char in "*?["):
            return fnmatch.fnmatch(path, entry)
        return path == entry

    stop_entries = [
        line.strip() for line in Path(stop_paths_file).read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    if not stop_entries:
        fail(f"stop-paths file has no entries: {stop_paths_file}")
    stop_hits = [path for path in changed_paths if any(matches_stop(path, entry) for entry in stop_entries)]
    if stop_hits:
        problems_ask.append(
            f"{len(stop_hits)} stop-list path(s): " + ", ".join(f"{path} (stop-list)" for path in stop_hits)
        )

    if contract_path:
        text = Path(contract_path).read_text(encoding="utf-8")
        front_matter_match = re.match(r"^---\n(.*?\n)---", text, re.DOTALL)
        front_matter = front_matter_match.group(1) if front_matter_match else ""
        globs = None
        for front_matter_line in front_matter.splitlines():
            key, separator, raw_value = front_matter_line.partition(":")
            if separator and key.strip() == "writes":
                raw_value = raw_value.strip()
                if raw_value.startswith("[") and raw_value.endswith("]"):
                    inner = raw_value[1:-1].strip()
                    globs = [glob.strip() for glob in inner.split(",") if glob.strip()] if inner else []
                break
        if globs is None:
            problems_not_ready.append("contract front matter has no writes: list; cannot verify scope")
        else:
            outside = [path for path in changed_paths if not any(fnmatch.fnmatch(path, glob) for glob in globs)]
            if outside:
                problems_ask.append("path(s) outside contract writes: " + ", ".join(outside))

    if problems_ask:
        print(f"merge-ready: ask · {'; '.join(problems_ask + problems_not_ready + [required_summary])} (head {head_sha})")
        sys.exit(2)
    if problems_not_ready:
        print("merge-ready: not ready · " + "; ".join(problems_not_ready + [required_summary]))
        sys.exit(1)
    scope_summary = "contract scope check passed" if contract_path else "contract scope check skipped (no --contract)"
    print(f"merge-ready: merge · {required_summary}; {scope_summary}; every GitHub-state measurement passed (head {head_sha})")
    sys.exit(0)
except SystemExit:
    raise
except Exception as exc:
    fail(f"internal error: {exc}")
