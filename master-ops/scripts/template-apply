#!/usr/bin/env python3
"""Apply template-layer files onto an ops install, gated by the template manifest.

Always dry-runs first: prints the exact file list and the reason for each entry.
A write pass requires an interactive confirmation phrase. There is no --yes.

Instance-owned paths are refused by name. The list comes from the template
manifest's `instance_owned` key; a manifest written before that key existed
falls back to the built-in list in template_common.py (see
template_manifest.py). Anything the manifest does not claim is refused too.

Per-file outcomes:
  planned | written
  skipped-as-instance-owned
  skipped-as-retired
  refused-not-in-manifest
  error-invalid-path
  error-missing-template-file

Multi-file apply is preflighted then written file-by-file with per-file atomic
replace. A mid-batch OS error can leave earlier files written; re-run after fix.
"""

from __future__ import annotations

import argparse
import json
import os
import secrets
import stat
import sys
import tempfile
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
if str(_SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(_SCRIPT_DIR))
from template_common import (  # noqa: E402
    PLACEHOLDERS,
    SKIP_SUBSTITUTE_PATHS,
    TEMPLATE_RETIREMENTS_REL,
    load_template_retirements,
    normalize_template_rel,
    resolve_template_version,
    template_version_is_valid,
)
from template_manifest import instance_owned_predicate  # noqa: E402

CONFIRM_PHRASE = "apply"

# These two files are instance-owned after creation, but a pre-existing
# install still needs a safe first copy so merge-ready can run. They are kept
# outside MANIFEST.json's broad config/ exclusion and are planned only when
# the destination is absent.
INSTANCE_OWNED_SEED_FILES = (
    "config/merge-ready-stop-paths.txt",
    "config/merge-ready-bots.txt",
)


normalize_rel = normalize_template_rel


def resolved_under(root: Path, rel: str) -> Path | None:
    """Resolve root/rel and require the result to stay under root."""
    try:
        root_res = root.resolve()
        candidate = (root_res / rel).resolve()
        candidate.relative_to(root_res)
    except (OSError, ValueError, RuntimeError):
        # Symlink loops and unreadable parents become invalid-path, not a crash.
        return None
    return candidate


def effective_rel_under(root: Path, path: Path) -> str | None:
    """Relative posix path of a resolved path under root, or None if outside."""
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except (OSError, ValueError, RuntimeError):
        return None


def roots_overlap(first: Path, second: Path) -> bool:
    first_resolved = first.resolve()
    second_resolved = second.resolve()
    try:
        first_resolved.relative_to(second_resolved)
        return True
    except ValueError:
        pass
    try:
        second_resolved.relative_to(first_resolved)
        return True
    except ValueError:
        return False


def _secure_seed_publish_supported() -> bool:
    """Whether this Python exposes the directory-descriptor primitives used
    to keep seed publication inside the already-validated operations tree."""
    return (
        getattr(os, "O_DIRECTORY", None) is not None
        and getattr(os, "O_NOFOLLOW", None) is not None
        and all(
            function in os.supports_dir_fd
            for function in (os.open, os.link, os.unlink, os.stat)
        )
        and os.link in os.supports_follow_symlinks
    )


def _open_seed_parent_fd(ops_root: Path, rel: str) -> tuple[int, Path]:
    """Open a seed's parent through no-follow directory descriptors.

    The returned descriptor pins every parent directory while the caller
    publishes the seed. A path-based write could follow a parent directory
    replaced by a symlink after planning; descriptor-relative operations do
    not leave the validated operations tree in that race.
    """
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    root = ops_root.resolve()
    fd = os.open(root, flags)
    parent = root
    try:
        for component in Path(rel).parent.parts:
            try:
                next_fd = os.open(component, flags, dir_fd=fd)
            except FileNotFoundError:
                # Create missing parents relative to the pinned descriptor.
                # A concurrent symlink is rejected by the no-follow open below.
                try:
                    os.mkdir(component, 0o755, dir_fd=fd)
                except FileExistsError:
                    pass
                next_fd = os.open(component, flags, dir_fd=fd)
            os.close(fd)
            fd = next_fd
            parent = parent / component
        return fd, parent
    except Exception:
        os.close(fd)
        raise


def _open_seed_temp(parent_fd: int, mode: int) -> tuple[int, str]:
    """Create a private temporary file in an already-open seed directory."""
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    for _ in range(128):
        name = f".template-apply-{os.getpid()}-{secrets.token_hex(8)}"
        try:
            return os.open(name, flags, mode, dir_fd=parent_fd), name
        except FileExistsError:
            continue
    raise FileExistsError("could not allocate a temporary seed file")


def _same_directory(path: Path, fd: int) -> bool:
    """Check that a path still names the directory pinned by fd."""
    try:
        path_stat = os.stat(path, follow_symlinks=False)
        fd_stat = os.fstat(fd)
    except OSError:
        return False
    return (
        stat.S_ISDIR(path_stat.st_mode)
        and path_stat.st_dev == fd_stat.st_dev
        and path_stat.st_ino == fd_stat.st_ino
    )


def _publish_seed_with_directory_fd(
    payload: bytes,
    ops_root: Path,
    rel: str,
    mode: int,
) -> bool:
    """Atomically create a seed relative to no-follow parent descriptors.

    Return True when the seed was written and False when a concurrent regular
    file won the create-only race. The parent identity is checked before and
    after publication so a replaced directory fails closed instead of
    reporting a write to a detached directory.
    """
    parent_fd, parent = _open_seed_parent_fd(ops_root, rel)
    temp_name = ""
    try:
        if not _same_directory(parent, parent_fd):
            raise RuntimeError(f"seed destination parent changed: {rel}")
        temp_fd, temp_name = _open_seed_temp(parent_fd, mode)
        try:
            with os.fdopen(temp_fd, "wb") as tmp:
                tmp.write(payload)
                tmp.flush()
                os.fchmod(tmp.fileno(), mode)
            try:
                os.link(
                    temp_name,
                    Path(rel).name,
                    src_dir_fd=parent_fd,
                    dst_dir_fd=parent_fd,
                    follow_symlinks=False,
                )
            except FileExistsError:
                existing = os.stat(
                    Path(rel).name,
                    dir_fd=parent_fd,
                    follow_symlinks=False,
                )
                if not stat.S_ISREG(existing.st_mode):
                    raise RuntimeError(f"destination is not a regular file: {rel}")
                if not _same_directory(parent, parent_fd):
                    raise RuntimeError(f"seed destination parent changed: {rel}")
                return False
            os.unlink(temp_name, dir_fd=parent_fd)
            temp_name = ""
            if not _same_directory(parent, parent_fd):
                raise RuntimeError(f"seed destination parent changed: {rel}")
            return True
        finally:
            if temp_name:
                try:
                    os.unlink(temp_name, dir_fd=parent_fd)
                except OSError:
                    pass
    finally:
        os.close(parent_fd)


def load_manifest(path: Path) -> dict:
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict) or not isinstance(data.get("files"), list):
        raise ValueError("manifest missing files list")
    instance_owned_predicate(data)  # raises ValueError on a malformed key
    return data


def resolve_template_root(template: Path) -> Path:
    path = template.resolve()
    if (path / "MANIFEST.json").is_file():
        return path
    nested = path / "master-ops"
    if (nested / "MANIFEST.json").is_file():
        return nested
    raise FileNotFoundError(f"no MANIFEST.json under {template}")


def substitute(text: str, values: dict[str, str]) -> str:
    out = text
    for key in PLACEHOLDERS:
        name = key[2:-2]
        if key in out and name in values:
            out = out.replace(key, values[name])
    return out


def missing_placeholders(
    template_root: Path,
    actions: list[dict],
    values: dict[str, str],
) -> dict[str, list[str]]:
    """Per documented key, the relative paths of planned files whose
    substituted text still carries that token: the gap is read from the
    rendered text, since a supplied value can itself hold an unsubstituted
    key's placeholder and `substitute()` leaves that in place. Skipped,
    refused, and error entries are not read; a skip-substitute path is never
    read for tokens either, since it is copied byte-for-byte and never
    substituted."""
    found: dict[str, list[str]] = {}
    for item in actions:
        if item["action"] != "planned":
            continue
        rel = item["path"]
        if rel in SKIP_SUBSTITUTE_PATHS:
            continue
        src = resolved_under(template_root, rel)
        if src is None or not src.is_file():
            continue
        rendered = substitute(src.read_text(encoding="utf-8"), values)
        for key in PLACEHOLDERS:
            if key in rendered:
                found.setdefault(key[2:-2], []).append(rel)
    return {key[2:-2]: found[key[2:-2]] for key in PLACEHOLDERS if key[2:-2] in found}


def format_missing(missing: dict[str, list[str]]) -> str:
    lines = ["missing placeholders (write refused):"]
    for name, paths in missing.items():
        lines.append(f"  {name}: {', '.join(paths)}")
    return "\n".join(lines) + "\n"


def plan_actions(
    template_root: Path,
    ops_root: Path,
    manifest: dict,
    extra_targets: list[str] | None,
    retirement_paths: set[str] | None = None,
) -> list[dict]:
    """Build the per-path plan. extra_targets are attempted writes outside the
    manifest — used only to prove refusal in tests; normal runs pass None."""
    claimed_raw = list(manifest["files"])
    is_instance_owned, source = instance_owned_predicate(manifest)
    actions: list[dict] = []
    claimed: set[str] = set()

    # Sort only string entries so non-strings still appear as plan errors.
    sortable = [p for p in claimed_raw if isinstance(p, str)]
    non_strings = [p for p in claimed_raw if not isinstance(p, str)]
    for raw in non_strings:
        actions.append(
            {
                "path": repr(raw),
                "action": "error-invalid-path",
                "reason": "manifest entry is not a string path",
            }
        )

    for raw in sorted(sortable):
        rel = normalize_rel(raw)
        if rel is None:
            actions.append(
                {
                    "path": raw,
                    "action": "error-invalid-path",
                    "reason": "manifest entry is not a safe relative path",
                }
            )
            continue
        claimed.add(rel)
        if is_instance_owned(rel):
            actions.append(
                {
                    "path": rel,
                    "action": "skipped-as-instance-owned",
                    "reason": f"instance-owned by name ({source})",
                }
            )
            continue
        if retirement_paths and rel in retirement_paths:
            actions.append(
                {
                    "path": rel,
                    "action": "skipped-as-retired",
                    "reason": (
                        "retired by the install record "
                        f"({TEMPLATE_RETIREMENTS_REL.as_posix()})"
                    ),
                }
            )
            continue
        src = resolved_under(template_root, rel)
        dest = resolved_under(ops_root, rel)
        if src is None or dest is None:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "resolved path escapes template or ops root",
                }
            )
            continue
        # Always evaluate the resolved destination (including dangling
        # in-root symlinks) for escape and instance-owned targets.
        effective = effective_rel_under(ops_root, dest)
        if effective is None:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "destination resolves outside ops root",
                }
            )
            continue
        lexical_dest = ops_root.resolve() / rel
        if lexical_dest.is_symlink() or lexical_dest != dest:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "destination path resolves through a symlink",
                }
            )
            continue
        if lexical_dest.exists() and not lexical_dest.is_file():
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "destination exists but is not a regular file",
                }
            )
            continue
        if is_instance_owned(effective):
            actions.append(
                {
                    "path": rel,
                    "action": "skipped-as-instance-owned",
                    "reason": (
                        f"destination resolves to instance-owned path {effective} ({source})"
                    ),
                }
            )
            continue
        if not src.is_file():
            actions.append(
                {
                    "path": rel,
                    "action": "error-missing-template-file",
                    "reason": "listed in manifest but missing from template tree",
                }
            )
            continue
        if dest.is_file():
            reason = "template-layer path; would overwrite existing file"
        else:
            reason = "template-layer path; would create missing file"
        actions.append(
            {
                "path": rel,
                "action": "planned",
                "reason": reason,
            }
        )

    for rel in INSTANCE_OWNED_SEED_FILES:
        src = resolved_under(template_root, rel)
        dest = resolved_under(ops_root, rel)
        lexical_src = template_root.resolve() / rel
        if dest is None:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "seed destination escapes ops root or resolves through a symlink loop",
                    "seed": True,
                }
            )
            continue
        effective = effective_rel_under(ops_root, dest)
        lexical_dest = ops_root.resolve() / rel
        if effective is None or lexical_dest.is_symlink() or lexical_dest != dest:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "seed destination resolves through a symlink or outside ops root",
                    "seed": True,
                }
            )
            continue
        if lexical_dest.exists() and not lexical_dest.is_file():
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "seed destination exists but is not a regular file",
                    "seed": True,
                }
            )
            continue
        if src is None:
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "seed path escapes template root or resolves through a symlink loop",
                    "seed": True,
                }
            )
            continue
        if lexical_src.is_symlink() and not lexical_src.exists():
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "seed source is a dangling symlink",
                    "seed": True,
                }
            )
            continue
        if not lexical_src.exists():
            # Scratch templates and older template versions do not carry
            # these optional seeds; a genuinely absent source remains omitted.
            continue
        if not src.is_file():
            actions.append(
                {
                    "path": rel,
                    "action": "error-invalid-path",
                    "reason": "seed source exists but is not a regular file",
                    "seed": True,
                }
            )
            continue
        if lexical_dest.exists():
            actions.append(
                {
                    "path": rel,
                    "action": "skipped-as-instance-owned",
                    "reason": "instance-owned seed; existing file preserved",
                    "seed": True,
                }
            )
            continue
        if not src.is_file():
            actions.append(
                {
                    "path": rel,
                    "action": "error-missing-template-file",
                    "reason": "instance-owned seed is missing from the template tree",
                    "seed": True,
                }
            )
            continue
        actions.append(
            {
                "path": rel,
                "action": "planned",
                "reason": "instance-owned seed; create only when absent",
                "seed": True,
            }
        )

    for raw in extra_targets or []:
        rel = normalize_rel(raw) or raw
        if is_instance_owned(rel if isinstance(rel, str) else raw):
            actions.append(
                {
                    "path": rel,
                    "action": "skipped-as-instance-owned",
                    "reason": f"instance-owned by name ({source})",
                }
            )
        elif rel not in claimed:
            actions.append(
                {
                    "path": rel,
                    "action": "refused-not-in-manifest",
                    "reason": "manifest does not claim this path",
                }
            )
        # If it is claimed, it already appears above.
    return actions


def plan_has_errors(actions: list[dict]) -> bool:
    return any(a["action"].startswith("error-") for a in actions)


def apply_planned(
    template_root: Path,
    ops_root: Path,
    actions: list[dict],
    values: dict[str, str],
    manifest: dict | None = None,
    retirements_path: Path | None = None,
) -> list[dict]:
    is_instance_owned, _ = instance_owned_predicate(manifest)
    retirement_path = retirements_path or (ops_root / TEMPLATE_RETIREMENTS_REL)
    retirement_entries, retirement_status = load_template_retirements(retirement_path)
    if retirement_status == "malformed":
        raise RuntimeError(
            f"retirements file is malformed or unreadable: {retirement_path}"
        )
    retirement_paths = {normalize_rel(entry["path"]) for entry in retirement_entries}
    retirement_paths.discard(None)
    seed_paths = {item["path"] for item in actions if item.get("seed")}
    # Preflight every planned source before the first write so a missing file
    # mid-pass does not leave a half-applied install.
    planned = [
        a
        for a in actions
        if a["action"] == "planned" and a["path"] not in retirement_paths
    ]
    for item in planned:
        src = resolved_under(template_root, item["path"])
        resolved_dest = resolved_under(ops_root, item["path"])
        lexical_dest = ops_root.resolve() / item["path"]
        if (
            src is None
            or resolved_dest is None
            or lexical_dest.is_symlink()
            or lexical_dest != resolved_dest
            or (lexical_dest.exists() and not lexical_dest.is_file())
            or not src.is_file()
        ):
            raise RuntimeError(f"preflight failed for {item['path']}")

    results: list[dict] = []
    for item in actions:
        rel = item["path"]
        if item["action"] == "planned" and rel in retirement_paths:
            results.append(
                {
                    "path": rel,
                    "action": "skipped-as-retired",
                    "reason": (
                        "retired by the install record "
                        f"({TEMPLATE_RETIREMENTS_REL.as_posix()})"
                    ),
                }
            )
            continue
        if item["action"] != "planned":
            results.append(
                {
                    "path": rel,
                    "action": item["action"],
                    "reason": item["reason"],
                }
            )
            continue
        src = resolved_under(template_root, rel)
        dest = ops_root.resolve() / rel
        resolved_dest = resolved_under(ops_root, rel)
        if src is None or resolved_dest is None:
            raise RuntimeError(f"path escaped root during write: {rel}")
        if dest.is_symlink() or dest != resolved_dest or (dest.exists() and not dest.is_file()):
            raise RuntimeError(f"destination is not a regular file: {rel}")
        if rel in seed_paths and dest.exists():
            results.append(
                {
                    "path": rel,
                    "action": "skipped-as-instance-owned",
                    "reason": "instance-owned seed appeared after planning; existing file preserved",
                }
            )
            continue
        # Re-check resolved destination after confirmation (unconditional).
        effective = effective_rel_under(ops_root, resolved_dest)
        if effective is None or (is_instance_owned(effective) and rel not in seed_paths):
            raise RuntimeError(
                f"destination became instance-owned or escaped before write: {rel}"
            )
        skip_substitute = rel in SKIP_SUBSTITUTE_PATHS
        if skip_substitute:
            payload = src.read_bytes()
        else:
            payload = substitute(src.read_text(encoding="utf-8"), values).encode("utf-8")
        if rel == "MANIFEST.json" and "TEMPLATE_VERSION" in values:
            try:
                manifest_payload = json.loads(payload.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise RuntimeError(f"manifest source is not valid JSON: {exc}") from exc
            if not isinstance(manifest_payload, dict):
                raise RuntimeError("manifest source root is not an object")
            manifest_payload["template_version"] = values["TEMPLATE_VERSION"]
            payload = (json.dumps(manifest_payload, indent=2) + "\n").encode("utf-8")
        # Publish through a temporary file in the destination directory so a
        # crash mid-write does not leave a truncated target. Seed files use a
        # hard link for atomic create-only publication, while ordinary files
        # retain replacement semantics.
        if dest.exists() and not dest.is_symlink():
            mode = dest.stat().st_mode & 0o777
        else:
            mode = src.stat().st_mode & 0o777
        if rel in seed_paths and _secure_seed_publish_supported():
            if _publish_seed_with_directory_fd(payload, ops_root, rel, mode):
                results.append(
                    {
                        "path": rel,
                        "action": "written",
                        "reason": item["reason"],
                    }
                )
            else:
                results.append(
                    {
                        "path": rel,
                        "action": "skipped-as-instance-owned",
                        "reason": "instance-owned seed appeared during write; existing file preserved",
                    }
                )
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp_name = tempfile.mkstemp(
            prefix=".template-apply-",
            dir=str(dest.parent),
        )
        try:
            with os.fdopen(fd, "wb") as tmp:
                tmp.write(payload)
            os.chmod(tmp_name, mode)
            if rel in seed_paths:
                try:
                    os.link(tmp_name, dest)
                except FileExistsError:
                    if dest.is_symlink() or not dest.is_file():
                        raise RuntimeError(f"destination is not a regular file: {rel}")
                    results.append(
                        {
                            "path": rel,
                            "action": "skipped-as-instance-owned",
                            "reason": "instance-owned seed appeared during write; existing file preserved",
                        }
                    )
                else:
                    os.unlink(tmp_name)
                    tmp_name = ""
                    results.append(
                        {
                            "path": rel,
                            "action": "written",
                            "reason": item["reason"],
                        }
                    )
            else:
                os.replace(tmp_name, dest)
                tmp_name = ""
                results.append(
                    {
                        "path": rel,
                        "action": "written",
                        "reason": item["reason"],
                    }
                )
        except Exception:
            raise
        finally:
            if tmp_name:
                try:
                    os.unlink(tmp_name)
                except OSError:
                    pass
    return results


def format_plan(actions: list[dict]) -> str:
    lines = ["dry-run plan (no writes):", f"entries: {len(actions)}"]
    for item in actions:
        lines.append(f"  {item['action']}: {item['path']} — {item['reason']}")
    return "\n".join(lines) + "\n"


def parse_placeholder_args(items: list[str] | None) -> dict[str, str]:
    values: dict[str, str] = {}
    for item in items or []:
        if "=" not in item:
            raise SystemExit(f"template-apply: expected KEY=VALUE, got {item!r}")
        key, value = item.split("=", 1)
        key = key.strip()
        if "{" * 2 + key + "}" * 2 not in PLACEHOLDERS:
            raise SystemExit(
                f"template-apply: unknown placeholder {key!r}; "
                f"allowed: {', '.join(p[2:-2] for p in PLACEHOLDERS)}"
            )
        values[key] = value
    return values


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--ops",
        type=Path,
        required=True,
        help="Target ops repository root",
    )
    parser.add_argument(
        "--template",
        type=Path,
        required=True,
        help="Template master-ops path or ADE clone root",
    )
    parser.add_argument(
        "--placeholder",
        action="append",
        default=[],
        help="KEY=VALUE for documented placeholders (repeatable)",
    )
    parser.add_argument(
        "--write",
        action="store_true",
        help="After printing the plan, prompt for confirmation and write",
    )
    parser.add_argument(
        "--attempt",
        action="append",
        default=[],
        help=argparse.SUPPRESS,  # test-only: attempt a path to prove refusal
    )
    parser.add_argument(
        "--confirm-input",
        default=None,
        help=argparse.SUPPRESS,  # test-only: feed confirmation without a TTY
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    ops_root = args.ops.resolve()
    if not ops_root.is_dir():
        sys.stderr.write(f"template-apply: ops root not a directory: {ops_root}\n")
        return 2

    try:
        template_root = resolve_template_root(args.template)
    except FileNotFoundError as exc:
        sys.stderr.write(f"template-apply: {exc}\n")
        return 2

    if roots_overlap(template_root, ops_root):
        sys.stderr.write(
            "template-apply: template and ops roots must be distinct and non-overlapping\n"
        )
        return 2

    try:
        manifest = load_manifest(template_root / "MANIFEST.json")
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        sys.stderr.write(f"template-apply: cannot read template manifest: {exc}\n")
        return 2

    retirements_path = ops_root / TEMPLATE_RETIREMENTS_REL
    retirement_entries, retirement_status = load_template_retirements(retirements_path)
    retirement_paths = (
        {normalize_rel(entry["path"]) for entry in retirement_entries}
        if retirement_status == "ok"
        else set()
    )
    retirement_paths.discard(None)

    try:
        values = parse_placeholder_args(args.placeholder)
    except SystemExit as exc:
        return int(exc.code) if isinstance(exc.code, int) else 2

    # Default TEMPLATE_VERSION from the template when not supplied.
    if "TEMPLATE_VERSION" not in values:
        version_file = template_root / "TEMPLATE-VERSION"
        if version_file.is_file():
            try:
                plain_version = version_file.read_text(encoding="utf-8").strip()
            except (OSError, UnicodeDecodeError) as exc:
                sys.stderr.write(f"template-apply: cannot read template version: {exc}\n")
                return 2
            if not plain_version or not template_version_is_valid(plain_version):
                sys.stderr.write(
                    "template-apply: TEMPLATE-VERSION has unsupported stamp form\n"
                )
                return 2
            values["TEMPLATE_VERSION"], warning = resolve_template_version(
                template_root, plain_version
            )
            if warning:
                sys.stderr.write(f"template-apply: warning: {warning}\n")

    actions = plan_actions(
        template_root,
        ops_root,
        manifest,
        args.attempt,
        retirement_paths,
    )

    try:
        missing = missing_placeholders(template_root, actions, values)
    except (OSError, UnicodeDecodeError) as exc:
        sys.stderr.write(f"template-apply: cannot read template source: {exc}\n")
        return 2
    missing_text = format_missing(missing) if missing else ""

    # Always surface the plan before any write. Human mode prints it on stdout;
    # JSON mode keeps stdout machine-readable and puts the plan on stderr when
    # a write pass will follow.
    plan_text = format_plan(actions)
    if args.json:
        if not args.write:
            payload = {"phase": "dry-run", "actions": actions, "missing_placeholders": missing}
            json.dump(payload, sys.stdout, indent=2)
            sys.stdout.write("\n")
        else:
            sys.stderr.write(plan_text)
            if missing:
                sys.stderr.write(missing_text)
    else:
        sys.stdout.write(plan_text)
        if missing:
            if args.write:
                sys.stderr.write(missing_text)
            else:
                sys.stdout.write(missing_text)

    if plan_has_errors(actions):
        # Missing or invalid manifest entries are apply errors, not a clean plan.
        return 1

    refused = [
        a
        for a in actions
        if a["action"]
        in (
            "skipped-as-instance-owned",
            "refused-not-in-manifest",
        )
        and a["path"] in set(args.attempt)
    ]
    if args.attempt and refused and not args.write:
        # Attempt-only dry-run that includes a refused path: exit 1 so tests
        # can assert the refusal status as a number.
        return 1

    if missing:
        # A write that would ship unsubstituted placeholders is the same
        # could-not-decide status template-check already uses: exit 2, and no
        # write happens, not even the confirmation prompt.
        return 2

    if args.write and retirement_status == "malformed":
        sys.stderr.write(
            "template-apply: write refused because retirements file is malformed "
            f"or unreadable: {retirements_path}\n"
        )
        return 2

    if not args.write:
        return 0

    # Interactive confirmation — no --yes. Prompt on stderr so --json stdout
    # stays machine-readable.
    prompt = (
        f"Type {CONFIRM_PHRASE!r} to write template-layer files "
        f"into {ops_root}: "
    )
    if args.confirm_input is not None:
        answer = args.confirm_input
    else:
        try:
            sys.stderr.write(prompt)
            sys.stderr.flush()
            answer = sys.stdin.readline()
            if answer == "":
                raise EOFError
        except EOFError:
            sys.stderr.write("template-apply: no confirmation (EOF); aborting\n")
            return 2
    if answer.strip() != CONFIRM_PHRASE:
        sys.stderr.write("template-apply: confirmation declined; no writes\n")
        return 2

    try:
        results = apply_planned(
            template_root,
            ops_root,
            actions,
            values,
            manifest,
            retirements_path,
        )
    except (OSError, RuntimeError, UnicodeDecodeError) as exc:
        sys.stderr.write(f"template-apply: write aborted: {exc}\n")
        return 2
    if args.json:
        json.dump({"phase": "write", "actions": results}, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        sys.stdout.write("write results:\n")
        for item in results:
            sys.stdout.write(
                f"  {item['action']}: {item['path']} — {item['reason']}\n"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
