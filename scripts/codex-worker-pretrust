#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s <worktree-path> [--accounts-dir <dir>]\n' "${0##*/}" >&2
}

if [[ $# -ne 1 && $# -ne 3 ]]; then
  usage
  exit 2
fi

worktree_path=$1
if [[ "$worktree_path" != /* ]]; then
  printf 'ERROR worktree path must be absolute: %s\n' "$worktree_path" >&2
  usage
  exit 2
fi

if [[ $# -eq 3 ]]; then
  if [[ "$2" != "--accounts-dir" || -z "$3" ]]; then
    usage
    exit 2
  fi
  accounts_dir=$3
elif [[ -n "${CODEX_ACCOUNTS_DIR:-}" ]]; then
  accounts_dir=$CODEX_ACCOUNTS_DIR
else
  case "$(uname -s 2>/dev/null || printf unknown)" in
    Darwin)
      accounts_dir="$HOME/Library/Application Support/orca/codex-accounts"
      ;;
    *)
      accounts_dir="$HOME/.local/share/orca/codex-accounts"
      ;;
  esac
fi

if [[ ! -d "$accounts_dir" ]]; then
  printf 'INFO accounts directory not found: %s; nothing to pre-trust\n' "$accounts_dir"
  printf 'Summary: 0 added, 0 updated, 0 already trusted\n'
  exit 0
fi

# TOML basic strings escape backslashes and double quotes. Worktree paths with
# line breaks cannot be represented safely as a single-line table name.
if [[ "$worktree_path" == *$'\n'* || "$worktree_path" == *$'\r'* ]]; then
  printf 'ERROR worktree path must not contain a line break\n' >&2
  exit 2
fi
escaped_path=${worktree_path//\\/\\\\}
escaped_path=${escaped_path//\"/\\\"}
project_header="[projects.\"$escaped_path\"]"

shopt -s nullglob
config_files=("$accounts_dir"/*/home/config.toml)
added=0
updated=0
already_trusted=0

for config_file in "${config_files[@]}"; do
  status=$(
    python3 - "$config_file" "$project_header" <<'PY'
import re
import sys
from pathlib import Path


config_path = Path(sys.argv[1])
project_header = sys.argv[2].encode("utf-8")
lines = config_path.read_bytes().splitlines(keepends=True)


def split_ending(line: bytes) -> tuple[bytes, bytes]:
    if line.endswith(b"\r\n"):
        return line[:-2], b"\r\n"
    if line.endswith(b"\n"):
        return line[:-1], b"\n"
    return line, b""


header_index = next(
    (
        index
        for index, line in enumerate(lines)
        if split_ending(line)[0] == project_header
    ),
    None,
)
if header_index is None:
    print("missing")
    raise SystemExit(0)

table_end = len(lines)
for index in range(header_index + 1, len(lines)):
    content, _ = split_ending(lines[index])
    if content.lstrip(b" \t").startswith(b"["):
        table_end = index
        break

assignment_pattern = re.compile(rb"^[ \t]*trust_level[ \t]*=")
trusted_pattern = re.compile(
    rb'''^[ \t]*trust_level[ \t]*=[ \t]*(?:"trusted"|'trusted')[ \t]*(?:#.*)?$'''
)
for index in range(header_index + 1, table_end):
    content, ending = split_ending(lines[index])
    if not assignment_pattern.match(content):
        continue
    if trusted_pattern.fullmatch(content):
        print("already")
        raise SystemExit(0)
    indentation = content[: len(content) - len(content.lstrip(b" \t"))]
    lines[index] = indentation + b'trust_level = "trusted"' + ending
    config_path.write_bytes(b"".join(lines))
    print("updated")
    raise SystemExit(0)

header_content, header_ending = split_ending(lines[header_index])
newline = header_ending or next(
    (ending for line in lines if (ending := split_ending(line)[1])),
    b"\n",
)
if not header_ending:
    lines[header_index] = header_content + newline
lines.insert(header_index + 1, b'trust_level = "trusted"' + newline)
config_path.write_bytes(b"".join(lines))
print("updated")
PY
  )

  case "$status" in
    already)
      printf '%s: already trusted\n' "$config_file"
      already_trusted=$((already_trusted + 1))
      ;;
    updated)
      printf '%s: trusted (updated)\n' "$config_file"
      updated=$((updated + 1))
      ;;
    missing)
      printf '\n%s\ntrust_level = "trusted"\n' "$project_header" >> "$config_file"
      printf '%s: trusted (added)\n' "$config_file"
      added=$((added + 1))
      ;;
    *)
      printf 'ERROR unexpected pre-trust status for %s: %s\n' "$config_file" "$status" >&2
      exit 2
      ;;
  esac
done

printf 'Summary: %d added, %d updated, %d already trusted\n' \
  "$added" "$updated" "$already_trusted"
