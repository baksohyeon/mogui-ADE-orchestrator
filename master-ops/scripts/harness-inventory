#!/usr/bin/env python3
"""Rank every harness part by its estimated token cost per run.

A part is anything docs/charter/11-earn-its-place.md says must earn its
place: a card, a skill, a hook, a memory file, or a dispatch artifact. The
The ledgers at docs/evals/evidence.json and the optional
docs/evals/evidence.instance.json declare which parts exist and what is known
about each one; this script sizes a part from the ledger's own `key`
rather than searching for it, so it never walks the filesystem looking for
parts to size. `--check` is the exception: it globs `skills/*/SKILL.md`,
`scripts/hooks/*.sh`, and `docs/charter/*.md`, and looks for the two fixed
paths `workspace-card/AGENTS.md` and `AGENTS.md`, only to confirm each one
on disk has a matching ledger row. See docs/evals/README.md for the
ledger's field shapes.

Token estimate for a part sized from disk: ascii_bytes / 4 + non_ascii_chars
/ 1.5, as an integer. This is a rough proxy (about +/-40%), not a tokenizer
call, so it ranks parts against each other rather than pricing a budget
exactly. A hook or a dispatch artifact is executed, not read into a model's
context, so its own file size is not a load; those two kinds print `exec`
instead of an estimate, unless the ledger row carries `measured_tokens` (for
example a hook's stdout at a given event, which is a real context load and
cannot be sized from disk either way). `exec` and `absent` rows rank after
every sized row, in ledger order. A `measured_tokens` value is used verbatim
and marked with `*` in the table, regardless of kind.

Usage:

    scripts/harness-inventory [--root <install root>] [--ledger <path>]
    scripts/harness-inventory --check
    scripts/harness-inventory --json

Default root: this script lives at <root>/scripts/harness-inventory, so the
default is its own grandparent directory. Default ledgers:
<root>/docs/evals/evidence.json and the optional
<root>/docs/evals/evidence.instance.json.
"""

from __future__ import annotations

import argparse
import json
import math
import re
import sys
from pathlib import Path
from pathlib import PurePosixPath

STATUS_VALUES = frozenset({"helps", "no-effect", "hurts", "untested", "safety"})
LOADS_VALUES = frozenset({"every session", "every prompt", "every use", "every dispatch"})
KIND_VALUES = frozenset({"card", "skill", "hook", "memory", "dispatch", "shared"})
EXEC_KINDS = frozenset({"hook", "dispatch"})
MEASURE_BY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
FIXED_CARD_PATHS = ("workspace-card/AGENTS.md", "AGENTS.md")
TEMPLATE_LEDGER_RELATIVE = Path("docs/evals/evidence.json")
INSTANCE_LEDGER_RELATIVE = Path("docs/evals/evidence.instance.json")


class LedgerError(Exception):
    """A malformed ledger; the caller turns this into exit 2."""


def default_root(script_path: Path) -> Path:
    return script_path.resolve().parent.parent


def estimate_tokens(path: Path) -> int:
    data = path.read_bytes()
    text = data.decode("utf-8", errors="replace")
    ascii_bytes = sum(1 for b in data if b < 128)
    non_ascii_chars = sum(1 for ch in text if ord(ch) > 127)
    return int(ascii_bytes / 4 + non_ascii_chars / 1.5)


def _require_enum(part: dict, field: str, allowed: frozenset, path: Path, i: int, key: str) -> None:
    value = part.get(field)
    if not isinstance(value, str) or value not in allowed:
        raise LedgerError(f"ledger {path}: parts[{i}] ({key}) has no valid {field}")


def load_ledger(path: Path) -> dict:
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise LedgerError(f"cannot read ledger {path}: {exc}") from exc
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        raise LedgerError(f"ledger {path} is not valid JSON: {exc}") from exc
    if not isinstance(data, dict) or not isinstance(data.get("parts"), list):
        raise LedgerError(f"ledger {path} is not an object with a parts list")
    seen_keys: set[str] = set()
    for i, part in enumerate(data["parts"]):
        if not isinstance(part, dict) or not isinstance(part.get("key"), str) or not part["key"]:
            raise LedgerError(f"ledger {path}: parts[{i}] has no string key")
        key = part["key"]
        if key in seen_keys:
            raise LedgerError(f"ledger {path}: duplicate key {key!r}")
        seen_keys.add(key)
        _require_enum(part, "kind", KIND_VALUES, path, i, key)
        _require_enum(part, "loads", LOADS_VALUES, path, i, key)
        _require_enum(part, "status", STATUS_VALUES, path, i, key)
        if part["kind"] not in EXEC_KINDS:
            key_path = PurePosixPath(key)
            if key_path.is_absolute() or ".." in key_path.parts:
                raise LedgerError(f"ledger {path}: parts[{i}] ({key}) has a path outside root")
        measured = part.get("measured_tokens")
        if isinstance(measured, float) and not math.isfinite(measured):
            raise LedgerError(f"ledger {path}: parts[{i}] ({key}) has non-finite measured_tokens")
        sources = part.get("sources")
        if sources is not None and (
            not isinstance(sources, list) or not all(isinstance(s, str) for s in sources)
        ):
            raise LedgerError(f"ledger {path}: parts[{i}] ({key}) has a malformed sources list")
    return data


def ledger_label(root: Path, path: Path) -> str:
    try:
        return path.relative_to(root).as_posix()
    except ValueError:
        return str(path)


def load_ledgers(template_path: Path, instance_path: Path, root: Path) -> list[tuple[dict, str]]:
    loaded = [(load_ledger(template_path), ledger_label(root, template_path))]
    if instance_path.exists():
        loaded.append((load_ledger(instance_path), ledger_label(root, instance_path)))

    seen: dict[str, str] = {}
    for ledger, source in loaded:
        for part in ledger["parts"]:
            key = part["key"]
            previous_source = seen.get(key)
            if previous_source is not None:
                raise LedgerError(
                    f"duplicate key {key!r} across ledgers {previous_source} and {source}"
                )
            seen[key] = source
    return loaded


def plan_or_source(part: dict) -> str:
    status = part["status"]
    if status == "safety":
        return part.get("reason", "")
    if status in ("helps", "no-effect", "hurts"):
        sources = part.get("sources")
        return "; ".join(sources) if isinstance(sources, list) else ""
    return part.get("plan", "")


def escape_cell(value: object) -> str:
    text = str(value).replace("\\", "\\\\")
    text = text.replace("\r\n", " ").replace("\r", " ").replace("\n", " ")
    return text.replace("|", "\\|")


def rank_rows(root: Path, ledgers: list[tuple[dict, str]]) -> list[dict]:
    rows = []
    for ledger, source in ledgers:
        for part in ledger["parts"]:
            kind = part["kind"]
            measured = part.get("measured_tokens")
            if isinstance(measured, (int, float)) and not isinstance(measured, bool):
                tokens: int | str = int(measured)
                marked = True
            elif kind in EXEC_KINDS:
                tokens = "exec"
                marked = False
            else:
                target = root / part["key"]
                if target.is_file():
                    tokens = estimate_tokens(target)
                    marked = False
                else:
                    tokens = "absent"
                    marked = False
            rows.append(
                {
                    "key": part["key"],
                    "kind": kind,
                    "tokens": tokens,
                    "marked": marked,
                    "loads": part["loads"],
                    "status": part["status"],
                    "plan_or_source": plan_or_source(part),
                    "ledger": source,
                }
            )
    # Numeric (sized) rows rank first, descending; `exec` and `absent` rows
    # sort after every sized row and keep their ledger order among
    # themselves (Python's sort is stable).
    rows.sort(key=lambda r: (not isinstance(r["tokens"], int), -(r["tokens"] if isinstance(r["tokens"], int) else 0)))
    return rows


def render_table(rows: list[dict]) -> str:
    lines = ["estimate, about ±40%", ""]
    lines.append("| rank | key | kind | tokens | loads | status | plan or source | ledger |")
    lines.append("|---|---|---|---|---|---|---|---|")
    for i, row in enumerate(rows, start=1):
        tokens = row["tokens"]
        tokens_cell = f"{tokens}{'*' if row['marked'] else ''}" if isinstance(tokens, int) else str(tokens)
        lines.append(
            f"| {i} | {escape_cell(row['key'])} | {escape_cell(row['kind'])} | {tokens_cell} | "
            f"{escape_cell(row['loads'])} | {escape_cell(row['status'])} | {escape_cell(row['plan_or_source'])} | "
            f"{escape_cell(row['ledger'])} |"
        )
    return "\n".join(lines) + "\n"


def check(root: Path, ledgers: list[tuple[dict, str]]) -> list[str]:
    offenders: list[str] = []
    keys = {part["key"] for ledger, _source in ledgers for part in ledger["parts"]}

    for skill_md in sorted((root / "skills").glob("*/SKILL.md")) if (root / "skills").is_dir() else []:
        rel = skill_md.relative_to(root).as_posix()
        if rel not in keys:
            offenders.append(f"no ledger row for skill on disk: {rel}")

    hooks_dir = root / "scripts" / "hooks"
    for hook_script in sorted(hooks_dir.glob("*.sh")) if hooks_dir.is_dir() else []:
        rel = hook_script.relative_to(root).as_posix()
        if rel not in keys:
            offenders.append(f"no ledger row for registered hook on disk: {rel}")

    charter_dir = root / "docs" / "charter"
    for charter_md in sorted(charter_dir.glob("*.md")) if charter_dir.is_dir() else []:
        rel = charter_md.relative_to(root).as_posix()
        if rel not in keys:
            offenders.append(f"no ledger row for charter section on disk: {rel}")

    for fixed_card in FIXED_CARD_PATHS:
        if (root / fixed_card).is_file() and fixed_card not in keys:
            offenders.append(f"no ledger row for card on disk: {fixed_card}")

    for ledger, source in ledgers:
        for part in ledger["parts"]:
            key = part["key"]
            status = part["status"]
            measured = part.get("measured_tokens")
            if measured is not None and not (
                isinstance(measured, (int, float)) and not isinstance(measured, bool)
            ):
                offenders.append(f"{key} ({source}): measured_tokens must be numeric")
            if status == "untested":
                plan = part.get("plan")
                if not isinstance(plan, str) or not plan:
                    offenders.append(f"{key} ({source}): untested row needs a string plan")
                elif plan != "none (grandfathered)":
                    if not part.get("owner"):
                        offenders.append(f"{key} ({source}): untested row with a plan needs owner")
                    measure_by = part.get("measure_by")
                    if not measure_by:
                        offenders.append(f"{key} ({source}): untested row with a plan needs measure_by")
                    elif not (isinstance(measure_by, str) and MEASURE_BY_RE.fullmatch(measure_by)):
                        offenders.append(f"{key} ({source}): measure_by must match YYYY-MM-DD")
            elif status == "safety":
                if not part.get("reason"):
                    offenders.append(f"{key} ({source}): safety row needs reason")
            elif status in ("helps", "no-effect", "hurts"):
                sources = part.get("sources")
                if not isinstance(sources, list) or not sources:
                    offenders.append(f"{key} ({source}): {status} row needs sources")
    return offenders


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", type=Path, default=None, help="install root (default: this script's grandparent directory)")
    ap.add_argument(
        "--ledger",
        type=Path,
        default=None,
        help="template ledger path (default: <root>/docs/evals/evidence.json)",
    )
    ap.add_argument("--check", action="store_true", help="exit 1 and name every offender; exit 0 otherwise")
    ap.add_argument("--json", action="store_true", help="print the ranked rows as JSON instead of a table")
    args = ap.parse_args(argv)

    root = (args.root.resolve() if args.root is not None else default_root(Path(__file__)))
    if not root.is_dir():
        sys.stderr.write(f"harness-inventory: not a directory: {root}\n")
        return 2
    ledger_path = args.ledger.resolve() if args.ledger is not None else root / TEMPLATE_LEDGER_RELATIVE
    instance_ledger_path = root / INSTANCE_LEDGER_RELATIVE

    try:
        ledgers = load_ledgers(ledger_path, instance_ledger_path, root)
    except LedgerError as exc:
        sys.stderr.write(f"harness-inventory: {exc}\n")
        return 2

    if args.check:
        offenders = check(root, ledgers)
        for line in offenders:
            sys.stdout.write(f"{line}\n")
        return 1 if offenders else 0

    rows = rank_rows(root, ledgers)
    if args.json:
        sys.stdout.write(json.dumps(rows, indent=2) + "\n")
    else:
        sys.stdout.write(render_table(rows))
    return 0


if __name__ == "__main__":
    sys.exit(main())
