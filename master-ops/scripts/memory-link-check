#!/usr/bin/env python3
"""Sort missing `[[name]]` memory links into typo, tracker-key,
not-yet-written, and invalid.

A master's memory is one markdown file per fact plus an index `MEMORY.md`.
Files point at each other with `[[name]]`, where `name` is another file's
stem, and a name with no file yet is allowed on purpose: it marks something
worth writing later. That also means a plain "file missing" check cannot
tell a typo from a deliberate placeholder, so this groups every missing
name by why it is missing.

Run it on the directory of `*.md` memory files:

    scripts/memory-link-check --memory-dir memory/

See docs/runbooks/memory-link-check.md for what each group means.
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

LINK_RE = re.compile(r"\[\[([^\]|]+)(?:\|[^\]]*)?\]\]")
FENCE_RE = re.compile(r"^\s*(`{3,}|~{3,})")
INLINE_CODE_RE = re.compile(r"``.*?``|`.*?`", re.DOTALL)


class MemoryLinkCheckError(Exception):
    """A fatal, already-file-named error; the caller turns this into exit 2."""


def strip_fenced_code(text: str) -> str:
    """Drop lines inside a fenced code block, so a link shown as an example
    is not collected as a real one. A fence only closes on a line that
    reuses its opening character and is at least as long, matching the
    CommonMark fenced-code rule, so a ``` block is not closed by a ~~~
    line or a shorter run of the same character."""
    out = []
    opening: str | None = None
    for line in text.splitlines():
        match = FENCE_RE.match(line)
        if opening is None:
            if match:
                opening = match.group(1)
                continue
            out.append(line)
            continue
        if match and match.group(1)[0] == opening[0] and len(match.group(1)) >= len(opening):
            opening = None
    return "\n".join(out)


def strip_inline_code(text: str) -> str:
    """Drop single- or double-backtick code spans, matched over the whole
    text so a span may cross a newline, so a link named inside one, such
    as a TOML `[[table]]` name, is not collected as a real one. The
    double-backtick branch is tried first, so a double-backtick span may
    itself contain single backticks and closes only on the next double
    backtick. A span with no closing delimiter anywhere in the rest of
    the text has nothing to match and is left as prose."""
    return INLINE_CODE_RE.sub("", text)


def levenshtein(a: str, b: str) -> int:
    if a == b:
        return 0
    if not a:
        return len(b)
    if not b:
        return len(a)
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i] + [0] * len(b)
        for j, cb in enumerate(b, 1):
            cost = 0 if ca == cb else 1
            cur[j] = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
        prev = cur
    return prev[-1]


def collect_links(memory_dir: Path) -> dict[str, list[str]]:
    """Return {link name: sorted file names it appears in}. A directory
    that happens to match *.md is not a memory file and is skipped; it
    can still surface through invalid_link_reason if something links to
    it as if it were one."""
    links: dict[str, set[str]] = {}
    for path in sorted(p for p in memory_dir.glob("*.md") if p.is_file()):
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            raise MemoryLinkCheckError(f"cannot read {path}: {exc}") from exc
        body = strip_inline_code(strip_fenced_code(text))
        for match in LINK_RE.finditer(body):
            name = match.group(1).strip()
            if not name:
                continue
            links.setdefault(name, set()).add(path.name)
    return {name: sorted(files) for name, files in links.items()}


def read_keys(spec: str | None) -> set[str]:
    if spec is None:
        return set()
    try:
        text = sys.stdin.read() if spec == "-" else Path(spec).read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        raise MemoryLinkCheckError(f"cannot read --bd-keys {spec}: {exc}") from exc
    return {line.strip() for line in text.splitlines() if line.strip()}


def closest_matches(
    name: str, stems: list[str], max_distance: int
) -> tuple[list[str], int] | None:
    """Return (tied stem names, distance) for the closest existing file
    stem(s) within max_distance, or None. Stems are compared in sorted
    order so a tie is reported the same names in the same order every
    run, and every stem sharing the best distance is reported, not just
    the first one found."""
    best_distance: int | None = None
    best_stems: list[str] = []
    for stem in sorted(stems):
        d = levenshtein(name, stem)
        if d == 0 or d > max_distance:
            continue
        if best_distance is None or d < best_distance:
            best_distance = d
            best_stems = [stem]
        elif d == best_distance:
            best_stems.append(stem)
    if best_distance is None:
        return None
    return best_stems, best_distance


def invalid_link_reason(name: str, memory_dir: Path) -> str | None:
    """None when name is a safe, ordinary link target; otherwise a short
    reason it can never resolve to a plain file in memory_dir. A name with
    a path separator is rejected before it ever reaches the filesystem, so
    it cannot be used to read or report on anything outside memory_dir."""
    if "/" in name or "\\" in name:
        return "contains a path separator"
    target = memory_dir / f"{name}.md"
    if target.exists() and not target.is_file():
        return "target exists but is not a regular file"
    return None


def sort_missing(
    links: dict[str, list[str]],
    memory_dir: Path,
    bd_keys: set[str],
    max_distance: int,
) -> tuple[dict[str, tuple[list[str], int]], dict[str, None], list[str], dict[str, str]]:
    """Return (typo, tracker_key, not_yet_written, invalid).

    A name in --bd-keys is classified tracker-key before the typo check:
    an explicit key list is given input, and it outranks a guessed
    near-miss against an unrelated file name.
    """
    stems = [p.stem for p in memory_dir.glob("*.md") if p.is_file()]
    typo: dict[str, tuple[list[str], int]] = {}
    tracker_key: dict[str, None] = {}
    not_yet_written: list[str] = []
    invalid: dict[str, str] = {}
    for name in sorted(links):
        reason = invalid_link_reason(name, memory_dir)
        if reason is not None:
            invalid[name] = reason
            continue
        if (memory_dir / f"{name}.md").exists():
            continue
        if name in bd_keys:
            tracker_key[name] = None
            continue
        match = closest_matches(name, stems, max_distance)
        if match is not None:
            typo[name] = match
            continue
        not_yet_written.append(name)
    return typo, tracker_key, not_yet_written, invalid


def render(
    links: dict[str, list[str]],
    typo: dict[str, tuple[list[str], int]],
    tracker_key: dict[str, None],
    not_yet_written: list[str],
    invalid: dict[str, str],
) -> str:
    lines = []
    lines.append(f"typo ({len(typo)})")
    for name, (stems, distance) in typo.items():
        files = ", ".join(links[name])
        target = " or ".join(stems)
        tie = ", tie" if len(stems) > 1 else ""
        lines.append(f"  {name} -> {target} (distance {distance}{tie})  [{files}]")
    lines.append(f"tracker-key ({len(tracker_key)})")
    for name in tracker_key:
        files = ", ".join(links[name])
        lines.append(f"  {name}  [{files}]")
    lines.append(f"not-yet-written ({len(not_yet_written)})")
    for name in not_yet_written:
        files = ", ".join(links[name])
        lines.append(f"  {name}  [{files}]")
    lines.append(f"invalid ({len(invalid)})")
    for name, reason in invalid.items():
        files = ", ".join(links[name])
        lines.append(f"  {name}: {reason}  [{files}]")
    return "\n".join(lines) + "\n"


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--memory-dir", required=True, type=Path,
                     help="directory of *.md memory files")
    ap.add_argument("--bd-keys", default=None,
                     help="file of tracker memory keys, one per line; - for stdin")
    ap.add_argument("--max-distance", type=int, default=2,
                     help="max Levenshtein distance counted as a typo (default 2)")
    ap.add_argument("--strict-tracker-keys", action="store_true",
                     help="also fail (exit 1) when the tracker-key group is non-empty")
    args = ap.parse_args(argv)

    if args.max_distance < 0:
        ap.error("--max-distance must be >= 0")
    if not args.memory_dir.is_dir():
        sys.stderr.write(f"memory-link-check: not a directory: {args.memory_dir}\n")
        return 2

    try:
        bd_keys = read_keys(args.bd_keys)
        links = collect_links(args.memory_dir)
    except MemoryLinkCheckError as exc:
        sys.stderr.write(f"memory-link-check: {exc}\n")
        return 2

    typo, tracker_key, not_yet_written, invalid = sort_missing(
        links, args.memory_dir, bd_keys, args.max_distance
    )
    sys.stdout.write(render(links, typo, tracker_key, not_yet_written, invalid))

    if typo or invalid:
        return 1
    if args.strict_tracker_keys and tracker_key:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
