#!/usr/bin/env python3
"""Report how an ops install compares to its template manifest.

Exit status contract (fails closed; exit 2 is never collapsed to 0):
  0  checked and current / no drift
  1  checked and drift or behind
  2  could not check (missing or malformed inputs)

Two report sets exist. The report always states which set was produced:

  install-manifest  — installed version, absent required paths, unknown paths
  template-compare  — the above plus template version and CHANGELOG adoption notes

`--template` also lets this run from the template side against an arbitrary ops
path, so an install too old to contain this script is still checkable.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
if str(_SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(_SCRIPT_DIR))
from template_common import (  # noqa: E402
    is_instance_owned,
)

TEMPLATE_SIDE_FILES = frozenset(
    {
        "TEMPLATE-VERSION",
        "CHANGELOG.md",
        "ONBOARDING.md",
    }
)
TEMPLATE_SIDE_DIRS = frozenset(
    {
        "onboarding",
    }
)


def _die(msg: str, code: int = 2) -> int:
    sys.stderr.write(f"template-check: {msg}\n")
    return code


def resolve_ops_root(ops: Path | None, script_path: Path) -> Path | None:
    if ops is not None:
        return ops.resolve()
    # Script lives at <ops>/scripts/template-check when installed.
    candidate = script_path.resolve().parent.parent
    if (candidate / "MANIFEST.json").is_file() or (candidate / "docs").is_dir():
        return candidate
    return None


def resolve_template_root(template: Path | None) -> Path | None:
    if template is None:
        return None
    path = template.resolve()
    if not path.is_dir():
        return None
    # Require template identity: MANIFEST and/or TEMPLATE-VERSION. Never accept
    # an arbitrary directory as a silent fallback.
    if (path / "MANIFEST.json").is_file() or (path / "TEMPLATE-VERSION").is_file():
        return path
    nested = path / "master-ops"
    if nested.is_dir() and (
        (nested / "MANIFEST.json").is_file() or (nested / "TEMPLATE-VERSION").is_file()
    ):
        return nested
    return None


def load_manifest(path: Path) -> tuple[dict | None, str | None]:
    if not path.is_file():
        return None, "manifest absent"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        return None, f"manifest malformed: {exc}"
    if not isinstance(data, dict):
        return None, "manifest malformed: root is not an object"
    if "files" not in data or not isinstance(data["files"], list):
        return None, "manifest malformed: missing files list"
    return data, None


def list_present_paths(root: Path) -> tuple[set[str], list[str]]:
    present: set[str] = set()
    invalid: list[str] = []
    if not root.is_dir():
        return present, invalid
    for path in root.rglob("*"):
        if not path.is_symlink() and not path.is_file():
            continue
        # Skip VCS / tracker internals for unknown-path reporting noise control,
        # but still refuse them by name on apply.
        rel = path.relative_to(root).as_posix()
        if rel.startswith(".git/") or rel.startswith(".beads/"):
            continue
        if path.is_symlink():
            invalid.append(rel)
            continue
        present.add(rel)
    return present, invalid



def is_template_side(rel: str) -> bool:
    if rel in TEMPLATE_SIDE_FILES:
        return True
    top = rel.split("/", 1)[0]
    return top in TEMPLATE_SIDE_DIRS


def read_template_version(template_root: Path) -> tuple[str | None, str | None]:
    """Return (version, error). A non-None error means the version could not be checked."""
    version_file = template_root / "TEMPLATE-VERSION"
    if version_file.is_file():
        try:
            version = version_file.read_text(encoding="utf-8").strip()
        except (OSError, UnicodeDecodeError) as exc:
            return None, f"template VERSION unreadable: {exc}"
        if not version:
            return None, "template VERSION is empty"
        return version, None
    try:
        manifest, err = load_manifest(template_root / "MANIFEST.json")
    except (OSError, UnicodeDecodeError) as exc:
        return None, f"template manifest unreadable: {exc}"
    if err and err != "manifest absent":
        return None, f"template {err}"
    if not manifest:
        return None, "template version undeterminable (no TEMPLATE-VERSION and no MANIFEST.json)"
    version = manifest.get("template_version")
    if not isinstance(version, str) or not version.strip():
        return None, "template MANIFEST.json missing non-empty template_version"
    return version.strip(), None


def parse_changelog_sections(text: str) -> list[tuple[str, str]]:
    """Return [(version_heading, body), ...] newest first where possible."""
    # Match ## v0.4.4 or ## [0.4.4] or ## Unreleased — single-line headings only.
    pattern = re.compile(r"^##[ \t]+(\[?[^\]\r\n]+\]?)\s*$", re.MULTILINE)
    matches = list(pattern.finditer(text))
    sections: list[tuple[str, str]] = []
    for i, match in enumerate(matches):
        heading = match.group(1).strip().strip("[]")
        start = match.end()
        end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
        body = text[start:end].strip()
        sections.append((heading, body))
    return sections


def adoption_notes_newer_than(
    changelog: Path, installed: str | None
) -> tuple[list[dict], str | None]:
    if not changelog.is_file():
        return [], None
    try:
        text = changelog.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        return [], f"template CHANGELOG unreadable: {exc}"
    sections = parse_changelog_sections(text)
    notes: list[dict] = []
    for heading, body in sections:
        if heading.lower() == "unreleased":
            notes.append({"version": heading, "body": body})
            continue
        if installed is None:
            notes.append({"version": heading, "body": body})
            continue
        # Include sections that are not the installed version. Ordering in the
        # file is newest-first under Unreleased then released tags; stop once
        # the installed tag heading is reached.
        if heading == installed or heading == installed.lstrip("v") or f"v{heading}" == installed:
            break
        notes.append({"version": heading, "body": body})
    return notes, None


def build_report(
    ops_root: Path,
    template_root: Path | None,
) -> tuple[dict, int]:
    """Return (report, exit_code)."""
    report: dict = {
        "report_set": "install-manifest",
        "ops_root": str(ops_root),
        "installed_version": None,
        "manifest_status": "ok",
        "absent_required": [],
        "unknown_present": [],
        "template_version": None,
        "adoption_notes": [],
        "questions_unanswered": [],
        "invalid_paths": [],
    }

    manifest_path = ops_root / "MANIFEST.json"
    manifest, err = load_manifest(manifest_path)
    present, invalid_paths = list_present_paths(ops_root)
    report["invalid_paths"] = sorted(invalid_paths)

    if err == "manifest absent":
        report["manifest_status"] = "absent"
        report["questions_unanswered"].append(
            "installed version undeterminable (no MANIFEST.json); compare by content presence only"
        )
        # Without a manifest, still emit a useful presence table when template given.
        required: list[str] = []
        installed_version = None
    elif err:
        report["manifest_status"] = "malformed"
        report["questions_unanswered"].append(err)
        return report, 2
    else:
        assert manifest is not None
        required = [str(p) for p in manifest["files"]]
        installed_version = manifest.get("template_version")
        report["installed_version"] = installed_version

    absent = sorted(p for p in required if p not in present)
    unknown = sorted(
        p
        for p in present
        if p not in required
        and not is_instance_owned(p)
        and not is_template_side(p)
        and p != "MANIFEST.json"
    )
    # If MANIFEST is required and present, fine; if required list lacks it on
    # old generators, do not flag it as unknown.
    report["absent_required"] = absent
    report["unknown_present"] = unknown

    exit_code = 0
    if report["manifest_status"] == "absent":
        exit_code = 1  # checkable-but-undetermined shape still reports; not exit 2
    if report["absent_required"] or report["unknown_present"] or invalid_paths:
        exit_code = 1

    if template_root is not None:
        report["report_set"] = "template-compare"
        if not template_root.is_dir():
            report["questions_unanswered"].append(
                f"template path unreadable: {template_root}"
            )
            return report, 2
        t_version, t_version_err = read_template_version(template_root)
        report["template_version"] = t_version
        if t_version_err:
            report["questions_unanswered"].append(t_version_err)
            return report, 2
        t_manifest, t_err = load_manifest(template_root / "MANIFEST.json")
        if t_err and t_err != "manifest absent":
            report["questions_unanswered"].append(f"template {t_err}")
            return report, 2
        if t_manifest:
            t_required = [str(p) for p in t_manifest["files"]]
            # Recompute absence against template manifest (authoritative current set).
            report["absent_required"] = sorted(p for p in t_required if p not in present)
            report["unknown_present"] = sorted(
                p
                for p in present
                if p not in t_required
                and not is_instance_owned(p)
                and not is_template_side(p)
                and p != "MANIFEST.json"
            )
            if report["absent_required"] or report["unknown_present"] or invalid_paths:
                exit_code = 1
            elif report["manifest_status"] == "absent":
                exit_code = 1
        elif report["manifest_status"] == "absent":
            # Template has no manifest either: presence table only from walking
            # the template skeleton with the same exclusion rules is not available
            # here without the generator; report what we can.
            exit_code = 1

        if installed_version and t_version and installed_version != t_version:
            exit_code = 1

        changelog = template_root / "CHANGELOG.md"
        report["adoption_notes"], changelog_error = adoption_notes_newer_than(
            changelog, report["installed_version"]
        )
        if changelog_error:
            report["questions_unanswered"].append(changelog_error)
            return report, 2
        if report["adoption_notes"] and report["installed_version"] != t_version:
            exit_code = 1

    if report["questions_unanswered"] and report["manifest_status"] == "malformed":
        return report, 2

    return report, exit_code


def format_human(report: dict) -> str:
    lines: list[str] = []
    lines.append(f"report_set: {report['report_set']}")
    lines.append(f"ops: {report['ops_root']}")
    lines.append(f"manifest: {report['manifest_status']}")
    ver = report.get("installed_version") or "(undeterminable)"
    lines.append(f"installed_version: {ver}")
    if report["report_set"] == "template-compare":
        tver = report.get("template_version") or "(unreadable)"
        lines.append(f"template_version: {tver}")
    absent = report.get("absent_required") or []
    unknown = report.get("unknown_present") or []
    lines.append(f"absent_required: {len(absent)}")
    for p in absent:
        lines.append(f"  - {p}")
    lines.append(f"unknown_present: {len(unknown)}")
    for p in unknown:
        lines.append(f"  - {p}")
    invalid = report.get("invalid_paths") or []
    lines.append(f"invalid_paths: {len(invalid)}")
    for p in invalid:
        lines.append(f"  - {p}")
    notes = report.get("adoption_notes") or []
    if report["report_set"] == "template-compare":
        lines.append(f"adoption_notes: {len(notes)} section(s)")
        for note in notes:
            lines.append(f"  ## {note['version']}")
            body = note.get("body") or ""
            preview = body.splitlines()[:8]
            for bl in preview:
                lines.append(f"    {bl}")
            if len(body.splitlines()) > 8:
                lines.append("    …")
    unanswered = report.get("questions_unanswered") or []
    if unanswered:
        lines.append("questions_unanswered:")
        for q in unanswered:
            lines.append(f"  - {q}")
    return "\n".join(lines) + "\n"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--ops",
        type=Path,
        default=None,
        help="Ops repository root (default: parent of this script's directory)",
    )
    parser.add_argument(
        "--template",
        type=Path,
        default=None,
        help="Template master-ops path or ADE clone root for comparison",
    )
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    args = parser.parse_args(argv)

    script_path = Path(__file__)
    ops_root = resolve_ops_root(args.ops, script_path)
    if ops_root is None or not ops_root.is_dir():
        return _die("ops root unreadable; pass --ops <path>", 2)

    template_root = resolve_template_root(args.template)
    if args.template is not None and template_root is None:
        return _die(f"template path unreadable: {args.template}", 2)

    try:
        report, code = build_report(ops_root, template_root)
    except (OSError, UnicodeDecodeError) as exc:
        return _die(f"could not read inputs: {exc}", 2)
    if args.json:
        json.dump(report, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        sys.stdout.write(format_human(report))
    return code


if __name__ == "__main__":
    raise SystemExit(main())
