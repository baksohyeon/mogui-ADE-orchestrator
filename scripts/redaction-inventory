#!/usr/bin/env python3
"""redaction-inventory. Reports tokens no redaction rule covers.

`redaction-scan.sh` matches what the rules name; this asks the inverse. Scope is
tracked files at the current commit. Reviewed tokens go in the baseline file and
stop being reported.

A candidate is not a secret, and an empty result is not proof of safety. This
narrows the rules' blind spot; it does not measure exposure.

Exit codes
  0  no uncovered candidates
  1  uncovered candidates found
  2  cannot decide (no pattern file, not a git repository)

Usage
  REDACTION_EXTRA_PATTERNS=~/.config/redaction-extra.txt scripts/redaction-inventory
  scripts/redaction-inventory --baseline .redaction-inventory-baseline
  scripts/redaction-inventory --json
"""

import argparse, json, os, re, subprocess, sys
from collections import Counter

# Frequent generic tokens. Excluded from candidates.
COMMON = set("""
utf-8 read-only write-only fail-open fail-closed human-in-the-loop in-process
stdlib-only tool-name-free append-only long-lived per-token dry-run
check-duplicates verify-successor l1-digest name-only three-way opt-in
""".split())

STOP = set("""
python json yaml toml markdown github gitlab orca beads claude codex cursor
master runtime adapter acceptance bootstrap lineage succession recovery watchdog
dispatch gate ledger worktree workspace repository session agent worker contract
readme license makefile dockerfile true false null none self args kwargs test
tests src scripts docs public internal main origin head utf ascii http https
localhost example sample dummy placeholder polsia qfuds langchain deepagents
""".split())

# Repository and organization names appear as kebab-case. snake_case is
# excluded because it is a code identifier.
CANDIDATE = re.compile(r"(?<![A-Za-z0-9_./-])([a-z][a-z0-9]*(?:-[a-z0-9]+)+)(?![A-Za-z0-9_.-])")
# A Latin word within 40 characters of Hangul, in either order. Catches
# single-word identifiers embedded in Korean prose.
NEAR_HANGUL = re.compile(
    r"(?:[가-힣][^\n]{0,40}?)(?<![A-Za-z0-9_./-])([a-z][a-z0-9]{3,19})(?![A-Za-z0-9_.-])"
    r"|(?<![A-Za-z0-9_./-])([a-z][a-z0-9]{3,19})(?![A-Za-z0-9_.-])(?:[^\n]{0,40}?[가-힣])")
HOMEPATH = re.compile(r"/Users/([A-Za-z0-9._-]+)")
EMAIL = re.compile(r"[A-Za-z0-9._%+-]+@([A-Za-z0-9.-]+\.[A-Za-z]{2,})")
# Korean personal names are not detected; cover them with `person_*` rules.


def run(cmd):
    p = subprocess.run(cmd, capture_output=True, text=True)
    return p.returncode, p.stdout


def load_rules(path):
    """Pull the regexes out of the pattern file, and count what could not be used.

    A line that is malformed or whose regex does not compile used to be dropped in
    silence, so the reported rule count described what loaded rather than what the
    file held: coverage narrowed while the file still looked populated. Return the
    unusable count as well so the caller can say so out loud.
    """
    pats, unusable, considered = [], 0, 0
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            considered += 1
            parts = line.split("|", 2)
            if len(parts) != 3:
                unusable += 1
                continue
            try:
                pats.append(re.compile(parts[2]))
            except re.error:
                unusable += 1
    return pats, unusable, considered


def load_dictionary():  # use it if present, empty set if not
    """System dictionary. Empty set when absent, which widens the candidate list."""
    for p in ("/usr/share/dict/words", "/usr/dict/words"):
        try:
            with open(p, encoding="utf-8", errors="ignore") as fh:
                return {w.strip().lower() for w in fh if w.strip()}
        except OSError:
            continue
    return set()


def covered(token, rules):
    return any(r.search(token) for r in rules)


def harvest():
    """Collect the text to be scanned, with the number of tracked files read."""
    rc, files = run(["git", "ls-files"])
    if rc != 0:
        return None
    blobs = []
    for f in files.splitlines():
        try:
            with open(f, "rb") as fh:
                raw = fh.read()
        except OSError:
            continue
        # Skip binaries, judged by a NUL byte in the first 8 KB. Decoding them
        # with errors="ignore" yields fake candidates that bury real ones.
        if b"\x00" in raw[:8192]:
            continue
        blobs.append(raw.decode("utf-8", errors="ignore"))
    names = files.splitlines()
    blobs.append(" ".join(names))
    return "\n".join(blobs), len(names)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--baseline", default=".redaction-inventory-baseline",
                    help="reviewed candidates; only tokens absent from it are reported")
    ap.add_argument("--min-count", type=int, default=1)
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    path = os.environ.get("REDACTION_EXTRA_PATTERNS", "")
    if not path or not os.path.isfile(os.path.expanduser(path)):
        print("redaction-inventory: FAIL. REDACTION_EXTRA_PATTERNS is unset. "
              "A blind spot cannot be measured without rules.", file=sys.stderr)
        return 2
    rules, unusable_rules, considered_rules = load_rules(os.path.expanduser(path))
    if not rules:
        print("redaction-inventory: FAIL. No rules could be read from the pattern file.", file=sys.stderr)
        return 2

    words = load_dictionary()
    harvested = harvest()
    if harvested is None:
        print("redaction-inventory: FAIL. Not a git repository.", file=sys.stderr)
        return 2
    text, tracked_files = harvested
    if not tracked_files:
        # Nothing to read is not a clean result. Without this an empty checkout
        # reports OK, and "checked nothing" reads the same as "found nothing".
        print("redaction-inventory: FAIL. No tracked files to scan.", file=sys.stderr)
        return 2

    buckets = {
        "kebab": Counter(m for m in CANDIDATE.findall(text)
                         if m not in STOP and m not in COMMON
                         and not all(w in STOP for w in m.split("-"))),
        "word_in_korean": Counter(
            w for pair in NEAR_HANGUL.findall(text) for w in pair
            if w and w not in STOP and w not in words
            and not any(w in c for c in COMMON)),
        "home_user": Counter(HOMEPATH.findall(text)),
        "email_domain": Counter(EMAIL.findall(text)),
    }

    base = set()
    if os.path.isfile(a.baseline):
        with open(a.baseline, encoding="utf-8") as fh:
            base = {l.strip() for l in fh if l.strip() and not l.startswith("#")}

    uncovered = {}
    for kind, counter in buckets.items():
        rows = [(tok, n) for tok, n in counter.most_common()
                if n >= a.min_count and tok not in base and not covered(tok, rules)]
        if rows:
            uncovered[kind] = rows

    total = sum(len(v) for v in uncovered.values())
    if a.json:
        print(json.dumps({"rules": len(rules),
                          "rules_unusable": unusable_rules,
                          "rules_considered": considered_rules,
                          "tracked_files": tracked_files,
                          "baseline": len(base),
                          "uncovered_total": total,
                          "uncovered": {k: [{"token": t, "count": n} for t, n in v]
                                        for k, v in uncovered.items()}},
                         ensure_ascii=False, indent=2))
    else:
        scope = "tracked"
        unusable_note = (
            f" / {unusable_rules} unusable of {considered_rules} rule lines"
            if unusable_rules else ""
        )
        print(f"redaction-inventory: {len(rules)} rules / scope {scope}"
              f" / {tracked_files} files / baseline {len(base)}{unusable_note}")
        if not total:
            print("redaction-inventory: OK. 0 uncovered candidates")
        else:
            for kind, rows in uncovered.items():
                print(f"\n[{kind}] {len(rows)}")
                for tok, n in rows[:40]:
                    print(f"  {n:5d}  {tok}")
                if len(rows) > 40:
                    print(f"  … and {len(rows) - 40} more")
            print()
            print(f"redaction-inventory: {total} uncovered candidates. "
                  "Not all of them are secrets. Pick the ones that belong in a rule.")
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main())
