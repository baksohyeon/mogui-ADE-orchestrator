#!/usr/bin/env python3
"""Command line entry point for the worker dispatch gate."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path


SCRIPT_PATH = Path(__file__).resolve()
REPO_ROOT = SCRIPT_PATH.parent.parent
SRC_ROOT = REPO_ROOT / "src"
sys.path.insert(0, str(SRC_ROOT))

from master_runtime.core.dispatch_gate import (  # noqa: E402
    DispatchGate,
    DispatchGateConfig,
    DispatchRequest,
    GateDecision,
)
from master_runtime.core.watchdog import StallStatus, check_stall  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)

    if args.command == "check":
        return _check(args)
    if args.command == "register":
        return _register(args)
    if args.command == "watch":
        return _watch(args)

    parser.print_help(sys.stderr)
    return 2


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dispatch-gate")
    parser.add_argument("--ledger", help="JSONL ledger path")
    subparsers = parser.add_subparsers(dest="command", required=True)

    check_parser = subparsers.add_parser("check")
    check_parser.add_argument("--runtime", required=True)
    check_parser.add_argument("--contract", required=True)
    check_parser.add_argument("--agents", required=True, type=int)
    check_parser.add_argument("--est-chars", type=int)

    register_parser = subparsers.add_parser("register")
    register_parser.add_argument("--job-id", required=True)
    register_parser.add_argument("--probe-cmd", required=True)
    register_parser.add_argument("--contract-sha")
    register_parser.add_argument("--runtime")

    watch_parser = subparsers.add_parser("watch")
    watch_parser.add_argument("--log", required=True)
    watch_parser.add_argument("--max-idle", type=int, default=360)

    return parser


def _gate(args: argparse.Namespace) -> DispatchGate:
    if args.ledger:
        return DispatchGate(DispatchGateConfig(ledger_path=args.ledger))
    return DispatchGate()


def _check(args: argparse.Namespace) -> int:
    contract_path = Path(args.contract)
    est_chars = args.est_chars
    if est_chars is None:
        est_chars = len(contract_path.read_text(encoding="utf-8"))

    decision = _gate(args).check(
        DispatchRequest(
            runtime=args.runtime,
            contract_path=contract_path,
            est_input_chars=est_chars,
            n_agents=args.agents,
        )
    )
    _print_decision(decision)
    if decision.allow:
        return 0
    print(decision.reason.value, file=sys.stderr)
    return 2


def _register(args: argparse.Namespace) -> int:
    decision = _gate(args).register_job(
        args.job_id,
        lambda job_id: _probe_contains_job_id(args.probe_cmd, job_id),
        contract_sha=args.contract_sha,
        runtime=args.runtime,
    )
    _print_decision(decision)
    if decision.allow:
        return 0
    print(_decision_error(decision), file=sys.stderr)
    return 2


def _watch(args: argparse.Namespace) -> int:
    decision = check_stall(args.log, max_idle_seconds=args.max_idle)
    payload = {
        "status": decision.status.value,
        "idle_seconds": decision.idle_seconds,
        "last_progress_at": decision.last_progress_at,
        "reason": decision.reason,
    }
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    if decision.status == StallStatus.STALLED:
        print(decision.reason, file=sys.stderr)
        return 3
    if decision.status == StallStatus.MISSING:
        print(decision.reason, file=sys.stderr)
        return 2
    return 0


def _probe_contains_job_id(probe_cmd: str, job_id: str) -> bool:
    result = subprocess.run(
        probe_cmd,
        shell=True,
        check=False,
        capture_output=True,
        text=True,
    )
    return result.returncode == 0 and job_id in result.stdout


def _print_decision(decision: GateDecision) -> None:
    payload = {
        "allow": decision.allow,
        "reason": decision.reason.value,
        "warnings": [warning.value for warning in decision.warnings],
        "contract_sha": decision.contract_sha,
        "cost_proxy": decision.cost_proxy,
    }
    if decision.message:
        payload["message"] = decision.message
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))


def _decision_error(decision: GateDecision) -> str:
    if decision.message:
        return decision.reason.value + ": " + decision.message
    return decision.reason.value


if __name__ == "__main__":
    raise SystemExit(main())
