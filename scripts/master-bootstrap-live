#!/usr/bin/env python3
"""master-bootstrap-live — SessionStart hook entry point.

Emits the dynamic master bootstrap block. Booting must never die: any
internal error is reduced to a ``[BOOTSTRAP-FALLBACK]`` line and the exit
code is always 0.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

SCRIPT_PATH = Path(__file__).resolve()
REPO_ROOT = SCRIPT_PATH.parent.parent
SRC_ROOT = REPO_ROOT / "src"
sys.path.insert(0, str(SRC_ROOT))


def _make_bd_runner(bd_exe):
    def runner(argv):
        cmd = [bd_exe] + list(argv)[1:]
        result = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
        )
        return result.stdout

    return runner


_COMPACT_SUPPRESSED_LINE = (
    "[E12] compact: tracks/role suppressed for recall probe "
    "(recall first, then check against the tracker for the authoritative state)"
)
_COMPACT_FIRST_INJECTION_BANNER = (
    "[E12-CRITICAL] compact first-injection warning: this hook output may be "
    "arriving after the first synthetic continuation turn. Treat the previous "
    "synthetic turn as unrehydrated; before any tool action, Read the canonical "
    "role-state.md, declare Role State, and stop if that Read is unavailable."
)
_MARKDOWN_HEADING_RE = re.compile(r"^\s{0,3}#{2,6}\s+(?P<title>.+?)\s*#*\s*$")


def _session_source_from_stdin():
    raw = sys.stdin.read()
    if not raw.strip():
        return None
    try:
        payload = json.loads(raw)
    except Exception:
        return None
    if not isinstance(payload, dict):
        return None
    return payload.get("source")


def _suppress_compact_recall_leaks(block):
    try:
        return _with_compact_first_injection_banner(
            _suppress_compact_recall_leaks_unchecked(block)
        )
    except Exception:
        if isinstance(block, str):
            return _with_compact_first_injection_banner(block)
        return _COMPACT_FIRST_INJECTION_BANNER


def _suppress_compact_recall_leaks_unchecked(block):
    lines = block.splitlines()
    output = []
    suppressed = False
    skip_section = False

    for line in lines:
        if _is_compact_suppressed_heading(line):
            if not suppressed:
                output.append(_COMPACT_SUPPRESSED_LINE)
                suppressed = True
            skip_section = True
            continue
        if _is_markdown_heading(line):
            skip_section = False
        if not skip_section:
            output.append(line)

    if suppressed:
        return "\n".join(output)
    if lines and lines[0].startswith("[MASTER-BOOTSTRAP"):
        return "\n".join([lines[0], _COMPACT_SUPPRESSED_LINE] + lines[1:])
    return _COMPACT_SUPPRESSED_LINE + "\n" + block


def _with_compact_first_injection_banner(block):
    if block.startswith(_COMPACT_FIRST_INJECTION_BANNER):
        return block
    return _COMPACT_FIRST_INJECTION_BANNER + "\n" + block


def _is_markdown_heading(line):
    return _MARKDOWN_HEADING_RE.match(line) is not None


def _is_compact_suppressed_heading(line):
    match = _MARKDOWN_HEADING_RE.match(line)
    if match is None:
        return False
    title = match.group("title").strip().lower()
    compact_title = re.sub(r"\s+", "", title)
    # The Korean alternative matches a section title in a Korean operations doc.
    return title.startswith("role state") or title.startswith("active tracks") or compact_title.startswith("활성트랙")


def main(argv=None) -> int:
    try:
        from master_runtime.core.bootstrap_live import (  # noqa: E402
            DEFAULT_BUDGET_CHARS,
            run_live,
        )

        parser = argparse.ArgumentParser(prog="master-bootstrap-live")
        parser.add_argument("--handoff-dir", required=True)
        parser.add_argument("--role-state-file")
        parser.add_argument("--budget", type=int, default=DEFAULT_BUDGET_CHARS)
        parser.add_argument("--bd", default="bd")
        parser.add_argument("--charter-pointer")
        args = parser.parse_args(argv)
        source = _session_source_from_stdin()

        block = run_live(
            Path(args.handoff_dir),
            role_state_file=Path(args.role_state_file) if args.role_state_file else None,
            bd_runner=_make_bd_runner(args.bd),
            probe=None,
            session_id=os.environ.get("CLAUDE_SESSION_ID"),
            budget_chars=args.budget,
            charter_pointer=args.charter_pointer,
        )
        if source == "compact":
            block = _suppress_compact_recall_leaks(block)
        print(block)
        return 0
    except SystemExit:
        raise
    except BaseException as exc:  # noqa: BLE001 - boot must not die; always exit 0
        print("[BOOTSTRAP-FALLBACK] CLI " + exc.__class__.__name__ + ": " + str(exc))
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
