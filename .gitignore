__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
dist/
coverage/
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/settings.json
# local-only workspace manifests (real coordinates never enter this repo)
*.local.json

# instance-owned runtime answers written by onboarding; template ships only the example
# Supported format is JSON only (see config/instance-runtime.example.json).
config/instance-runtime.json

# instance-owned workspace inventory written by onboarding; template ships only the example
config/workspace-descriptor.json

# local-only redaction/sweep artifacts — these contain the very identifiers the
# scanner protects, and a public repo must never accept them via `git add -A`
*redact-result*
*redaction-report*
redaction-extra*.txt
*.sweep.md
.orca/
