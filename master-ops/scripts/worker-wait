#!/usr/bin/env python3
"""One wait loop over a Run's live dispatches, with dead/stall verdicts from measured state.

Exit codes: 0 loop exited cleanly (woke, timed out, or nothing left dispatched);
2 usage error, no resolvable Run, another waiter already holds this Run's lock,
or `orca` could not produce an authoritative dispatch listing (never treated
as an empty, all-settled Run — that would report success on a listing failure).

Self-contained on purpose: this tree is template-applied into repositories that have
no src/ tree, so this cannot import master_runtime like the ops repo's own scripts/dispatch-gate.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

_SCRIPTS_DIR = Path(__file__).resolve().parent
if str(_SCRIPTS_DIR) not in sys.path:
    sys.path.insert(0, str(_SCRIPTS_DIR))
try:
    from mogui_log import emit as mogui_emit  # noqa: E402
except ImportError:
    # Fail-open, same as mogui_log's own emit(): a copy of this file made
    # without its sibling (or a template-apply that has not landed it yet)
    # must not block the wait loop over a logging dependency.
    def mogui_emit(*args, **kwargs):  # noqa: D401
        return None

DEFAULT_STALL_MINUTES = 10
DEFAULT_CHECK_TIMEOUT_MS = 60_000
MAX_ACK_FLUSH_ROUNDS = 10
ACK_FLUSH_SUBPROCESS_TIMEOUT_SECONDS = 5
CHECK_WAIT_SUBPROCESS_TIMEOUT_MARGIN_SECONDS = 30
WAIT_TYPES = "worker_done,escalation,question"
STALL_SWEEP_CLASSES = frozenset(
    {"idle", "shell", "limit", "start-screen", "update", "approval"}
)
ACTIONABLE_VERDICTS = frozenset({"DEAD", "STALL", "OPEN_PANE"})
MAX_WORKER_LIST_PAGES = 20
WORKER_LIST_PAGE_LIMIT = 100


class WorkerListError(RuntimeError):
    """`orca orchestration worker-list` could not be read.

    Never caught and turned into an empty dispatch list: an empty list means
    zero dispatches, which means the loop reports success. Confusing "orca
    failed" with "the Run has settled" is exactly the false-success bug this
    type exists to prevent.
    """


def main(argv: list[str] | None = None) -> int:
    args = _build_parser().parse_args(argv)

    run_id = args.run or _resolve_bound_run()
    if not run_id:
        print("worker-wait: no --run given and no Run bound to this terminal", file=sys.stderr)
        return 2

    ledger_path = Path(args.ledger) if args.ledger else _default_ledger_path()
    stall_seconds = max(1, args.stall_minutes) * 60

    if args.once:
        try:
            rows, _ = _accounting_pass(run_id, ledger_path, stall_seconds, reap=args.reap)
        except WorkerListError as exc:
            print(f"worker-wait: {exc}", file=sys.stderr)
            return 2
        _print_table(rows, as_json=args.json)
        return 0

    lock_path = _acquire_lock(run_id)
    if lock_path is None:
        print(f"worker-wait: another waiter holds the lock for {run_id}", file=sys.stderr)
        return 2
    try:
        return _run_loop(run_id, ledger_path, stall_seconds, args.json, args.reap)
    finally:
        _release_lock(lock_path)


def _run_loop(
    run_id: str, ledger_path: Path, stall_seconds: int, as_json: bool, reap: bool = False
) -> int:
    """Account first (an already-settled Run should never wait), then wake on
    a real delivery or an actionable verdict rather than looping past it: the
    caller (the coordinator, watching this process's own stdout) is the one
    who acts and acks, and doing that requires control back, not another pass
    hidden behind it. A boring pass — a timeout with nothing actionable and
    dispatches still open — is the only case that re-arms on its own.
    """

    def pass_once(batch: dict | None) -> int | None:
        try:
            rows, dispatched_count = _accounting_pass(
                run_id, ledger_path, stall_seconds, reap=reap
            )
        except WorkerListError as exc:
            print(f"worker-wait: {exc}", file=sys.stderr)
            return 2
        _print_table(rows, as_json=as_json)
        if batch is not None:
            _print_batch(batch, as_json=as_json)
            _emit_wait_wake(batch)
        if dispatched_count == 0:
            return 0
        if batch is not None or any(r["verdict"] in ACTIONABLE_VERDICTS for r in rows):
            return 0
        return None

    verdict = pass_once(None)
    if verdict is not None:
        return verdict

    ack = None
    while True:
        prior_ack = ack
        batch, ack = _wait_for_message(run_id, ack)
        verdict = pass_once(batch)
        if verdict is not None:
            if batch is None and ack and ack != prior_ack:
                # This pass consumed a heartbeat and is the one returning
                # control: there is no next `_wait_for_message` call left to
                # chain its ack into, so flush it now instead of dropping it.
                # A delivery may already be queued behind that heartbeat —
                # surface it as this pass's wake, exactly as a real wake
                # from `_wait_for_message` would, rather than discarding it.
                flushed = _flush_ack(run_id, ack)
                if flushed is not None:
                    verdict = pass_once(flushed)
            return verdict


# --- messaging -----------------------------------------------------------


def _wait_for_message(run_id: str, ack: str | None) -> tuple[dict | None, str | None]:
    """One `check --wait` attempt: a timeout, an acked heartbeat, or a real batch.

    Returns `(None, ack_to_chain)` for a timeout or a heartbeat-only batch (the
    heartbeat's own delivery id becomes the next call's `--ack`, silently
    clearing it without ever surfacing it as a wake — or, if this pass is the
    one that returns control, `_run_loop` flushes it directly via
    `_flush_ack` instead, since there is no next call left to carry it) and
    `(batch, delivery_id)` for anything else. A real batch's `delivery_id` is
    returned, not the old `ack`, so a caller that chains it forward acks the
    batch it just saw rather than replaying an unrelated stale one — this
    caller does not chain it forward at all, leaving the batch unacknowledged
    for the coordinator to ack after acting, exactly as `_run_loop` does by
    returning immediately on it.

    Never loops internally on repeated heartbeats: a caller-side loop that
    calls this once per pass is what lets `_accounting_pass` run between
    heartbeats, which is the whole point of not being a heartbeat-only stall
    check.
    """

    argv = [
        "orca",
        "orchestration",
        "check",
        "--run",
        run_id,
        "--wait",
        "--timeout-ms",
        str(DEFAULT_CHECK_TIMEOUT_MS),
        "--types",
        WAIT_TYPES,
        "--json",
    ]
    if ack:
        argv += ["--ack", ack]
    subprocess_timeout_seconds = (
        DEFAULT_CHECK_TIMEOUT_MS / 1000
    ) + CHECK_WAIT_SUBPROCESS_TIMEOUT_MARGIN_SECONDS
    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=subprocess_timeout_seconds,
        )
    except subprocess.TimeoutExpired:
        # An unresponsive `orca` past its own --timeout-ms plus margin is the
        # same quiet pass as a server-side timeout: nothing was delivered, so
        # there is nothing to ack and no batch to surface.
        return None, ack
    except OSError as exc:
        print(f"worker-wait: orca check failed to run: {exc}", file=sys.stderr)
        time.sleep(1)  # avoid a hot busy-spin if orca is persistently missing
        return None, ack
    result = _last_non_keepalive(proc.stdout + proc.stderr)
    if (
        proc.returncode != 0
        or not isinstance(result, dict)
        or result.get("ok") is False
        or not isinstance(result.get("result"), dict)
    ):
        print(
            f"worker-wait: orca check failed or returned a malformed envelope (exit={proc.returncode})",
            file=sys.stderr,
        )
        time.sleep(1)  # avoid a hot busy-spin on a persistently failing check
        return None, ack
    payload = result["result"]
    if payload.get("timedOut"):
        return None, ack
    messages = payload.get("messages") or []
    delivery_id = payload.get("deliveryId")
    if messages and all(
        isinstance(m, dict) and m.get("type") == "heartbeat" for m in messages
    ):
        if not delivery_id:
            # Nothing to ack, and zeroing out an already-valid `ack` here
            # would silence `--ack` on every future call, letting orca
            # replay this same heartbeat forever instead of blocking.
            print(
                "worker-wait: heartbeat batch had no deliveryId to ack; treating as quiet",
                file=sys.stderr,
            )
            return None, ack
        return None, delivery_id
    if not messages and not delivery_id:
        return None, ack
    return payload, delivery_id


def _flush_ack(run_id: str, delivery_id: str) -> dict | None:
    """Ack `delivery_id` right now, for a pass that is about to return control
    rather than loop again: the normal chain-forward path (pass it as `--ack`
    on the *next* `check --wait` call) never happens for that pass, which is
    how a heartbeat got left unacked and replayed to this Run's next
    `worker-wait` invocation instead of being cleared by the one that saw it.

    Uses a plain (non-`--wait`) `check --ack`: it acknowledges immediately
    and, if a delivery is already queued behind the one being flushed,
    returns it right away rather than blocking for one. A queued heartbeat is
    acked the same way and the round repeats, bounded to
    `MAX_ACK_FLUSH_ROUNDS` so a run of heartbeats cannot loop here forever.
    Returns the first queued non-heartbeat batch found, or `None` if nothing
    is queued (or the check fails) — never silently discarding a real
    delivery the way ignoring the subprocess output used to.

    Each round is bounded with `timeout=`: an unresponsive `orca` must not
    block this return path forever, which would keep the per-Run lock held
    past the verdict already printed. On timeout the delivery id is reported
    so the coordinator can ack it by hand.
    """

    ack = delivery_id
    for _ in range(MAX_ACK_FLUSH_ROUNDS):
        argv = [
            "orca",
            "orchestration",
            "check",
            "--run",
            run_id,
            "--types",
            WAIT_TYPES,
            "--ack",
            ack,
            "--json",
        ]
        try:
            proc = subprocess.run(
                argv,
                capture_output=True,
                text=True,
                timeout=ACK_FLUSH_SUBPROCESS_TIMEOUT_SECONDS,
            )
        except subprocess.TimeoutExpired:
            print(
                f"worker-wait: ack flush for delivery {ack} timed out; ack it by hand",
                file=sys.stderr,
            )
            return None
        except OSError as exc:
            print(
                f"worker-wait: ack flush for delivery {ack} failed to run: {exc}",
                file=sys.stderr,
            )
            return None
        result = _last_non_keepalive(proc.stdout + proc.stderr)
        if (
            proc.returncode != 0
            or not isinstance(result, dict)
            or result.get("ok") is False
            or not isinstance(result.get("result"), dict)
        ):
            print(
                f"worker-wait: ack flush for delivery {ack} failed or returned a "
                f"malformed envelope (exit={proc.returncode})",
                file=sys.stderr,
            )
            return None
        payload = result["result"]
        messages = payload.get("messages") or []
        next_delivery_id = payload.get("deliveryId")
        if not messages:
            return None
        if all(isinstance(m, dict) and m.get("type") == "heartbeat" for m in messages):
            if not next_delivery_id:
                return None
            ack = next_delivery_id
            continue
        return payload
    return None


def _last_non_keepalive(text: str) -> dict | None:
    """Decode every JSON document in text and return the last non-keepalive one.

    `check --wait` interleaves `_keepalive` documents (one every 15s while it
    blocks) with the eventual result; they are not newline-delimited so
    `json.loads` on the whole string fails as soon as more than one document is
    present. `raw_decode` walks the string one document at a time instead.
    """

    decoder = json.JSONDecoder()
    idx, n = 0, len(text)
    last: dict | None = None
    while idx < n:
        while idx < n and text[idx] in " \t\r\n":
            idx += 1
        if idx >= n:
            break
        try:
            obj, end = decoder.raw_decode(text, idx)
        except json.JSONDecodeError:
            break
        idx = end
        if isinstance(obj, dict) and not obj.get("_keepalive"):
            last = obj
    return last


def _print_batch(batch: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps({"delivery": batch}, sort_keys=True))
        return
    for message in batch.get("messages") or []:
        print(
            f"delivery  type={message.get('type')} from={message.get('from')} "
            f"subject={message.get('subject')}"
        )


# --- accounting ------------------------------------------------------------


def _accounting_pass(
    run_id: str, ledger_path: Path, stall_seconds: int, reap: bool = False
) -> tuple[list[dict], int]:
    dispatched, handle_status, handle_task_id = _worker_list(run_id)
    ledger_index = _ledger_index(ledger_path)
    terminals = _terminal_list()
    sweep = _pane_sweep()
    now_ms = time.time() * 1000

    rows: list[dict] = []
    seen_panes: set[str] = set()
    for entry in dispatched:
        dispatch_id = entry["dispatchId"]
        recorded = ledger_index.get(dispatch_id, {})
        pane = recorded.get("pane") or entry.get("agentTerminalHandle")
        pid = recorded.get("pid")
        if pane:
            seen_panes.add(pane)
        last_output_at = terminals.get(pane) if pane else None
        age_seconds = (
            (now_ms - last_output_at) / 1000.0 if last_output_at is not None else None
        )
        pid_alive = _pid_alive(pid) if pid else None
        sweep_class = _sweep_lookup(sweep, pane) if pane else None
        verdict = _compute_verdict(pid, pid_alive, age_seconds, stall_seconds, sweep_class)
        rows.append(
            {
                "dispatch_id": dispatch_id,
                "pane": pane,
                "age_seconds": age_seconds,
                "pid": pid,
                "pid_alive": pid_alive,
                "sweep_class": sweep_class,
                "verdict": verdict,
            }
        )

    for handle in terminals:
        if handle in seen_panes:
            continue
        status = handle_status.get(handle)
        if status and status != "dispatched":
            task_id = handle_task_id.get(handle)
            row = {
                "dispatch_id": None,
                "pane": handle,
                "age_seconds": None,
                "pid": None,
                "pid_alive": None,
                "sweep_class": None,
                "verdict": "OPEN_PANE",
            }
            if reap:
                row["task_id"] = task_id
                row["reap"] = _reap_open_pane(task_id)
            rows.append(row)

    for row in rows:
        if row["verdict"] in ACTIONABLE_VERDICTS:
            # OPEN_PANE rows have no dispatch id (that's what makes them
            # open), so dispatch-timeline can only join their verdict event
            # to a task's timeline via the task id. That join key stays out
            # of the JSON row unless --reap asked for it (PR #151's
            # byte-compatible --once --json shape), so look it up from
            # handle_task_id instead of the row itself.
            mogui_emit(
                "info",
                "wait_verdict",
                "pass",
                dispatch_id=row["dispatch_id"] or "",
                task_id=row.get("task_id") or handle_task_id.get(row["pane"]) or "",
                pane=row["pane"] or "",
                verdict=row["verdict"],
            )

    return rows, len(dispatched)


def _reaper_script_path() -> Path | None:
    """`scripts/worker-reap` two levels up from this file, matching the
    sibling layout this file and that one share in the orchestrator's own
    checkout, or whatever `worker-reap` resolves to on PATH when that layout
    is not present (a template-applied repo with no such sibling)."""

    candidate = Path(__file__).resolve().parents[2] / "scripts" / "worker-reap"
    if candidate.exists():
        return candidate
    found = shutil.which("worker-reap")
    return Path(found) if found else None


def _reap_open_pane(task_id: str | None) -> dict:
    """Call `scripts/worker-reap --task-id <id> --json` for one OPEN_PANE row.

    Never raises: a missing task id, a missing reaper script, a timeout, or
    an unparseable reply are all reported as a refusal in the row rather than
    aborting the accounting pass.
    """

    if not task_id:
        return {"reaped": False, "reason": "no_task_id"}
    script = _reaper_script_path()
    if script is None:
        return {"reaped": False, "reason": "worker_reap_not_found"}
    argv = [str(script), "--task-id", task_id, "--json"]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=30)
    except (subprocess.TimeoutExpired, OSError) as exc:
        return {"reaped": False, "reason": f"reap_failed:{exc}"}
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {
            "reaped": False,
            "reason": f"reap_unparseable(exit={proc.returncode}):{proc.stderr.strip()}",
        }
    if not isinstance(payload, dict):
        return {
            "reaped": False,
            "reason": f"reap_unparseable(exit={proc.returncode}):not an object",
        }
    if proc.returncode != 0:
        return {"reaped": False, "reason": f"reap_exit_{proc.returncode}", "record": payload}
    # `worker-reap` exits 0 even for a safety refusal (a `terminal_left:*`
    # record) — reaped means an action was actually taken, not that the
    # command merely succeeded.
    record = payload.get("record", payload)
    actions = str(record.get("actions_taken", "")) if isinstance(record, dict) else ""
    return {
        "reaped": any(
            action.startswith(("terminal_closed:", "worktree_removed:"))
            for action in actions.split(";")
        ),
        "record": record,
    }


def _emit_wait_wake(batch: dict) -> None:
    """One `wait_wake` per non-heartbeat delivery — `_wait_for_message` never
    returns a heartbeat-only batch (it acks and re-arms those internally), so
    any non-`None` batch reaching here is by construction a real wake."""

    messages = batch.get("messages") or []
    types = ",".join(str(m.get("type")) for m in messages if isinstance(m, dict))
    mogui_emit(
        "info",
        "wait_wake",
        "pass",
        message_type=types,
        message_id=str(batch.get("deliveryId") or ""),
    )


def _compute_verdict(
    pid: str | None,
    pid_alive: bool | None,
    age_seconds: float | None,
    stall_seconds: int,
    sweep_class: str | None,
) -> str:
    """`pid_alive` is `None`, not `False`, when liveness could not be measured
    (bad pid data, `ps` missing or erroring) — that must read `UNKNOWN`, never
    `DEAD`: a measurement failure is not evidence of death, and `DEAD` is what
    the runbook tells the coordinator to act on. Likewise `age_seconds` is
    `None` when the pane's `lastOutputAt` could not be read, which must never
    read `STALL` on a sweep class alone — `STALL` is specifically "measured
    stale," not "sweep says something other than working."
    """

    if sweep_class == "unknown":
        sweep_class = None

    if pid is not None:
        if pid_alive is False:
            return "DEAD"
        if pid_alive is None:
            return "UNKNOWN"
        if sweep_class == "working":
            return "working"
        if age_seconds is None:
            return "UNKNOWN"
        if age_seconds < stall_seconds:
            return "working"
        if sweep_class in STALL_SWEEP_CLASSES:
            return "STALL"
        return "UNKNOWN"

    # No pid recorded: DEAD and STALL both require a measured pid, per contract.
    if sweep_class == "working":
        return "working"
    if sweep_class in STALL_SWEEP_CLASSES:
        # Not one of the contract's named verdicts: no pid to call it STALL, but
        # the sweep did classify it, so it is not UNKNOWN either. Reported
        # verbatim and does not wake the caller (see runbook).
        return sweep_class
    return "UNKNOWN"


# --- data sources ------------------------------------------------------------


def _worker_list(
    run_id: str,
) -> tuple[list[dict], dict[str, str], dict[str, str]]:
    """Dispatched entries for the Run, a handle -> latest dispatchStatus map,
    and a handle -> taskId map (every row seen, not just dispatched ones —
    an OPEN_PANE row's `--reap` call needs the task id of whichever dispatch
    last claimed that pane, which is exactly the row this handle's status
    came from)."""

    dispatched: list[dict] = []
    handle_status: dict[str, str] = {}
    handle_task_id: dict[str, str] = {}
    cursor = None
    for _ in range(MAX_WORKER_LIST_PAGES):
        argv = [
            "orca",
            "orchestration",
            "worker-list",
            "--run",
            run_id,
            "--limit",
            str(WORKER_LIST_PAGE_LIMIT),
            "--json",
        ]
        if cursor:
            argv += ["--cursor", cursor]
        payload = _orca_json(argv)
        if payload is None:
            raise WorkerListError(
                "orca orchestration worker-list failed or returned malformed JSON"
            )
        result = payload.get("result", {})
        workers = result.get("workers") or []
        for worker in workers:
            handle = worker.get("agentTerminalHandle")
            status = worker.get("dispatchStatus")
            if handle and handle not in handle_status:
                handle_status[handle] = status
            if handle:
                task_id = worker.get("taskId") or worker.get("task_id")
                handle_task_id[handle] = str(task_id) if task_id else ""
            if status == "dispatched":
                dispatched.append(worker)
        page = result.get("page") or {}
        cursor = page.get("nextCursor")
        if not page.get("hasMore") or not cursor:
            break
    return dispatched, handle_status, handle_task_id


def _terminal_list() -> dict[str, float | None]:
    payload = _orca_json(["orca", "terminal", "list", "--json"])
    result = payload.get("result", {}) if payload else {}
    terminals = result.get("terminals") or []
    return {t["handle"]: t.get("lastOutputAt") for t in terminals if t.get("handle")}


def _pane_sweep() -> dict[str, str]:
    sweep_path = Path(__file__).resolve().parent / "worker-pane-sweep"
    try:
        proc = subprocess.run([str(sweep_path)], capture_output=True, text=True)
    except OSError:
        return {}
    verdicts: dict[str, str] = {}
    for line in proc.stdout.splitlines():
        if not line or line.startswith("sweep:"):
            continue
        parts = line.split(None, 3)
        if len(parts) < 3:
            continue
        _mark, verdict, handle_prefix = parts[0], parts[1], parts[2]
        if verdict == "coordinator":
            continue
        verdicts[handle_prefix] = verdict
    return verdicts


def _sweep_lookup(sweep: dict[str, str], pane: str) -> str | None:
    for prefix, verdict in sweep.items():
        if pane.startswith(prefix):
            return verdict
    return None


def _ledger_index(ledger_path: Path) -> dict[str, dict]:
    index: dict[str, dict] = {}
    try:
        lines = ledger_path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return index
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(entry, dict):
            continue
        job_id = entry.get("job_id")
        if not job_id or ("worker_pid" not in entry and "pane" not in entry):
            continue
        record = index.setdefault(job_id, {})
        if "worker_pid" in entry:
            record["pid"] = entry["worker_pid"]
        if "pane" in entry:
            record["pane"] = entry["pane"]
    return index


def _pid_alive(pid: object) -> bool | None:
    """`None` when liveness could not be measured at all — a bad pid string or
    a missing/erroring `ps` — as distinct from `False`, which means `ps`
    positively answered "no such process." Only `False` is a measurement;
    a caller that treats `None` as `False` manufactures a `DEAD` verdict (or
    a stolen lock) from the absence of information rather than from evidence.
    """

    try:
        pid_int = int(str(pid).strip())
    except (TypeError, ValueError):
        return None
    try:
        proc = subprocess.run(["ps", "-p", str(pid_int)], capture_output=True)
    except OSError:
        return None
    return proc.returncode == 0


def _orca_json(argv: list[str]) -> dict | None:
    """`None` on any failure: a nonzero exit, unparseable stdout, or a
    well-formed envelope whose own `"ok"` field says the call did not
    succeed. Every real orca JSON response carries `"ok": true` on success;
    accepting a parseable-but-failed envelope here is how a `worker-list`
    error response was silently read as zero workers rather than a failure.
    """

    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
    except OSError:
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    if proc.returncode != 0 or not isinstance(payload, dict) or payload.get("ok") is not True:
        return None
    return payload


def _resolve_bound_run() -> str | None:
    payload = _orca_json(["orca", "orchestration", "run-current", "--json"])
    result = payload.get("result", {}) if payload else {}
    run = result.get("run")
    return run.get("id") if isinstance(run, dict) else None


def _default_ledger_path() -> Path:
    return Path.home() / ".mogui" / "dispatch-ledger.jsonl"


# --- lock --------------------------------------------------------------------


def _lock_dir() -> Path:
    return Path.home() / ".mogui" / "worker-wait"


def _acquire_lock(run_id: str) -> Path | None:
    """`O_CREAT|O_EXCL` makes the create atomic: an `exists()`-then-`write_text()`
    check has a window where two waiters both see no live owner and both then
    write their pid, which is the exact corruption this lock exists to
    prevent. A stale lock is removed and the create retried exactly once; a
    second waiter racing that same retry loses it and correctly refuses
    rather than also winning.
    """

    lock_dir = _lock_dir()
    lock_dir.mkdir(parents=True, exist_ok=True)
    lock_path = lock_dir / f"{run_id}.lock"
    pid_bytes = str(os.getpid()).encode("utf-8")

    for attempt in range(2):
        try:
            fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except FileExistsError:
            if attempt == 1:
                return None
            try:
                existing = lock_path.read_text(encoding="utf-8").strip()
            except OSError:
                existing = ""
            # Only a *confirmed* dead pid is stale. An unreadable/empty lock
            # or a liveness check that could not be measured is left alone —
            # taking it over on a guess is the same corruption in a hat.
            if not existing or _pid_alive(existing) is not False:
                return None
            try:
                lock_path.unlink()
            except OSError:
                pass
            continue
        else:
            with os.fdopen(fd, "wb") as handle:
                handle.write(pid_bytes)
            return lock_path
    return None


def _release_lock(lock_path: Path) -> None:
    try:
        if lock_path.read_text(encoding="utf-8").strip() == str(os.getpid()):
            lock_path.unlink()
    except OSError:
        pass


# --- output ------------------------------------------------------------------


def _print_table(rows: list[dict], as_json: bool) -> None:
    if as_json:
        print(json.dumps(rows, sort_keys=True))
        return
    if not rows:
        print("worker-wait: no dispatched or open-pane rows")
        return
    header = f"{'VERDICT':<10} {'PANE':<40} {'AGE_S':>8} {'PID':>8} {'ALIVE':<6} {'SWEEP':<12} DISPATCH"
    print(header)
    for row in rows:
        age = "-" if row["age_seconds"] is None else f"{row['age_seconds']:.0f}"
        pid = "-" if row["pid"] is None else str(row["pid"])
        alive = "-" if row["pid_alive"] is None else str(row["pid_alive"])
        sweep = row["sweep_class"] or "-"
        pane = row["pane"] or "-"
        dispatch_id = row["dispatch_id"] or "-"
        print(
            f"{row['verdict']:<10} {pane:<40} {age:>8} {pid:>8} {alive:<6} "
            f"{sweep:<12} {dispatch_id}"
        )


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="worker-wait")
    parser.add_argument("--run", help="Run id; default: the Run bound to this terminal")
    parser.add_argument(
        "--stall-minutes",
        type=int,
        default=DEFAULT_STALL_MINUTES,
        help=f"minutes of stale output before STALL is eligible (default {DEFAULT_STALL_MINUTES})",
    )
    parser.add_argument("--once", action="store_true", help="one accounting pass, no wait")
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument("--ledger", help="dispatch ledger path (default ~/.mogui/dispatch-ledger.jsonl)")
    parser.add_argument(
        "--reap",
        action="store_true",
        help="call scripts/worker-reap for each OPEN_PANE row (default: off, row only)",
    )
    return parser


if __name__ == "__main__":
    raise SystemExit(main())
