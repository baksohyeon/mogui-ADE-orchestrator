#!/usr/bin/env python3
"""Command line entry point for the worker dispatch gate."""

from __future__ import annotations

import argparse
import json
import math
import os
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime, timezone
from enum import Enum
from pathlib import Path


SCRIPT_PATH = Path(__file__).resolve()
REPO_ROOT = SCRIPT_PATH.parent.parent
SRC_ROOT = REPO_ROOT / "src"
sys.path.insert(0, str(SRC_ROOT))

from master_runtime.core.dispatch_gate import (  # noqa: E402
    DispatchGate,
    DispatchGateConfig,
    DispatchRequest,
    GateDecision,
    ReasonCode,
)
from master_runtime.core.watchdog import StallStatus, check_stall  # noqa: E402


ORCHESTRATION_PROBE_TIMEOUT_SECONDS = 30
MODEL_PROBE_TIMEOUT_SECONDS = 30


class ProbeFailure(str, Enum):
    """Stable ledger values for failed orchestration verification probes."""

    ORCA_MISSING = "orca_missing"
    PROBE_TIMEOUT = "probe_timeout"
    PROBE_UNPARSEABLE = "probe_unparseable"
    TASK_OMITTED = "task_omitted"
    TASK_NOT_FOUND = "task_not_found"


def main(argv: list[str] | None = None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)

    if args.command == "check":
        return _check(args)
    if args.command == "register":
        return _register(args)
    if args.command == "watch":
        return _watch(args)
    if args.command == "report":
        return _report(args)

    parser.print_help(sys.stderr)
    return 2


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dispatch-gate")
    parser.add_argument("--ledger", help="JSONL ledger path")
    subparsers = parser.add_subparsers(dest="command", required=True)

    check_parser = subparsers.add_parser("check")
    check_parser.add_argument("--runtime", required=True)
    check_parser.add_argument("--model")
    check_parser.add_argument("--tier-policy")
    check_parser.add_argument("--tier-override")
    check_parser.add_argument("--contract", required=True)
    check_parser.add_argument("--agents", required=True, type=int)
    check_parser.add_argument("--est-chars", type=int)
    check_parser.add_argument(
        "--completion-channel",
        choices=("orchestration", "sentinel-log"),
    )

    register_parser = subparsers.add_parser("register")
    register_parser.add_argument("--job-id", required=True)
    register_parser.add_argument("--probe-cmd", required=True)
    register_parser.add_argument("--contract-sha")
    register_parser.add_argument("--runtime")
    register_parser.add_argument("--orchestration-task")
    # register ranks the measured tier against the declared one, so it needs the
    # same policy check used, and by the same resolution rules.
    register_parser.add_argument("--tier-policy")
    register_parser.add_argument("--declared-model")
    register_parser.add_argument("--model-probe-cmd")

    watch_parser = subparsers.add_parser("watch")
    watch_parser.add_argument("--log", required=True)
    watch_parser.add_argument("--max-idle", type=int, default=360)

    report_parser = subparsers.add_parser("report")
    report_parser.add_argument("--today", action="store_true")

    return parser


def _gate(args: argparse.Namespace) -> DispatchGate:
    config_values: dict[str, object] = {}
    if args.ledger:
        config_values["ledger_path"] = args.ledger
    tier_policy = getattr(args, "tier_policy", None)
    if tier_policy:
        config_values["tier_policy_path"] = tier_policy
    if config_values:
        return DispatchGate(DispatchGateConfig(**config_values))
    return DispatchGate()


def _check(args: argparse.Namespace) -> int:
    contract_path = Path(args.contract)
    est_chars = args.est_chars
    if est_chars is None:
        if args.completion_channel is None:
            est_chars = 0
        else:
            try:
                est_chars = len(
                    contract_path.read_text(encoding="utf-8", errors="replace")
                )
            except OSError:
                est_chars = None

    decision = _gate(args).check(
        DispatchRequest(
            runtime=args.runtime,
            model=args.model,
            contract_path=contract_path,
            est_input_chars=est_chars,
            n_agents=args.agents,
            completion_channel=args.completion_channel,
            tier_override=args.tier_override,
        )
    )
    _print_decision(decision)
    if decision.allow:
        return 0
    _diagnose(decision.reason.value)
    return 2


def _register(args: argparse.Namespace) -> int:
    if not args.orchestration_task:
        return _deny_unverified_orchestration(args, ProbeFailure.TASK_OMITTED)
    probe_failure = _probe_orchestration_task(args.orchestration_task)
    if probe_failure is not None:
        return _deny_unverified_orchestration(args, probe_failure)

    measured_model, model_probe_failed = _measure_worker_model(args.model_probe_cmd)
    decision = _gate(args).register_job(
        args.job_id,
        lambda job_id: _probe_contains_job_id(args.probe_cmd, job_id),
        contract_sha=args.contract_sha,
        runtime=args.runtime,
        orchestration_task=args.orchestration_task,
        declared_model=args.declared_model,
        measured_model=measured_model,
        model_probe_failed=model_probe_failed,
    )
    _print_decision(decision)
    if decision.allow:
        return 0
    _diagnose(_decision_error(decision))
    return 2


def _watch(args: argparse.Namespace) -> int:
    decision = check_stall(args.log, max_idle_seconds=args.max_idle)
    payload = {
        "status": decision.status.value,
        "idle_seconds": decision.idle_seconds,
        "last_progress_at": decision.last_progress_at,
        "reason": decision.reason,
    }
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    if decision.status == StallStatus.STALLED:
        _diagnose(str(decision.reason))
        return 3
    if decision.status == StallStatus.MISSING:
        _diagnose(str(decision.reason))
        return 2
    return 0


def _report(args: argparse.Namespace) -> int:
    try:
        entries = _gate(args).ledger_entries()
    except (OSError, json.JSONDecodeError) as exc:
        _diagnose(f"REPORT_UNAVAILABLE: {exc}")
        return 2

    malformed_count = sum(not isinstance(entry, dict) for entry in entries)
    entries = tuple(entry for entry in entries if isinstance(entry, dict))

    if args.today:
        today = datetime.now(timezone.utc).date()
        entries = tuple(
            entry
            for entry in entries
            if (entry_date := _entry_date(entry)) is not None and entry_date == today
        )

    model_stats: dict[str, list[int]] = {}
    denial_counts: Counter[str] = Counter()
    override_counts: Counter[tuple[str, str]] = Counter()
    policy_counts: Counter[tuple[str, str]] = Counter()
    tier_stats: dict[str, list[int]] = {}
    timestamps: list[float] = []
    for entry in entries:
        policy_path = entry.get("tier_policy_path")
        policy_digest = entry.get("tier_policy_sha256")
        if isinstance(policy_path, str) and policy_path:
            policy_counts[
                (
                    policy_path,
                    policy_digest if isinstance(policy_digest, str) else "",
                )
            ] += 1
        timestamp = _timestamp(entry.get("ts"))
        if timestamp is not None:
            timestamps.append(timestamp)

        decision = entry.get("decision")
        reason = entry.get("reason")
        if decision == "DENY" and isinstance(reason, str):
            denial_counts[reason] += 1

        model = entry.get("model")
        if decision != "ALLOW" or not isinstance(model, str) or not model:
            continue
        # Tier rollup, so an allowed unknown-tier dispatch is visible rather than
        # merely recorded. A row here is the only place a reader sees that the
        # policy let a model through without knowing its tier.
        tier = entry.get("tier")
        if isinstance(tier, str) and tier:
            stats = tier_stats.setdefault(tier, [0, 0])
            stats[0] += 1
            agents = entry.get("n_agents")
            if not isinstance(agents, bool) and isinstance(agents, int) and agents > 0:
                stats[1] += agents
        stats = model_stats.setdefault(model, [0, 0, 0])
        stats[0] += 1
        cost_proxy, computed = _entry_cost_proxy(entry)
        stats[1] += cost_proxy
        stats[2] += int(computed)
        tier_override = entry.get("tier_override")
        if isinstance(tier_override, str) and tier_override:
            override_counts[(model, tier_override)] += 1

    print("Dispatch gate report")
    print(f"Scope: {'today (UTC)' if args.today else 'all ledger entries'}")
    print(f"Skipped malformed: {malformed_count}")
    if timestamps:
        print(
            "Time span: "
            f"{_format_timestamp(min(timestamps))} to {_format_timestamp(max(timestamps))}"
        )
    else:
        print("Time span: none")

    print("Models:")
    if model_stats:
        for model in sorted(model_stats):
            count, cost_proxy, computed_count = model_stats[model]
            computed_label = (
                f" computed_legacy_entries={computed_count}"
                if computed_count
                else ""
            )
            print(
                f"  {model}: dispatches={count} est_cost_proxy={cost_proxy}"
                f"{computed_label}"
            )
    else:
        print("  <none>")

    print("Denials:")
    if denial_counts:
        for reason in sorted(denial_counts):
            print(f"  {reason}: {denial_counts[reason]}")
    else:
        print("  <none>")

    print("Tiers:")
    if tier_stats:
        for tier in sorted(tier_stats):
            dispatches, agents = tier_stats[tier]
            suffix = "  <- allowed without a known tier" if tier == "unknown" else ""
            print(f"  {tier}: dispatches={dispatches} agents={agents}{suffix}")
    else:
        print("  <none>")

    # More than one row here means the day was not judged against one policy.
    print("Tier policies:")
    if policy_counts:
        for policy_path, policy_digest in sorted(policy_counts):
            digest_label = policy_digest[:12] if policy_digest else "<unrecorded>"
            print(
                f"  {policy_path}: sha256={digest_label} "
                f"decisions={policy_counts[(policy_path, policy_digest)]}"
            )
    else:
        print("  <none>")

    print("Tier overrides:")
    if override_counts:
        for model, reason in sorted(override_counts):
            print(
                f"  {model}: reason={json.dumps(reason, ensure_ascii=False)} "
                f"count={override_counts[(model, reason)]}"
            )
    else:
        print("  <none>")
    return 0


def _entry_date(entry: object):
    if not isinstance(entry, dict):
        return None
    timestamp = _timestamp(entry.get("ts"))
    if timestamp is None:
        return None
    try:
        return datetime.fromtimestamp(timestamp, timezone.utc).date()
    except (OverflowError, OSError, ValueError):
        return None


def _entry_cost_proxy(entry: object) -> tuple[int, bool]:
    if not isinstance(entry, dict):
        return 0, False
    if "cost_proxy" in entry:
        cost_proxy = entry.get("cost_proxy")
        if isinstance(cost_proxy, bool) or not isinstance(cost_proxy, int):
            return 0, False
        return max(0, cost_proxy), False
    est_chars = entry.get("est_chars")
    n_agents = entry.get("n_agents")
    if (
        isinstance(est_chars, bool)
        or not isinstance(est_chars, int)
        or isinstance(n_agents, bool)
        or not isinstance(n_agents, int)
    ):
        return 0, True
    return max(0, est_chars) * max(0, n_agents), True


def _number(value: object) -> float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    try:
        return float(value)
    except OverflowError:
        return None


def _timestamp(value: object) -> float | None:
    timestamp = _number(value)
    if timestamp is None or not math.isfinite(timestamp):
        return None
    try:
        datetime.fromtimestamp(timestamp, timezone.utc)
    except (OverflowError, OSError, ValueError):
        return None
    return timestamp


def _format_timestamp(timestamp: float) -> str:
    return datetime.fromtimestamp(timestamp, timezone.utc).isoformat().replace(
        "+00:00", "Z"
    )


def _probe_contains_job_id(probe_cmd: str, job_id: str) -> bool:
    result = subprocess.run(
        probe_cmd,
        shell=True,
        check=False,
        capture_output=True,
        text=True,
    )
    return result.returncode == 0 and job_id in result.stdout


def _measure_worker_model(probe_cmd: str | None) -> tuple[str | None, bool]:
    """Run a caller-declared command that prints the worker's actual model id.

    The command is declared per dispatch rather than guessed, because every
    runtime reports its model differently and this gate is agent-neutral. It must
    read an artifact the agent itself produced, such as a session transcript;
    scraping a TUI status line measures what a renderer drew, which is not the
    same fact and cannot be trusted to authenticate anything.

    Returns the measured id and whether the measurement itself failed, which are
    different states: no declaration at all, and a declaration that did not
    produce an answer.
    """

    if not probe_cmd:
        return None, False
    try:
        result = subprocess.run(
            probe_cmd,
            shell=True,
            check=False,
            capture_output=True,
            text=True,
            timeout=MODEL_PROBE_TIMEOUT_SECONDS,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None, True
    if result.returncode != 0:
        return None, True
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if not lines:
        return None, True
    return lines[-1], False


def _probe_orchestration_task(orchestration_task: str) -> ProbeFailure | None:
    try:
        result = subprocess.run(
            [
                _resolved_orca_command(),
                "orchestration",
                "dispatch-show",
                "--task",
                orchestration_task,
                "--json",
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=ORCHESTRATION_PROBE_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        return ProbeFailure.PROBE_TIMEOUT
    except OSError:
        return ProbeFailure.ORCA_MISSING
    if result.returncode != 0:
        return ProbeFailure.TASK_NOT_FOUND
    try:
        payload = json.loads(result.stdout)
    except (TypeError, json.JSONDecodeError):
        return ProbeFailure.PROBE_UNPARSEABLE
    if not isinstance(payload, dict):
        return ProbeFailure.PROBE_UNPARSEABLE
    if payload.get("ok") is not True:
        return ProbeFailure.TASK_NOT_FOUND
    payload_result = payload.get("result")
    if not isinstance(payload_result, dict):
        return ProbeFailure.PROBE_UNPARSEABLE
    if not isinstance(payload_result.get("dispatch"), dict):
        return ProbeFailure.TASK_NOT_FOUND
    return None


def _deny_unverified_orchestration(
    args: argparse.Namespace,
    probe_failure: ProbeFailure,
) -> int:
    decision = GateDecision(False, ReasonCode.ORCHESTRATION_UNVERIFIED)
    entry: dict[str, object] = {
        "ts": time.time(),
        "decision": "DENY",
        "reason": decision.reason.value,
        "job_id": args.job_id,
        "probe_failure": probe_failure.value,
    }
    if args.orchestration_task:
        entry["orchestration_task"] = args.orchestration_task
    ledger_path = Path(_gate(args).config.ledger_path)
    ledger_path.parent.mkdir(parents=True, exist_ok=True)
    with ledger_path.open("a", encoding="utf-8") as ledger:
        ledger.write(json.dumps(entry, sort_keys=True, separators=(",", ":")))
        ledger.write("\n")
    _print_decision(decision)
    _diagnose(_decision_error(decision))
    return 2


def _resolved_orca_command() -> str:
    """Resolve the Orca executable using the onboarding environment contract."""

    explicit = os.environ.get("ORCA_CLI_COMMAND")
    if explicit:
        return explicit
    if os.environ.get("ORCA_DEV_REPO_ROOT"):
        return "orca-dev"
    return "orca"


def _print_decision(decision: GateDecision) -> None:
    payload = {
        "allow": decision.allow,
        "reason": decision.reason.value,
        "warnings": [warning.value for warning in decision.warnings],
        "contract_sha": decision.contract_sha,
        "cost_proxy": decision.cost_proxy,
    }
    if decision.message:
        payload["message"] = decision.message
    if decision.tier_override is not None:
        payload["tier_override"] = decision.tier_override
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))


def _diagnose(message: str) -> None:
    """Write a human diagnostic to stderr, prefixed so a merged stream is obvious.

    The machine-readable answer is the JSON document on stdout and nothing else.
    A caller that merges the streams with `2>&1` and parses the result as one
    document gets a parse error, and an unprefixed reason code left that looking
    like malformed JSON rather than like a second stream. Keep the streams apart:
    `2>/dev/null` for machine use, or read stderr separately for the reason.
    """

    print(f"dispatch-gate: {message}", file=sys.stderr)


def _decision_error(decision: GateDecision) -> str:
    if decision.message:
        return decision.reason.value + ": " + decision.message
    return decision.reason.value


if __name__ == "__main__":
    raise SystemExit(main())
